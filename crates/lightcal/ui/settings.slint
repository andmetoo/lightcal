// Settings (Calendar, Accounts, App) and About, 448 × 360. AppWindow forwards its data and callbacks.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BrandMark, Button, Menu, MenuOption, SegmentedControl, Select, SettingsRow, Switch, TextField } from "controls.slint";
import { CalendarSourceItem, WeekdayChipItem } from "types.slint";

export component AccountBlock inherits VerticalLayout {
    in property <string> title;
    in property <string> status;
    in property <string> badge;
    in property <bool> badge-alert: false;
    in property <[CalendarSourceItem]> sources;
    in property <string> empty-text;
    in property <string> remove-label;
    in property <string> primary-label;
    in property <bool> show-primary: false;
    in property <string> secondary-label;
    in property <bool> show-secondary: false;
    in property <string> refresh-label;
    in property <bool> show-refresh: false;
    in property <bool> controls-enabled: true;
    callback primary-clicked();
    callback secondary-clicked();
    callback refresh-clicked();
    callback toggle-source(string);
    callback remove-source(string);

    spacing: 4px;

    HorizontalLayout {
        height: 36px;
        spacing: 8px;
        alignment: space-between;
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            if root.status != "" : Text {
                text: root.status;
                font-size: 10.5px;
                font-weight: 400;
                color: root.badge-alert
                    ? Theme.err
                    : Theme.ink2;
                overflow: elide;
            }
        }
        if root.badge != "" : Rectangle {
            height: 22px;
            border-radius: 6px;
            background: root.badge-alert ? Theme.warn-bg : Theme.chip;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                Text {
                    text: root.badge;
                    font-size: 10.5px;
                    font-weight: 500;
                    color: root.badge-alert ? Theme.warn : Theme.ink;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle { height: 1px; background: Theme.line; }

    if root.sources.length == 0 && root.empty-text != "" : Text {
        text: root.empty-text;
        font-size: 12px;
        font-weight: 500;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if root.sources.length > 0 : VerticalLayout {
        spacing: 2px;
        for src in root.sources : HorizontalLayout {
            height: 22px;
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                y: (parent.height - self.height) / 2;
                background: src.checked ? src.swatch : Theme.control;
                border-width: src.checked ? 0px : 1px;
                border-color: Theme.control-line;
                if src.checked : Text {
                    width: parent.width;
                    height: parent.height;
                    text: "✓";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.on-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    enabled: root.controls-enabled;
                    clicked => { root.toggle-source(src.id); }
                }
            }
            Text {
                text: src.name;
                font-size: 12px;
                font-weight: 400;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if src.removable : TouchArea {
                width: 48px;
                height: 18px;
                clicked => { root.remove-source(src.id); }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.remove-label;
                    font-size: 10px;
                    color: Theme.ink2;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.show-refresh || root.show-primary || root.show-secondary : HorizontalLayout {
        height: 28px;
        spacing: 8px;
        alignment: end;
        if root.show-refresh : Button {
            label: root.refresh-label;
            kind: "subtle";
            clicked => { root.refresh-clicked(); }
        }
        if root.show-primary : Button {
            label: root.primary-label;
            kind: "primary";
            clicked => { root.primary-clicked(); }
        }
        if root.show-secondary : Button {
            label: root.secondary-label;
            clicked => { root.secondary-clicked(); }
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <string> app-name-text;
    in property <int> settings-tab;
    in property <string> nav-about-text;
    in property <string> settings-title-text;
    in property <string> nav-appearance-text;
    in property <string> nav-calendars-text;
    in property <string> nav-general-text;
    in property <string> startup-warning;
    in property <string> dismiss-label-text;
    in property <string> label-theme-text;
    in property <string> theme-system-label;
    in property <string> theme-light-label;
    in property <string> theme-dark-label;
    in property <string> label-first-weekday-text;
    in property <string> current-first-weekday-display;
    in property <bool> first-day-dropdown-open;
    in property <string> label-gray-weekdays-text;
    in property <[WeekdayChipItem]> gray-weekday-chips;
    in property <string> label-show-week-numbers-text;
    in property <bool> show-week-numbers;
    in property <string> label-show-event-dots-text;
    in property <bool> show-event-dots;
    in property <string> weekday-monday-label;
    in property <bool> first-weekday-monday;
    in property <string> weekday-sunday-label;
    in property <string> provider-heading-text;
    in property <string> add-calendar-account-label;
    in property <bool> add-account-enabled;
    in property <bool> account-connected;
    in property <bool> account-needs-signin;
    in property <[CalendarSourceItem]> outlook-sources;
    in property <bool> can-disconnect-microsoft;
    in property <bool> google-connected;
    in property <bool> google-needs-signin;
    in property <[CalendarSourceItem]> google-sources;
    in property <string> google-status-text;
    in property <[CalendarSourceItem]> ics-sources;
    in property <[CalendarSourceItem]> windows-sources;
    in property <bool> connection-busy;
    in property <string> sign-in-title;
    in property <string> waiting-browser-text;
    in property <string> cancel-sign-in-label;
    in property <bool> sign-in-cancelled;
    in property <string> sign-in-cancelled-text;
    in property <string> try-again-label;
    in property <string> connection-message;
    in property <string> outlook-section-text;
    in property <string> events-stale-text;
    in property <string> account-status-text;
    in property <string> reconnect-label;
    in property <string> provider-readonly-tag-text;
    in property <string> no-calendars-text;
    in property <string> remove-source-label;
    in property <string> disconnect-microsoft-label;
    in property <string> refresh-button-text;
    in property <bool> can-refresh-calendars;
    in property <bool> provider-loading;
    in property <string> google-account-label;
    in property <string> disconnect-google-label;
    in property <string> ics-section-text;
    in property <string> ics-status-text;
    in property <string> legacy-windows-label;
    in property <bool> calendars-access-denied;
    in property <string> calendars-denied-title-text;
    in property <string> calendars-denied-desc-text;
    in property <string> open-privacy-settings-label;
    in property <string> retry-sync-label;
    in property <bool> legacy-windows-enabled;
    in property <string> calendars-empty-title-text;
    in property <string> calendars-empty-desc-text;
    in property <string> label-language-text;
    in property <string> current-language-display;
    in property <bool> language-dropdown-open;
    in property <string> startup-status-text;
    in property <string> label-startup-text;
    in property <bool> start-with-windows;
    in property <string> label-shortcut-text;
    in property <bool> shortcut-has-conflict;
    in property <string> shortcut-conflict-line;
    in property <string> global-shortcut-display;
    in property <string> shortcut-unset-text;
    in property <string> shortcut-record-label;
    in property <string> shortcut-change-label;
    in property <bool> shortcut-can-clear;
    in property <string> shortcut-clear-label;
    in property <string> label-tray-palette-text;
    in property <bool> tray-icon-monochrome;
    in property <image> colored-icon-preview;
    in property <string> palette-colored-text;
    in property <image> monochrome-icon-preview;
    in property <string> palette-monochrome-text;
    in property <string> updates-heading-text;
    in property <string> lang-en-us-label;
    in property <string> current-language-code;
    in property <string> lang-ru-label;
    in property <string> lang-es-label;
    in property <string> lang-ja-label;
    in property <string> about-version-text;
    in property <bool> update-is-available;
    in property <bool> update-is-checking;
    in property <string> checking-updates-label;
    in property <string> update-ready-title-text;
    in property <string> update-status-text;
    in property <string> install-status-text;
    in property <string> update-ready-notes-text;
    in property <bool> install-busy;
    in property <string> install-update-label;
    in property <bool> package-managed-updates;
    in property <string> updates-check-button-text;
    in property <string> label-auto-updates-text;
    in property <bool> auto-check-updates;
    in property <string> auto-install-label;
    in property <bool> auto-install-updates;
    in property <string> release-notes-button-text;
    in property <string> github-button-text;
    in property <string> koona-button-text;
    in property <string> license-short-text;
    in property <bool> add-account-open;
    in property <string> add-account-title;
    in property <string> add-account-intro;
    in property <string> google-account-desc;
    in property <string> outlook-account-desc;
    in property <string> ics-account-label;
    in property <string> ics-account-desc;
    in property <bool> ics-dialog-open;
    in property <string> ics-dialog-title;
    in property <string> ics-privacy-text;
    in-out property <string> ics-source-name;
    in property <string> ics-name-placeholder;
    in-out property <string> ics-source-url;
    in property <string> ics-url-placeholder;
    in property <string> ics-loading-text;
    in property <string> ics-stays-local-text;
    in property <string> subscribe-label;
    in property <string> about-link-text;
    in property <string> app-version-line-text;
    in property <string> back-to-calendar-text;
    in property <string> current-theme-code;
    callback close-settings();
    callback open-settings(int);
    callback dismiss-startup-warning();
    callback select-theme(string);
    callback toggle-first-day-dropdown();
    callback toggle-gray-weekday(int);
    callback toggle-show-week-numbers();
    callback toggle-show-event-dots();
    callback select-first-weekday-option(bool);
    callback add-calendar-account();
    callback cancel-account-sign-in();
    callback retry-sign-in();
    callback connect-microsoft();
    callback disconnect-microsoft();
    callback refresh-calendars();
    callback toggle-calendar-source(string);
    callback remove-calendar-source(string);
    callback choose-google-account();
    callback disconnect-google();
    callback open-privacy-settings();
    callback retry-calendar-sync();
    callback toggle-legacy-windows();
    callback toggle-language-dropdown();
    callback toggle-start-with-windows();
    callback cycle-shortcut-preset();
    callback clear-shortcut();
    callback toggle-tray-icon-monochrome();
    callback select-language(string);
    callback install-update();
    callback check-updates();
    callback toggle-auto-check-updates();
    callback toggle-auto-install-updates();
    callback open-external-url(string);
    callback close-account-dialogs();
    callback choose-outlook-account();
    callback choose-ics-account();
    callback add-ics-source(string, string);

    property <int> theme-index: root.current-theme-code == "light" ? 1
        : (root.current-theme-code == "dark" ? 2 : 0);

    width: 448px;
    height: 360px;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.card-line;
    background: Theme.page;
    clip: true;

    // Title bar
    BrandMark {
        x: 16px;
        y: 10px;
        mark-size: 20px;
    }
    Text {
        x: 44px;
        y: 4px;
        width: 84px;
        height: 28px;
            text: root.app-name-text;
            font-size: 13px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
    Text {
        x: 130px;
        y: 6px;
        width: 210px;
        height: 24px;
        text: root.settings-tab == 3 ? root.nav-about-text : root.settings-title-text;
        font-size: 11px;
        font-weight: 400;
        color: Theme.ink2;
        vertical-alignment: center;
    }

    Rectangle {
        x: 412px;
        y: 10px;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-control;
        background: close-btn.has-hover ? Theme.close-hover : transparent;
        Text {
            width: parent.width;
            height: parent.height;
            text: "×";
            font-size: 14px;
            color: close-btn.has-hover ? Theme.on-close-hover : Theme.ink2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-btn := TouchArea {
            clicked => { root.close-settings(); }
        }
    }

    // Tabs (not on About)
    if root.settings-tab != 3 : Rectangle {
        for tab-info[tab-idx] in [
            { label: root.nav-appearance-text },
            { label: root.nav-calendars-text },
            { label: root.nav-general-text }
        ] : tab-pill := Rectangle {
            x: 12px + tab-idx * 144px;
            y: 42px;
            width: 136px;
            height: 32px;
            border-radius: Theme.radius-control;
            background: root.settings-tab == tab-idx
                ? Theme.selected
                : (tab-touch.has-hover ? Theme.hover : transparent);

            property <color> icon-color: root.settings-tab == tab-idx
                ? Theme.ink
                : Theme.ink2;

            if root.settings-tab == tab-idx : Rectangle {
                x: 56px;
                y: 29px;
                width: 24px;
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;
                alignment: center;

                // Calendar / person / gear marks (vector, no emoji faces).
                if tab-idx == 0 : Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    border-width: 1.4px;
                    border-color: tab-pill.icon-color;
                    background: transparent;
                    Rectangle {
                        x: 0px; y: 3.5px; width: parent.width; height: 1.2px;
                        background: tab-pill.icon-color;
                    }
                    Rectangle { x: 3.5px; y: 6.5px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                    Rectangle { x: 8px; y: 6.5px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                    Rectangle { x: 3.5px; y: 10px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                }
                if tab-idx == 1 : Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    background: transparent;
                    Rectangle {
                        x: 4px; y: 1px; width: 6px; height: 6px; border-radius: 3px;
                        background: tab-pill.icon-color;
                    }
                    Rectangle {
                        x: 2px; y: 8px; width: 10px; height: 5.5px; border-radius: 5px;
                        background: tab-pill.icon-color;
                    }
                }
                if tab-idx == 2 : Text {
                    text: "⚙";
                    font-size: 13px;
                    color: tab-pill.icon-color;
                    vertical-alignment: center;
                }
                Text {
                    text: tab-info.label;
                    font-size: 12px;
                    font-weight: root.settings-tab == tab-idx ? 600 : 400;
                    color: root.settings-tab == tab-idx
                        ? Theme.ink
                        : Theme.ink2;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            tab-touch := TouchArea {
                clicked => { root.open-settings(tab-idx); }
            }
        }

        Rectangle {
            x: 16px;
            y: 83px;
            width: 416px;
            height: 1px;
            background: Theme.line;
        }
    }

    // Preferences recovery warning, shown on the General tab until dismissed.
    // The text is wrapped (up to 4 lines) and the App card is pushed down by its height.
    warn-box := Rectangle {
        visible: root.settings-tab == 2 && root.startup-warning != "";
        x: 16px;
        y: 90px;
        width: 416px;
        // Reserved above the App settings card; 0 when there is no warning.
        height: (root.settings-tab == 2 && root.startup-warning != "")
            ? min(56px, warning-text.preferred-height) + 2px
            : 0px;
        clip: true;

        warning-text := Text {
            x: 0px;
            y: 0px;
            width: parent.width - 28px;
            text: root.startup-warning;
            font-size: 11px;
            wrap: word-wrap;
            vertical-alignment: top;
            color: Theme.err;
        }

        Rectangle {
            x: parent.width - 24px;
            y: 0px;
            width: 24px;
            height: 24px;
            Text {
                text: "×";
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.err;
            }
            TouchArea {
                accessible-role: button;
                accessible-label: root.dismiss-label-text;
                clicked => { root.dismiss-startup-warning(); }
            }
        }
    }

    // ===== TAB 0: Calendar =====
    if root.settings-tab == 0 : Rectangle {
        x: 16px;
        y: 96px;
        width: 416px;
        height: 200px;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-line;
        background: Theme.card;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            SettingsRow {
                title: root.label-theme-text;
                SegmentedControl {
                    track-width: 204px;
                    options: [root.theme-system-label, root.theme-light-label, root.theme-dark-label];
                    selected-index: root.theme-index;
                    selected(idx) => {
                        if (idx == 0) { root.select-theme("system"); }
                        if (idx == 1) { root.select-theme("light"); }
                        if (idx == 2) { root.select-theme("dark"); }
                    }
                }
            }

            SettingsRow {
                title: root.label-first-weekday-text;
                Select {
                    text: root.current-first-weekday-display;
                    is-open: root.first-day-dropdown-open;
                    select-width: 136px;
                    clicked => { root.toggle-first-day-dropdown(); }
                }
            }

            SettingsRow {
                title: root.label-gray-weekdays-text;
                HorizontalLayout {
                    spacing: 3px;
                    for chip in root.gray-weekday-chips : Rectangle {
                        width: 26px;
                        height: 28px;
                        border-radius: 6px;
                        background: chip.active
                            ? Theme.selected
                            : Theme.control;
                        border-width: 1px;
                        border-color: chip.active
                            ? Theme.toggle-off
                            : Theme.control-line;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: chip.label;
                            font-size: 10.5px;
                            font-weight: chip.active ? 600 : 400;
                            color: chip.active
                                ? Theme.ink
                                : Theme.ink2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.toggle-gray-weekday(chip.index); }
                        }
                    }
                }
            }

            SettingsRow {
                title: root.label-show-week-numbers-text;
                Switch {
                    checked: root.show-week-numbers;
                    toggled => { root.toggle-show-week-numbers(); }
                }
            }

            SettingsRow {
                title: root.label-show-event-dots-text;
                show-divider: false;
                Switch {
                    checked: root.show-event-dots;
                    toggled => { root.toggle-show-event-dots(); }
                }
            }
        }

        if root.first-day-dropdown-open : Rectangle {
            x: parent.width - 12px - 136px;
            y: 46px;
            width: 136px;
            height: 72px;
            Menu {
                width: 136px;
                MenuOption {
                    label: root.weekday-monday-label;
                    active: root.first-weekday-monday;
                    clicked => { root.select-first-weekday-option(true); }
                }
                MenuOption {
                    label: root.weekday-sunday-label;
                    active: !root.first-weekday-monday;
                    clicked => { root.select-first-weekday-option(false); }
                }
            }
        }
    }

    // ===== TAB 1: Accounts =====
    if root.settings-tab == 1 : Rectangle {
        width: parent.width;
        height: parent.height;

        Text {
            x: 16px;
            y: 92px;
            width: 264px;
            height: 28px;
            text: root.provider-heading-text;
            font-size: 12px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Button {
            x: 300px;
            y: 92px;
            button-width: 132px;
            label: root.add-calendar-account-label;
            enabled: root.add-account-enabled;
            clicked => { root.add-calendar-account(); }
        }

        account-card := Rectangle {
            x: 16px;
            y: 132px;
            width: 416px;
            height: 168px;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            clip: true;
            property <bool> outlook-visible: root.account-connected || root.account-needs-signin || root.outlook-sources.length > 0 || root.can-disconnect-microsoft;
            property <bool> google-visible: root.google-connected || root.google-needs-signin || root.google-sources.length > 0 || root.google-status-text != "";
            property <bool> any-account: outlook-visible || google-visible || root.ics-sources.length > 0 || root.windows-sources.length > 0;

            if root.connection-busy : VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: root.sign-in-title;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.ink;
                }
                Text {
                    text: root.waiting-browser-text;
                    font-size: 11px;
                    color: Theme.ink2;
                    wrap: word-wrap;
                }
                Button {
                    label: root.cancel-sign-in-label;
                    clicked => { root.cancel-account-sign-in(); }
                }
            }

            if !root.connection-busy : ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    if root.sign-in-cancelled : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.sign-in-cancelled-text;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.ink;
                            wrap: word-wrap;
                        }
                        Button {
                            label: root.try-again-label;
                            kind: "primary";
                            clicked => { root.retry-sign-in(); }
                        }
                    }

                    if root.connection-message != "" : Text {
                        text: root.connection-message;
                        font-size: 11px;
                        color: Theme.err;
                        wrap: word-wrap;
                    }

                    if outlook-visible : AccountBlock {
                        title: root.outlook-section-text;
                        status: root.account-needs-signin ? root.events-stale-text : root.account-status-text;
                        badge: root.account-needs-signin ? root.reconnect-label : root.provider-readonly-tag-text;
                        badge-alert: root.account-needs-signin;
                        sources: root.outlook-sources;
                        empty-text: root.no-calendars-text;
                        remove-label: root.remove-source-label;
                        primary-label: root.reconnect-label;
                        show-primary: root.account-needs-signin;
                        secondary-label: root.disconnect-microsoft-label;
                        show-secondary: root.can-disconnect-microsoft && !root.account-needs-signin;
                        refresh-label: root.refresh-button-text;
                        show-refresh: root.can-refresh-calendars;
                        controls-enabled: !root.provider-loading;
                        primary-clicked => { root.connect-microsoft(); }
                        secondary-clicked => { root.disconnect-microsoft(); }
                        refresh-clicked => { root.refresh-calendars(); }
                        toggle-source(id) => { root.toggle-calendar-source(id); }
                        remove-source(id) => { root.remove-calendar-source(id); }
                    }

                    if google-visible : AccountBlock {
                        title: root.google-account-label;
                        status: root.google-status-text;
                        badge: root.google-needs-signin ? root.reconnect-label : root.provider-readonly-tag-text;
                        badge-alert: root.google-needs-signin;
                        sources: root.google-sources;
                        empty-text: root.no-calendars-text;
                        remove-label: root.remove-source-label;
                        primary-label: root.reconnect-label;
                        show-primary: root.google-needs-signin;
                        secondary-label: root.disconnect-google-label;
                        show-secondary: !root.google-needs-signin && (root.google-connected || root.google-sources.length > 0 || root.google-status-text != "");
                        refresh-label: root.refresh-button-text;
                        show-refresh: root.can-refresh-calendars && root.google-connected;
                        controls-enabled: !root.provider-loading;
                        primary-clicked => { root.choose-google-account(); }
                        secondary-clicked => { root.disconnect-google(); }
                        refresh-clicked => { root.refresh-calendars(); }
                        toggle-source(id) => { root.toggle-calendar-source(id); }
                        remove-source(id) => { root.remove-calendar-source(id); }
                    }

                    if root.ics-sources.length > 0 : AccountBlock {
                        title: root.ics-section-text;
                        status: root.ics-status-text;
                        badge: root.ics-status-text == "" ? root.provider-readonly-tag-text : "";
                        badge-alert: root.ics-status-text != "";
                        sources: root.ics-sources;
                        empty-text: "";
                        remove-label: root.remove-source-label;
                        refresh-label: root.refresh-button-text;
                        show-refresh: root.can-refresh-calendars;
                        controls-enabled: !root.provider-loading;
                        refresh-clicked => { root.refresh-calendars(); }
                        toggle-source(id) => { root.toggle-calendar-source(id); }
                        remove-source(id) => { root.remove-calendar-source(id); }
                    }

                    if root.windows-sources.length > 0 : AccountBlock {
                        title: root.legacy-windows-label;
                        status: "";
                        badge: "";
                        sources: root.windows-sources;
                        empty-text: "";
                        remove-label: root.remove-source-label;
                        refresh-label: root.refresh-button-text;
                        show-refresh: root.can-refresh-calendars;
                        controls-enabled: !root.provider-loading;
                        refresh-clicked => { root.refresh-calendars(); }
                        toggle-source(id) => { root.toggle-calendar-source(id); }
                        remove-source(id) => { root.remove-calendar-source(id); }
                    }

                    if root.calendars-access-denied : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.calendars-denied-title-text;
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.err;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.calendars-denied-desc-text;
                            font-size: 11px;
                            color: Theme.ink2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                label: root.open-privacy-settings-label;
                                clicked => { root.open-privacy-settings(); }
                            }
                            Button {
                                label: root.retry-sync-label;
                                kind: "subtle";
                                clicked => { root.retry-calendar-sync(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        alignment: space-between;
                        Text {
                            text: root.legacy-windows-label;
                            font-size: 10.5px;
                            color: Theme.ink2;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Switch {
                            checked: root.legacy-windows-enabled;
                            toggled => { root.toggle-legacy-windows(); }
                        }
                    }

                    if !any-account && !root.sign-in-cancelled && !root.calendars-access-denied : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.calendars-empty-title-text;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.ink;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.calendars-empty-desc-text;
                            font-size: 11px;
                            font-weight: 400;
                            color: Theme.ink2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

    }

    // ===== TAB 2: App =====
    if root.settings-tab == 2 : Rectangle {
        x: 16px;
        y: 96px + warn-box.height;
        width: 416px;
        // Shrinks (and scrolls) when a wrapped warning pushes the card toward the footer.
        height: min(200px, 314px - (96px + warn-box.height));
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-line;
        background: Theme.card;
        clip: true;

        Flickable {
        content-height: 200px;
        VerticalLayout {
            height: 200px;
            padding: 0px;
            spacing: 0px;

            SettingsRow {
                title: root.label-language-text;
                Select {
                    text: root.current-language-display;
                    is-open: root.language-dropdown-open;
                    select-width: 168px;
                    clicked => { root.toggle-language-dropdown(); }
                }
            }

            SettingsRow {
                title: root.startup-status-text == "" ? root.label-startup-text : root.startup-status-text;
                title-color: root.startup-status-text == ""
                    ? Theme.ink
                    : Theme.err;
                Switch {
                    checked: root.start-with-windows;
                    toggled => { root.toggle-start-with-windows(); }
                }
            }

            SettingsRow {
                title: root.label-shortcut-text;
                subtitle: root.shortcut-has-conflict ? root.shortcut-conflict-line : "";
                subtitle-color: Theme.err;
                Text {
                    text: root.global-shortcut-display == ""
                        ? root.shortcut-unset-text
                        : root.global-shortcut-display;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    label: root.global-shortcut-display == "" || root.global-shortcut-display == root.shortcut-unset-text
                        ? root.shortcut-record-label
                        : root.shortcut-change-label;
                    button-width: 84px;
                    clicked => { root.cycle-shortcut-preset(); }
                }
                if root.shortcut-can-clear : Button {
                    label: root.shortcut-clear-label;
                    kind: "subtle";
                    clicked => { root.clear-shortcut(); }
                }
            }

            SettingsRow {
                title: root.label-tray-palette-text;

                Rectangle {
                    width: 152px;
                    height: 28px;
                    border-radius: Theme.radius-card;
                    background: Theme.track;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 24px;
                            border-radius: Theme.radius-control;
                            background: !root.tray-icon-monochrome
                                ? Theme.thumb
                                : transparent;
                            border-width: !root.tray-icon-monochrome ? 1px : 0px;
                            border-color: Theme.control-line;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                padding-left: 4px;
                                padding-right: 4px;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: root.colored-icon-preview;
                                    image-fit: contain;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.palette-colored-text;
                                    font-size: 10.5px;
                                    font-weight: !root.tray-icon-monochrome ? 600 : 400;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    if (root.tray-icon-monochrome) {
                                        root.toggle-tray-icon-monochrome();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 24px;
                            border-radius: Theme.radius-control;
                            background: root.tray-icon-monochrome
                                ? Theme.thumb
                                : transparent;
                            border-width: root.tray-icon-monochrome ? 1px : 0px;
                            border-color: Theme.control-line;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                padding-left: 4px;
                                padding-right: 4px;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: root.monochrome-icon-preview;
                                    image-fit: contain;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.palette-monochrome-text;
                                    font-size: 10.5px;
                                    font-weight: root.tray-icon-monochrome ? 600 : 400;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    if (!root.tray-icon-monochrome) {
                                        root.toggle-tray-icon-monochrome();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    Text {
                        text: root.updates-heading-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.ink;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "›";
                        font-size: 16px;
                        color: Theme.ink2;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.open-settings(3); }
                }
            }
        }
        }

    }

    if root.settings-tab == 2 && root.language-dropdown-open : Rectangle {
        x: 244px;
        y: 108px + warn-box.height;
        width: 176px;
        height: lang-menu.height;
        lang-menu := Menu {
            width: 176px;
            MenuOption {
                label: root.lang-en-us-label;
                active: root.current-language-code == "en";
                clicked => { root.select-language("en"); }
            }
            MenuOption {
                label: root.lang-ru-label;
                active: root.current-language-code == "ru";
                clicked => { root.select-language("ru"); }
            }
            MenuOption {
                label: root.lang-es-label;
                active: root.current-language-code == "es";
                clicked => { root.select-language("es"); }
            }
            MenuOption {
                label: root.lang-ja-label;
                active: root.current-language-code == "ja";
                clicked => { root.select-language("ja"); }
            }
        }
    }

    // ===== TAB 3: About =====
    if root.settings-tab == 3 : Rectangle {
        width: parent.width;
        height: parent.height;

        BrandMark {
            x: 24px;
            y: 56px;
            mark-size: 48px;
        }
        Text {
            x: 92px;
            y: 55px;
            width: 332px;
            height: 30px;
            text: root.app-name-text;
            font-size: 22px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
        Text {
            x: 92px;
            y: 90px;
            width: 332px;
            height: 20px;
            text: root.about-version-text;
            font-size: 11px;
            font-weight: 400;
            color: Theme.ink2;
            vertical-alignment: center;
            overflow: elide;
        }

        ScrollView {
            x: 0px;
            y: 132px;
            width: parent.width;
            height: 180px;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 8px;

                Rectangle {
                    height: max(64px, update-note.y + update-note.preferred-height + 10px);
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.card-line;
                    background: Theme.card;

                    Text {
                        x: 12px;
                        y: 8px;
                        width: root.update-is-available ? 220px : 264px;
                        height: 24px;
                        text: root.update-is-checking
                            ? root.checking-updates-label
                            : (root.update-is-available
                                ? root.update-ready-title-text
                                : root.update-status-text);
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.ink;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    update-note := Text {
                        x: 12px;
                        y: 34px;
                        width: root.update-is-available ? 220px : 264px;
                        height: self.preferred-height;
                        text: root.update-is-checking
                            ? ""
                            : (root.install-status-text != ""
                                ? root.install-status-text
                                : (root.update-is-available ? root.update-ready-notes-text : ""));
                        font-size: 10.5px;
                        font-weight: 400;
                        color: root.install-status-text != "" && !root.install-busy
                            ? Theme.err
                            : Theme.ink2;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    if root.update-is-available : Button {
                        x: 244px;
                        y: 18px;
                        button-width: 160px;
                        label: root.install-update-label;
                        enabled: !root.install-busy && !root.package-managed-updates;
                        clicked => { root.install-update(); }
                    }
                    if !root.update-is-available && !root.update-is-checking : Button {
                        x: 300px;
                        y: 18px;
                        button-width: 104px;
                        label: root.updates-check-button-text;
                        clicked => { root.check-updates(); }
                    }
                }

                Rectangle {
                    height: 80px;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.card-line;
                    background: Theme.card;
                    VerticalLayout {
                        spacing: 0px;
                        SettingsRow {
                            title: root.label-auto-updates-text;
                            Switch {
                                checked: root.auto-check-updates;
                                toggled => { root.toggle-auto-check-updates(); }
                            }
                        }
                        SettingsRow {
                            title: root.auto-install-label;
                            show-divider: false;
                            Switch {
                                checked: root.auto-install-updates;
                                toggled => { root.toggle-auto-install-updates(); }
                            }
                        }
                    }
                }

                // Link rows remain available by scrolling within the fixed About panel.
                for link[link-idx] in [
                    { title: root.release-notes-button-text, url: "https://github.com/andmetoo/lightcal/releases" },
                    { title: root.github-button-text, url: "https://github.com/andmetoo/lightcal" },
                    { title: root.koona-button-text, url: "https://koona.app" },
                    { title: root.license-short-text, url: "https://github.com/andmetoo/lightcal/blob/main/LICENSE" }
                ] : Rectangle {
                    height: 30px;

                    Text {
                        x: 12px;
                        width: 192px;
                        height: parent.height;
                        text: link.title;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 380px;
                        width: 24px;
                        height: parent.height;
                        text: "↗";
                        font-size: 12px;
                        color: Theme.ink2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.open-external-url(link.url); }
                    }
                }
            }
        }
    }

    if root.add-account-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        Rectangle {
            x: 44px;
            y: 80px;
            width: 360px;
            height: 236px;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            Text {
                x: 16px;
                y: 14px;
                width: 292px;
                height: 28px;
                text: root.add-account-title;
                font-size: 18px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Text {
                x: 16px;
                y: 46px;
                width: 328px;
                height: 20px;
                text: root.add-account-intro;
                font-size: 11px;
                color: Theme.ink2;
            }
            Text {
                x: 320px;
                y: 12px;
                width: 28px;
                height: 28px;
                text: "×";
                font-size: 18px;
                color: Theme.ink2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                x: 320px;
                y: 12px;
                width: 28px;
                height: 28px;
                clicked => { root.close-account-dialogs(); }
            }
            for choice[i] in [
                { title: root.google-account-label, desc: root.google-account-desc },
                { title: root.outlook-section-text, desc: root.outlook-account-desc },
                { title: root.ics-account-label, desc: root.ics-account-desc }
            ] : Rectangle {
                x: 16px;
                y: 74px + i * 48px;
                width: 328px;
                height: 40px;
                border-radius: Theme.radius-control;
                background: Theme.chip;
                Text {
                    x: 12px;
                    y: 4px;
                    width: 280px;
                    height: 18px;
                    text: choice.title;
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.ink;
                }
                Text {
                    x: 12px;
                    y: 20px;
                    width: 280px;
                    height: 16px;
                    text: choice.desc;
                    font-size: 10.5px;
                    color: Theme.ink2;
                }
                TouchArea {
                    clicked => {
                        if (i == 0) { root.choose-google-account(); }
                        if (i == 1) { root.choose-outlook-account(); }
                        if (i == 2) { root.choose-ics-account(); }
                    }
                }
            }
        }
    }

    if root.ics-dialog-open : ics-dialog := FocusScope {
        width: parent.width;
        height: parent.height;

        Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        Rectangle {
            x: 24px;
            y: 56px;
            width: 400px;
            height: 252px;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            Text {
                x: 16px;
                y: 12px;
                width: 320px;
                height: 28px;
                text: root.ics-dialog-title;
                font-size: 18px;
                font-weight: 600;
                color: Theme.ink;
            }
            Text {
                x: 360px;
                y: 12px;
                width: 28px;
                height: 28px;
                text: "×";
                font-size: 18px;
                horizontal-alignment: center;
                color: Theme.ink2;
            }
            TouchArea {
                x: 360px;
                y: 12px;
                width: 28px;
                height: 28px;
                enabled: !root.connection-busy;
                clicked => { root.close-account-dialogs(); }
            }
            Text {
                x: 16px;
                y: 48px;
                width: 368px;
                height: 32px;
                text: root.ics-privacy-text;
                font-size: 11px;
                wrap: word-wrap;
                color: Theme.ink2;
            }
            TextField {
                x: 16px;
                y: 84px;
                width: 368px;
                text <=> root.ics-source-name;
                placeholder: root.ics-name-placeholder;
                enabled: !root.connection-busy && !root.provider-loading;
            }
            url-field := TextField {
                x: 16px;
                y: 120px;
                width: 368px;
                text <=> root.ics-source-url;
                placeholder: root.ics-url-placeholder;
                enabled: !root.connection-busy && !root.provider-loading;
            }
            Text {
                x: 16px;
                y: 152px;
                width: 368px;
                height: 44px;
                text: root.connection-busy ? root.ics-loading-text
                    : (root.connection-message != "" ? root.connection-message : root.ics-stays-local-text);
                font-size: 10.5px;
                wrap: word-wrap;
                color: !root.connection-busy && root.connection-message != ""
                    ? Theme.err
                    : Theme.ink2;
            }
            Button {
                x: 196px;
                y: 204px;
                button-width: 88px;
                label: root.cancel-sign-in-label;
                enabled: !root.connection-busy;
                clicked => { root.close-account-dialogs(); }
            }
            Button {
                x: 292px;
                y: 204px;
                button-width: 92px;
                label: root.subscribe-label;
                kind: "primary";
                enabled: !root.connection-busy && !root.provider-loading
                    && root.ics-source-name != "" && root.ics-source-url != "";
                clicked => { root.add-ics-source(root.ics-source-name, root.ics-source-url); }
            }
        }
        }
        init => { url-field.focus-input(); }
    }

    // Footer
    Rectangle {
        x: 16px;
        y: 320px;
        width: 416px;
        height: 1px;
        background: Theme.line;
    }

    if root.settings-tab != 3 : Rectangle {
        x: 0px;
        y: 320px;
        width: parent.width;
        height: 40px;
        Text {
            x: 16px;
            y: 8px;
            width: 240px;
            height: 24px;
            text: root.about-link-text;
            font-size: 11px;
            font-weight: 500;
            color: about-touch.has-hover
                ? Theme.ink
                : Theme.ink2;
            vertical-alignment: center;
        }
        about-touch := TouchArea {
            x: 16px;
            y: 8px;
            width: 240px;
            height: 24px;
            clicked => { root.open-settings(3); }
        }
        Text {
            x: 280px;
            y: 8px;
            width: 152px;
            height: 24px;
            text: root.app-version-line-text;
            font-size: 10.5px;
            font-weight: 400;
            color: Theme.ink2;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.settings-tab == 3 : Rectangle {
        x: 0px;
        y: 320px;
        width: parent.width;
        height: 40px;
        Text {
            x: 16px;
            y: 8px;
            width: 416px;
            height: 24px;
            text: root.back-to-calendar-text;
            font-size: 11px;
            font-weight: 500;
            color: back-touch.has-hover
                ? Theme.ink
                : Theme.ink2;
            vertical-alignment: center;
        }
        back-touch := TouchArea {
            x: 16px;
            y: 8px;
            width: 416px;
            height: 24px;
            clicked => { root.open-settings(2); } // App tab (Penpot Back to settings)
        }
    }
}
