// Settings (Calendar, Accounts, App) and About, 448 × 360 (ADR 0011).
// Spec boards: design/canvas/SettingsCalendar, SettingsAccounts, SettingsApp,
// WinAbout, States and Languages. AppWindow forwards data and callbacks.
//
// Layout: 32 px caption · 40 px selector bar · body (cards on the page) ·
// 36 px footer. About replaces the selector bar and uses its own footer.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BrandMark, CaptionButton, ControlFrame, Icon, Keycap, LinkButton, Menu, MenuOption, GridSelect, Switch, TextField } from "controls.slint";

// Heart + label that opens GitHub Sponsors (footer, always visible).
component SponsorButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 24px;
    width: self.preferred-width;
    border-radius: Theme.radius-control;
    background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        Icon {
            name: "heart";
            size: 14px;
            color: Theme.coral;
            fill-color: Theme.coral;
            weight: 1.5;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            font-size: Theme.type-caption;
            font-weight: Theme.weight-medium;
            color: touch.has-hover ? Theme.ink : Theme.ink2;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
import { AccountCardItem, CalendarDateSize, CalendarSourceItem, SettingsStrings, WeekdayChipItem, MenuEntry, LocalCardData } from "types.slint";

// 24-unit stroke icons used by settings (Lucide-style geometry from the boards).
component Glyph inherits Path {
    in property <string> name;
    in property <length> size: 16px;
    in property <color> color: Theme.ink2;
    in property <float> weight: 2;

    width: root.size;
    height: root.size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: root.size * root.weight / 24;
    stroke-line-cap: round;
    commands: root.name == "chevron-left" ? "M15 18 L9 12 L15 6"
        : root.name == "chevron-right" ? "M9 18 L15 12 L9 6"
        : root.name == "check" ? "M20 6 L9 17 L4 12"
        : root.name == "close" ? "M18 6 L6 18 M6 6 L18 18"
        : root.name == "external" ? "M7 17 L17 7 M8 7 L17 7 L17 16"
        : root.name == "plus" ? "M12 5 L12 19 M5 12 L19 12"
        : root.name == "refresh" ? "M21 12 A9 9 0 1 1 18.36 5.64 M21 3 L21 9 L15 9"
        : root.name == "lock" ? "M6 11 L18 11 A2 2 0 0 1 20 13 L20 19 A2 2 0 0 1 18 21 L6 21 A2 2 0 0 1 4 19 L4 13 A2 2 0 0 1 6 11 Z M8 11 L8 7 A4 4 0 0 1 16 7 L16 11"
        : root.name == "warning" ? "M12 3 L2 20 L22 20 Z M12 10 L12 14 M12 17 L12.01 17"
        : root.name == "wifi-off" ? "M2 9 A15 15 0 0 1 22 9 M5 12.5 A10 10 0 0 1 19 12.5 M8.5 16 A5 5 0 0 1 15.5 16 M3 3 L21 21"
        : root.name == "alert" ? "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M12 8 L12 13 M12 16 L12.01 16"
        : root.name == "info" ? "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M12 16 L12 11 M12 8 L12.01 8"
        : root.name == "link" ? "M10 13 A5 5 0 0 0 17.5 13.5 L20.5 10.5 A5 5 0 0 0 13.5 3.5 L11.8 5.2 M14 11 A5 5 0 0 0 6.5 10.5 L3.5 13.5 A5 5 0 0 0 10.5 20.5 L12.2 18.8"
        : root.name == "calendar" ? "M6 4.5 L18 4.5 A3 3 0 0 1 21 7.5 L21 17.5 A3 3 0 0 1 18 20.5 L6 20.5 A3 3 0 0 1 3 17.5 L3 7.5 A3 3 0 0 1 6 4.5 Z M3 9.5 L21 9.5 M8 2.5 L8 6.5 M16 2.5 L16 6.5"
        : root.name == "person" ? "M16 8 A4 4 0 1 1 8 8 A4 4 0 1 1 16 8 Z M4 21 A8 8 0 0 1 20 21"
        : root.name == "app" ? "M7 3 L17 3 A4 4 0 0 1 21 7 L21 17 A4 4 0 0 1 17 21 L7 21 A4 4 0 0 1 3 17 L3 7 A4 4 0 0 1 7 3 Z M8 9 L16 9 M8 15 L13 15"
        : "";
}

// Vertically centres one fixed-size child inside a horizontal layout.
component Centered inherits VerticalLayout {
    alignment: center;
    @children
}

// Ghost 28 × 28 icon button (.ib). `icon: "more"` draws the three dots.
component GhostButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.radius-control;
    background: !root.enabled ? transparent : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    if root.icon != "more" : Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        weight: 1.75;
        color: touch.has-hover ? Theme.ink : Theme.ink2;
    }
    if root.icon == "more" : Rectangle {
        for i in 3 : Rectangle {
            x: 6.8px + i * 5.333px;
            y: 12.8px;
            width: 3.2px;
            height: 3.2px;
            border-radius: 1.6px;
            background: touch.has-hover ? Theme.ink : Theme.ink2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Push button with optional leading icon and trailing external arrow.
// kind: "secondary" (.btn) or "primary" (.pb).
component ActButton inherits Rectangle {
    in property <string> label;
    in property <string> kind: "secondary";
    in property <string> icon;
    in property <bool> external: false;
    in property <bool> enabled: true;
    in property <length> button-height: 28px;
    callback clicked();

    height: root.button-height;
    width: self.preferred-width;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    background: root.kind == "primary"
        ? (touch.has-hover && root.enabled ? Theme.primary-hover : Theme.primary)
        : transparent;

    if root.kind != "primary" : ControlFrame {
        width: 100%;
        height: 100%;
        hovered: touch.has-hover && root.enabled;
        pressed: touch.pressed && root.enabled;
    }

    HorizontalLayout {
        padding-left: root.kind == "primary" ? 12px : 10px;
        padding-right: root.kind == "primary" ? 12px : 10px;
        spacing: 6px;
        alignment: center;

        if root.icon != "" : Centered {
            Glyph {
                name: root.icon;
                size: 14px;
                color: root.kind == "primary" ? Theme.on-primary : Theme.ink;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.type-body;
            font-weight: Theme.weight-medium;
            color: root.kind == "primary" ? Theme.on-primary : Theme.ink;
            vertical-alignment: center;
        }
        if root.external : Centered {
            Glyph {
                name: "external";
                size: 11px;
                weight: 2.25;
                color: root.kind == "primary" ? Theme.on-primary : Theme.ink2;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Tray icon preview drawn in Slint (32-unit artwork at 24 px). Color: coral
// tile, darker band, white date. Mono: outline and band in ink.
component TrayPreview inherits Rectangle {
    in property <bool> mono: false;
    in property <string> day: "1";
    property <length> u: 24px / 32;

    width: 24px;
    height: 24px;

    Rectangle {
        x: root.u;
        y: root.u;
        width: 30 * root.u;
        height: 30 * root.u;
        border-radius: 6 * root.u;
        background: root.mono ? transparent : Theme.coral;
        border-width: root.mono ? 2 * root.u : 0px;
        border-color: Theme.ink;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 6 * root.u;
            background: root.mono ? Theme.ink : Theme.coral-band;
        }
    }
    Text {
        x: 0px;
        y: 7 * root.u;
        width: parent.width;
        height: 24 * root.u;
        text: root.day;
        font-size: 19 * root.u;
        font-weight: Theme.weight-bold;
        color: root.mono ? Theme.ink : Theme.on-coral;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One segment of a track (.seg button).
component Segment inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    in property <length> fixed-width: 0px;
    in property <length> segment-height: 24px;
    in property <bool> has-preview: false;
    in property <bool> preview-mono: false;
    in property <string> preview-day;
    // Date size options show a "28" sample at this size before the label.
    in property <length> sample-size: 0px;
    callback clicked();

    width: root.fixed-width > 0px ? root.fixed-width : max(28px, lay.preferred-width);
    height: root.segment-height;
    border-radius: Theme.radius-control;
    background: root.on ? Theme.thumb : transparent;
    border-width: root.on ? 1px : 0px;
    border-color: Theme.control-line;
    drop-shadow-blur: root.on ? 2px : 0px;
    drop-shadow-offset-y: root.on ? 1px : 0px;
    drop-shadow-color: root.on ? #00000014 : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }

    lay := HorizontalLayout {
        padding-left: root.fixed-width > 0px ? 0px : (root.has-preview ? 8px : 10px);
        padding-right: root.fixed-width > 0px ? 0px : (root.has-preview ? 12px : 10px);
        spacing: root.has-preview ? 8px : 6px;
        alignment: center;
        if root.sample-size > 0px : Text {
            text: "28";
            font-size: root.sample-size;
            font-weight: Theme.weight-semibold;
            color: root.on || touch.has-hover ? Theme.ink : Theme.ink2;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.has-preview : Centered {
            TrayPreview {
                mono: root.preview-mono;
                day: root.preview-day;
            }
        }
        Text {
            text: root.label;
            font-size: root.has-preview ? Theme.type-body : Theme.type-caption;
            font-weight: Theme.weight-medium;
            color: root.on || touch.has-hover ? Theme.ink : Theme.ink2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Segmented track sized to its segments (.seg).
component Track inherits Rectangle {
    in property <length> track-height: 28px;
    height: root.track-height;
    width: self.preferred-width;
    border-radius: Theme.radius-card;
    background: Theme.track;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        @children
    }
}


// Indeterminate spinner: a teal quarter arc on a line-colored ring.
component Spinner inherits Rectangle {
    in property <length> size: 28px;
    property <angle> a: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: Theme.line;
        stroke-width: root.size * 2.5 / 24;
        commands: "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: root.size * 2.5 / 24;
        stroke-line-cap: round;
        MoveTo {
            x: 12 + 9 * cos(root.a);
            y: 12 + 9 * sin(root.a);
        }
        ArcTo {
            x: 12 + 9 * cos(root.a + 90deg);
            y: 12 + 9 * sin(root.a + 90deg);
            radius-x: 9;
            radius-y: 9;
            sweep: true;
        }
    }
}

// Teal 16 px checkbox (.cb).
component Checkbox inherits Rectangle {
    in property <bool> checked;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.toggle-off;
    background: root.checked ? Theme.primary : transparent;
    if root.checked : Glyph {
        x: 3px;
        y: 3px;
        name: "check";
        size: 10px;
        weight: 3.5;
        color: Theme.on-primary;
    }
}

// Inline message box in err/err-bg, or warn/warn-bg with `warn`.
component MessageBox inherits Rectangle {
    in property <string> text;
    in property <bool> warn: false;
    in property <bool> dismissible: false;
    in property <string> dismiss-label;
    callback dismissed();

    height: msg.preferred-height + 16px;
    border-radius: Theme.radius-control;
    background: root.warn ? Theme.warn-bg : Theme.err-bg;

    Glyph {
        x: 10px;
        y: 9px;
        name: "alert";
        size: 14px;
        color: root.warn ? Theme.warn : Theme.err;
    }
    msg := Text {
        x: 32px;
        y: 8px;
        width: parent.width - 42px - (root.dismissible ? 24px : 0px);
        text: root.text;
        font-size: Theme.type-caption;
        color: root.warn ? Theme.warn : Theme.err;
        wrap: word-wrap;
    }
    if root.dismissible : Rectangle {
        x: parent.width - 30px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-key;
        background: dismiss-touch.has-hover ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: root.dismiss-label;
        Glyph {
            x: 6px;
            y: 6px;
            name: "close";
            size: 12px;
            color: root.warn ? Theme.warn : Theme.err;
        }
        dismiss-touch := TouchArea {
            clicked => { root.dismissed(); }
        }
    }
}

// On this PC (LocalSettings board): a 44 px header with the teal monitor tile, name,
// "Local · 4 events" and the show checkbox, then at most one notice.
component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 26px;
    width: text.preferred-width + 20px;
    border-radius: Theme.radius-control;
    border-width: root.danger ? 0px : 1px;
    border-color: Theme.control-line;
    background: root.danger
        ? (touch.has-hover ? #B02718 : #C42B1C)
        : (touch.has-hover ? Theme.hover : Theme.control);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    text := Text {
        text: root.label;
        font-size: Theme.type-caption;
        font-weight: Theme.weight-medium;
        color: root.danger ? #FFFFFF : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component LocalCard inherits Rectangle {
    in property <LocalCardData> data;
    callback toggle();
    callback ok();
    callback show-folder();
    callback try-now();
    callback ask-start-over();
    callback start-over();
    callback keep();

    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-line;
    border-radius: Theme.radius-card;
    clip: true;

    VerticalLayout {
        padding: 1px;
        HorizontalLayout {
            height: 44px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            Centered {
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: #0F766E;
                    // A monitor: screen and stand.
                    Path {
                        width: 16px;
                        height: 16px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: #FFFFFF;
                        stroke-width: 16px * 2 / 24;
                        stroke-line-cap: round;
                        fill: transparent;
                        commands: "M5 4 L19 4 A2 2 0 0 1 21 6 L21 14 A2 2 0 0 1 19 16 L5 16 A2 2 0 0 1 3 14 L3 6 A2 2 0 0 1 5 4 Z M8 20 L16 20 M12 16 L12 20";
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.data.name;
                    font-size: Theme.type-body;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: root.data.sub;
                    font-size: Theme.type-caption;
                    color: Theme.ink2;
                    overflow: elide;
                }
            }
            Centered {
                Rectangle {
                    width: 16px;
                    height: 16px;
                    accessible-role: checkbox;
                    accessible-checked: root.data.checked;
                    accessible-label: root.data.name;
                    Checkbox { checked: root.data.checked; }
                    TouchArea {
                        x: -8px;
                        y: -8px;
                        width: 32px;
                        height: 32px;
                        clicked => { root.toggle(); }
                    }
                }
            }
        }

        // Quiet line: spinner or check, text, OK.
        if root.data.notice == 1 : Rectangle {
            VerticalLayout {
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 8px;
                    if root.data.spinner : Centered { Spinner { } }
                    if root.data.check : Centered {
                        Glyph { name: "check"; size: 14px; color: Theme.accent; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.data.text;
                        font-size: Theme.type-caption;
                        color: Theme.ink2;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    if root.data.ok : Centered {
                        SmallButton {
                            label: root.data.ok-label;
                            clicked => { root.ok(); }
                        }
                    }
                }
            }
        }

        // Amber: text, the kept file, and its actions.
        if root.data.notice == 2 : Rectangle {
            background: Theme.warn-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                VerticalLayout {
                    padding-top: 1px;
                    alignment: start;
                    Glyph { name: "warning"; size: 14px; color: Theme.warn; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Text {
                        text: root.data.text;
                        font-size: Theme.type-caption;
                        font-weight: Theme.weight-medium;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }
                    if root.data.file != "" : Text {
                        text: root.data.file;
                        font-family: "Cascadia Mono";
                        font-size: Theme.type-small;
                        color: Theme.warn;
                        wrap: char-wrap;
                    }
                    if root.data.ok || root.data.folder || root.data.retry : HorizontalLayout {
                        padding-top: 3px;
                        spacing: 6px;
                        alignment: start;
                        if root.data.folder : SmallButton {
                            label: root.data.folder-label;
                            clicked => { root.show-folder(); }
                        }
                        if root.data.retry : SmallButton {
                            label: root.data.retry-label;
                            clicked => { root.try-now(); }
                        }
                        if root.data.ok : SmallButton {
                            label: root.data.ok-label;
                            clicked => { root.ok(); }
                        }
                    }
                }
            }
        }

        // Red box: heading, text, the kept file, Show in folder and Start over, or the
        // Start over question.
        if root.data.notice == 3 : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            Rectangle {
                border-radius: Theme.radius-control;
                background: Theme.err-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        padding-top: 1px;
                        alignment: start;
                        Glyph { name: "alert"; size: 14px; color: Theme.err; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.data.head;
                            font-size: Theme.type-caption;
                            font-weight: Theme.weight-semibold;
                            color: Theme.err;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.data.text;
                            font-size: Theme.type-caption;
                            color: Theme.ink2;
                            wrap: word-wrap;
                        }
                        if root.data.file != "" : Text {
                            text: root.data.file;
                            font-family: "Cascadia Mono";
                            font-size: Theme.type-small;
                            color: Theme.ink;
                            wrap: char-wrap;
                        }
                        if root.data.confirm || root.data.folder || root.data.start-over : HorizontalLayout {
                            padding-top: 4px;
                            spacing: 6px;
                            alignment: start;
                            if root.data.confirm : SmallButton {
                                danger: true;
                                label: root.data.start-over-label;
                                clicked => { root.start-over(); }
                            }
                            if root.data.confirm : SmallButton {
                                label: root.data.cancel-label;
                                clicked => { root.keep(); }
                            }
                            if !root.data.confirm && root.data.folder : SmallButton {
                                label: root.data.folder-label;
                                clicked => { root.show-folder(); }
                            }
                            if !root.data.confirm && root.data.start-over : SmallButton {
                                label: root.data.start-over-label;
                                clicked => { root.ask-start-over(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 40 px settings row (.r) with a label and right-aligned controls.
component Row inherits Rectangle {
    in property <string> title;
    in property <bool> divider: true;
    in property <length> row-height: 40px;
    height: root.row-height;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.title;
            font-size: Theme.type-body;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: end;
            @children
        }
    }
    if root.divider : Rectangle {
        x: 12px;
        y: parent.height - 1px;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.line;
    }
}

// Settings card: card fill, card line, radius 8; 1 px inset for the border.
component SettingsCard inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-line;
    border-radius: Theme.radius-card;
    VerticalLayout {
        padding: 1px;
        @children
    }
}

// Provider choice row (.prov), 44 px, used by the Accounts empty state.
component ProviderRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> letter;
    in property <string> glyph;
    in property <color> tile;
    in property <bool> divider: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    if root.divider : Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Centered {
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: root.tile;
                if root.glyph == "" : Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.letter;
                    font-size: Theme.type-caption;
                    font-weight: Theme.weight-bold;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.glyph != "" : Glyph {
                    x: 7px;
                    y: 7px;
                    name: root.glyph;
                    size: 14px;
                    weight: 2.2;
                    color: #FFFFFF;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.type-body;
                font-weight: Theme.weight-medium;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.desc;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                overflow: elide;
            }
        }
        Centered {
            Glyph {
                name: "chevron-right";
                size: 14px;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One connected account: header, optional notice, calendar rows (.cr).
component AccountCard inherits Rectangle {
    in property <bool> macos: false;
    in property <AccountCardItem> card;
    in property <string> refresh-label;
    in property <string> more-label;
    in property <bool> enabled: true;
    callback action(string);
    callback refresh(string);
    callback disconnect(string);
    callback toggle-source(string);

    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-line;
    border-radius: Theme.radius-card;

    VerticalLayout {
        padding: 1px;
        padding-bottom: root.card.notice-kind == 0 || root.card.sources.length > 0 || root.card.empty-text != "" ? 5px : 1px;

        HorizontalLayout {
            height: 52px;
            padding-left: 11px;
            padding-right: 7px;
            spacing: 10px;
            Centered {
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.avatar;
                    if root.macos && root.card.id == "windows" : Glyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: "calendar";
                        size: 16px;
                        color: Theme.accent;
                    }
                    if !root.macos || root.card.id != "windows" : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.card.initial;
                        font-size: Theme.type-caption;
                        font-weight: Theme.weight-semibold;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                Text {
                    text: root.card.title;
                    font-size: Theme.type-body;
                    font-weight: Theme.weight-semibold;
                    color: Theme.ink;
                    overflow: elide;
                }
                if root.card.detail != "" : Text {
                    text: root.card.detail;
                    font-size: Theme.type-caption;
                    color: Theme.ink2;
                    overflow: elide;
                }
            }
            if root.card.can-refresh : Centered {
                GhostButton {
                    icon: "refresh";
                    label: root.refresh-label;
                    enabled: root.enabled;
                    clicked => { root.refresh(root.card.id); }
                }
            }
            if root.card.can-disconnect : Centered {
                more := GhostButton {
                    icon: "more";
                    label: root.more-label;
                    enabled: root.enabled;
                    clicked => { menu.show(); }
                }
            }
        }

        // Needs attention: amber strip with one action.
        if root.card.notice-kind == 2 : Rectangle {
            height: max(42px, notice-text.preferred-height + 16px);
            background: Theme.warn-bg;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                spacing: 10px;
                Centered {
                    Glyph {
                        name: "warning";
                        size: 14px;
                        color: Theme.warn;
                    }
                }
                notice-text := Text {
                    horizontal-stretch: 1;
                    text: root.card.notice;
                    font-size: Theme.type-caption;
                    font-weight: Theme.weight-medium;
                    color: Theme.warn;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if root.card.action-label != "" : Centered {
                    ActButton {
                        kind: "primary";
                        button-height: 26px;
                        label: root.card.action-label;
                        enabled: root.enabled;
                        clicked => { root.action(root.card.id); }
                    }
                }
            }
        }

        // Offline or informational: one quiet line.
        if root.card.notice-kind == 1 : Rectangle {
            height: quiet-text.preferred-height + 16px;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
            Glyph {
                x: 11px;
                y: 9px;
                name: root.card.notice-offline ? "wifi-off" : "info";
                size: 14px;
            }
            quiet-text := Text {
                x: 35px;
                y: 8px;
                width: parent.width - 46px;
                text: root.card.notice;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                wrap: word-wrap;
            }
        }

        if root.card.notice-kind == 0 && (root.card.sources.length > 0 || root.card.empty-text != "") : Rectangle {
            height: 5px;
            Rectangle {
                x: 11px;
                y: 0px;
                width: parent.width - 22px;
                height: 1px;
                background: Theme.line;
            }
        }

        for src in root.card.sources : HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            row := Rectangle {
                height: 30px;
                border-radius: Theme.radius-control;
                background: row-touch.has-hover && root.enabled ? Theme.hover : transparent;
                accessible-role: checkbox;
                accessible-checked: src.checked;
                accessible-label: src.name;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Centered {
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.mark(src.swatch);
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: src.name;
                        font-size: Theme.type-body;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Centered {
                        Checkbox {
                            checked: src.checked;
                        }
                    }
                }
                row-touch := TouchArea {
                    enabled: root.enabled;
                    clicked => { root.toggle-source(src.id); }
                }
            }
        }

        if root.card.sources.length == 0 && root.card.empty-text != "" : Text {
            height: 30px;
            x: 16px;
            text: root.card.empty-text;
            font-size: Theme.type-caption;
            color: Theme.ink2;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    menu := PopupWindow {
        x: root.width - 176px;
        y: 42px;
        width: 168px;
        Menu {
            MenuOption {
                label: root.card.disconnect-label;
                clicked => { root.disconnect(root.card.id); }
            }
        }
    }
}

// About link row (.lk): title, right-aligned description, external arrow.
component LinkRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> divider: false;
    callback clicked();

    height: 40px;
    accessible-role: button;
    accessible-label: root.title;

    if root.divider : Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 1px;
        background: Theme.line;
    }
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        border-radius: Theme.radius-control;
        background: touch.has-hover ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            text: root.title;
            font-size: Theme.type-body;
            color: Theme.ink;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.desc;
            font-size: Theme.type-caption;
            color: Theme.ink2;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Centered {
            Glyph {
                name: "external";
                size: 12px;
            }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Selector bar tab: icon + label, one 16 × 3 teal marker when active.
component SelectorTab inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 40px;
    width: self.preferred-width;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Centered {
            Glyph {
                name: root.icon;
                size: 16px;
                weight: 1.75;
                color: root.active || touch.has-hover ? Theme.ink : Theme.ink2;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.type-body;
            font-weight: Theme.weight-medium;
            color: root.active || touch.has-hover ? Theme.ink : Theme.ink2;
            vertical-alignment: center;
        }
    }
    if root.active : Rectangle {
        x: (parent.width - 16px) / 2;
        y: parent.height - 6px;
        width: 16px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsView inherits Rectangle {
    in property <bool> macos: false;
    in property <[string]> mac-texts;
    in property <int> mac-weekday: 1;
    in property <bool> mac-month: false;
    callback mac-action(int);
    in property <string> app-name-text;
    in property <int> settings-tab;
    in property <string> nav-about-text;
    in property <string> settings-title-text;
    in property <string> nav-appearance-text;
    in property <string> nav-calendars-text;
    in property <string> nav-general-text;
    in property <string> startup-warning;
    in property <string> dismiss-label-text;
    in property <string> label-theme-text;
    in property <string> theme-system-label;
    in property <string> theme-light-label;
    in property <string> theme-dark-label;
    in property <string> label-first-weekday-text;
    in property <string> label-gray-weekdays-text;
    in property <[WeekdayChipItem]> gray-weekday-chips;
    in property <string> label-show-week-numbers-text;
    in property <bool> show-week-numbers;
    in property <string> label-show-event-dots-text;
    in property <bool> show-event-dots;
    in property <string> label-show-koi-text;
    in property <bool> show-koi;
    in property <string> label-date-size-text;
    in property <string> date-size-standard-label;
    in property <string> date-size-large-label;
    in property <string> date-size-larger-label;
    in property <CalendarDateSize> date-size;
    // Full day names, Monday first; `first-weekday` is a Monday-based index into them.
    in property <[MenuEntry]> first-weekday-entries;
    in property <int> first-weekday;
    in property <bool> add-account-enabled;
    in property <bool> connection-busy;
    in property <bool> sign-in-cancelled;
    in property <string> connection-message;
    in property <bool> provider-loading;
    in property <string> label-language-text;
    in property <string> startup-status-text;
    in property <string> label-startup-text;
    in property <bool> start-with-windows;
    in property <string> label-shortcut-text;
    in property <bool> shortcut-has-conflict;
    in property <[string]> shortcut-keys;
    in property <string> shortcut-unset-text;
    in property <bool> shortcut-can-clear;
    in property <string> label-tray-palette-text;
    in property <bool> tray-icon-monochrome;
    in property <string> palette-colored-text;
    in property <string> palette-monochrome-text;
    in property <string> live-day-text;
    in property <string> updates-heading-text;
    in property <[MenuEntry]> language-options;
    // Position of the current language in `language-options`.
    in property <int> current-language-index;
    // Headless snapshots only: 1 opens the week menu, 2 the language menu.
    in property <int> snapshot-open-menu;
    in property <string> about-version-text;
    in property <bool> update-is-available;
    in property <bool> update-is-checking;
    in property <string> install-status-text;
    in property <bool> install-busy;
    in property <string> install-update-label;
    in property <bool> install-configured;
    in property <bool> package-managed-updates;
    in property <bool> auto-check-updates;
    in property <string> auto-install-label;
    in property <bool> auto-install-updates;
    in property <bool> add-account-open;
    in property <bool> ics-dialog-open;
    in-out property <string> ics-source-url;
    in property <string> ics-loading-text;
    in property <string> about-link-text;
    in property <string> back-to-calendar-text;
    in property <string> current-theme-code;
    in property <SettingsStrings> copy;
    in property <[AccountCardItem]> account-cards;
    in property <LocalCardData> local-card;
    callback local-ok();
    callback local-show-folder();
    callback local-try-now();
    callback local-ask-start-over();
    callback local-start-over();
    callback local-keep();
    callback close-settings();
    callback open-settings(int);
    callback dismiss-startup-warning();
    callback select-theme(string);
    callback toggle-gray-weekday(int);
    callback toggle-show-week-numbers();
    callback toggle-show-event-dots();
    callback toggle-show-koi();
    callback select-date-size(CalendarDateSize);
    callback select-first-weekday-option(int);
    callback add-calendar-account();
    callback cancel-account-sign-in();
    callback reopen-sign-in-browser();
    callback retry-sign-in();
    callback connect-microsoft();
    callback disconnect-microsoft();
    callback refresh-calendars();
    callback toggle-calendar-source(string);
    callback remove-calendar-source(string);
    callback choose-google-account();
    callback disconnect-google();
    callback open-privacy-settings();
    callback toggle-legacy-windows();
    callback toggle-start-with-windows();
    callback record-shortcut(string, bool, bool, bool, bool);
    callback clear-shortcut();
    callback toggle-tray-icon-monochrome();
    callback select-language(string);
    callback install-update();
    callback check-updates();
    callback toggle-auto-check-updates();
    callback toggle-auto-install-updates();
    callback open-external-url(string);
    // GitHub Sponsors: monthly page, or the one-time page when `one-time` is true.
    callback open-sponsor(bool);
    callback close-account-dialogs();
    callback choose-outlook-account();
    callback choose-ics-account();
    callback add-ics-source(string, string);

    property <int> theme-index: root.current-theme-code == "light" ? 1
        : (root.current-theme-code == "dark" ? 2 : 0);
    property <bool> about: root.settings-tab == 3;
    // Body area between the selector bar (or caption on About) and the footer.
    property <length> body-top: root.about ? 32px : 73px;
    property <length> body-height: 323px - root.body-top;
    property <bool> recording: false;
    property <bool> signing-in: root.connection-busy && !root.ics-dialog-open;

    width: 448px;
    height: 360px;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.card-line;
    background: Theme.page;
    clip: true;

    // ===== Caption (32 px): mark, title, Close only =====
    BrandMark {
        x: 12px;
        y: 8px;
        mark-size: 16px;
    }
    Text {
        x: 36px;
        y: 0px;
        width: 360px;
        height: 32px;
        text: root.about ? root.about-link-text : root.copy.window-title;
        font-size: Theme.type-caption;
        color: Theme.ink2;
        vertical-alignment: center;
        overflow: elide;
    }
    if !root.macos : CaptionButton {
        x: parent.width - 46px;
        y: 0px;
        label: root.copy.close-label;
        clicked => { root.close-settings(); }
    }
    if root.macos : GhostButton {
        x: parent.width - 34px;
        y: 2px;
        icon: "close";
        label: root.copy.close-label;
        clicked => { root.close-settings(); }
    }

    // ===== Selector bar (40 px) with one hairline =====
    if !root.about : Rectangle {
        x: 0px;
        y: 32px;
        width: parent.width;
        height: 41px;
        HorizontalLayout {
            height: 40px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: start;
            SelectorTab {
                icon: "calendar";
                label: root.nav-appearance-text;
                active: root.settings-tab == 0;
                clicked => { root.open-settings(0); }
            }
            SelectorTab {
                icon: "person";
                label: root.nav-calendars-text;
                active: root.settings-tab == 1;
                clicked => { root.open-settings(1); }
            }
            SelectorTab {
                icon: "app";
                label: root.nav-general-text;
                active: root.settings-tab == 2;
                clicked => { root.open-settings(2); }
            }
        }
        Rectangle {
            x: 0px;
            y: 40px;
            width: parent.width;
            height: 1px;
            background: Theme.card-line;
        }
    }

    // ===== Calendar tab =====
    if root.settings-tab == 0 : cal-tab := Rectangle {
        x: 0px;
        y: root.body-top;
        width: parent.width;
        height: root.body-height;

        // Scrolls once the Date size row pushes the cards past the window height.
        ScrollView {
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: cal-col.preferred-height;

            cal-col := VerticalLayout {
                width: parent.width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                alignment: start;

                SettingsCard {
                    Row {
                        title: root.label-theme-text;
                        Centered {
                            Track {
                                for opt[idx] in [root.theme-system-label, root.theme-light-label, root.theme-dark-label] : Segment {
                                    label: opt;
                                    on: root.theme-index == idx;
                                    clicked => {
                                        if (idx == 0) { root.select-theme("system"); }
                                        if (idx == 1) { root.select-theme("light"); }
                                        if (idx == 2) { root.select-theme("dark"); }
                                    }
                                }
                            }
                        }
                    }
                    Row {
                        title: root.label-date-size-text;
                        divider: false;
                        Centered {
                            Track {
                                for opt in [
                                    { label: root.date-size-standard-label, size: CalendarDateSize.standard, sample: 10px },
                                    { label: root.date-size-large-label, size: CalendarDateSize.large, sample: 11.5px },
                                    { label: root.date-size-larger-label, size: CalendarDateSize.larger, sample: 13px },
                                ] : Segment {
                                    label: opt.label;
                                    sample-size: opt.sample;
                                    on: root.date-size == opt.size;
                                    clicked => { root.select-date-size(opt.size); }
                                }
                            }
                        }
                    }
                }

                SettingsCard {
                    Row {
                        title: root.label-first-weekday-text;
                        Centered {
                            // Three columns, top to bottom: Monday-Wednesday,
                            // Thursday-Saturday, Sunday.
                            GridSelect {
                                accessible-label: root.label-first-weekday-text;
                                entries: root.first-weekday-entries;
                                current-index: root.first-weekday;
                                columns: 3;
                                select-width: 136px;
                                menu-width: 400px;
                                bounds-width: root.width;
                                show-menu: root.snapshot-open-menu == 1;
                                selected(index) => { root.select-first-weekday-option(index); }
                            }
                        }
                    }
                    Row {
                        title: root.label-gray-weekdays-text;
                        Centered {
                            Track {
                                for chip in root.gray-weekday-chips : Segment {
                                    fixed-width: 28px;
                                    label: chip.label;
                                    on: chip.active;
                                    clicked => { root.toggle-gray-weekday(chip.index); }
                                }
                            }
                        }
                    }
                    Row {
                        title: root.label-show-week-numbers-text;
                        Centered {
                            Switch {
                                label: root.label-show-week-numbers-text;
                                checked: root.show-week-numbers;
                                toggled => { root.toggle-show-week-numbers(); }
                            }
                        }
                    }
                    Row {
                        title: root.label-show-event-dots-text;
                        Centered {
                            Switch {
                                label: root.label-show-event-dots-text;
                                checked: root.show-event-dots;
                                toggled => { root.toggle-show-event-dots(); }
                            }
                        }
                    }
                    Row {
                        title: root.label-show-koi-text;
                        divider: false;
                        Centered {
                            Switch {
                                label: root.label-show-koi-text;
                                checked: root.show-koi;
                                toggled => { root.toggle-show-koi(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== Accounts tab =====
    if root.settings-tab == 1 : Rectangle {
        x: 0px;
        y: root.body-top;
        width: parent.width;
        height: root.body-height;

        // Signing in: one card with a spinner, Cancel and Open browser again.
        if root.signing-in : VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 20px;
            alignment: start;
            Rectangle {
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.card-line;
                border-radius: Theme.radius-card;
                VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 20px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Spinner { }
                    }
                    Text {
                        text: root.copy.signing-title;
                        font-size: 14px;
                        font-weight: Theme.weight-semibold;
                        color: Theme.ink;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: root.copy.signing-note;
                        font-size: Theme.type-caption;
                        color: Theme.ink2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        padding-top: 6px;
                        spacing: 8px;
                        alignment: center;
                        ActButton {
                            label: root.copy.cancel;
                            clicked => { root.cancel-account-sign-in(); }
                        }
                        ActButton {
                            label: root.copy.open-browser-again;
                            clicked => { root.reopen-sign-in-browser(); }
                        }
                    }
                }
            }
        }

        // Private ICS link: one field, privacy note, Cancel and Subscribe.
        if !root.signing-in && root.ics-dialog-open : FocusScope {
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    alignment: start;
                    Centered {
                        GhostButton {
                            width: 24px;
                            height: 24px;
                            icon: "chevron-left";
                            label: root.copy.back-label;
                            enabled: !root.connection-busy;
                            clicked => { root.close-account-dialogs(); }
                        }
                    }
                    Text {
                        text: root.copy.ics-heading;
                        font-size: 15px;
                        font-weight: Theme.weight-semibold;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.card-line;
                    border-radius: Theme.radius-card;
                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        Text {
                            text: root.copy.ics-field-label;
                            font-size: Theme.type-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.ink2;
                        }
                        url-field := TextField {
                            height: 32px;
                            text <=> root.ics-source-url;
                            placeholder: root.copy.ics-placeholder;
                            enabled: !root.connection-busy && !root.provider-loading;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Glyph {
                                y: 2px;
                                name: root.connection-busy ? "info" : (root.connection-message != "" ? "alert" : "lock");
                                size: 12px;
                                color: !root.connection-busy && root.connection-message != "" ? Theme.err : Theme.ink2;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.connection-busy ? root.ics-loading-text
                                    : (root.connection-message != "" ? root.connection-message : root.copy.ics-privacy);
                                font-size: Theme.type-caption;
                                color: !root.connection-busy && root.connection-message != "" ? Theme.err : Theme.ink2;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActButton {
                        label: root.copy.cancel;
                        enabled: !root.connection-busy;
                        clicked => { root.close-account-dialogs(); }
                    }
                    ActButton {
                        kind: "primary";
                        label: root.copy.subscribe;
                        enabled: !root.connection-busy && !root.provider-loading && root.ics-source-url != "";
                        clicked => { root.add-ics-source("", root.ics-source-url); }
                    }
                }
            }
            init => { url-field.focus-input(); }
        }

        // Connected accounts, or the provider chooser as the empty state.
        if !root.signing-in && !root.ics-dialog-open : ScrollView {
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: accounts-col.preferred-height;

            accounts-col := VerticalLayout {
                width: parent.width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: root.account-cards.length == 0 || root.add-account-open ? 12px : 10px;
                padding-bottom: 12px;
                spacing: 8px;
                alignment: start;

                if root.macos : SettingsCard {
                    Row { title: root.copy.windows-title;
                        LinkButton { label: root.mac-texts[6]; clicked => { root.mac-action(3); } }
                        LinkButton { label: root.mac-texts[5]; clicked => { root.mac-action(4); } }
                    }
                }
                if root.connection-message != "" : MessageBox {
                    text: root.connection-message;
                }
                if root.sign-in-cancelled : HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    padding-left: 4px;
                    Centered {
                        Glyph {
                            name: "info";
                            size: 14px;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.copy.cancelled-text;
                        font-size: Theme.type-caption;
                        color: Theme.ink2;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Centered {
                        LinkButton {
                            label: root.copy.try-again;
                            clicked => { root.retry-sign-in(); }
                        }
                    }
                }

                if !root.macos && root.account-cards.length == 0 && !root.add-account-open : LocalCard {
                    visible: !root.macos;
                    data: root.local-card;
                    toggle => { root.toggle-calendar-source("local"); }
                    ok => { root.local-ok(); }
                    show-folder => { root.local-show-folder(); }
                    try-now => { root.local-try-now(); }
                    ask-start-over => { root.local-ask-start-over(); }
                    start-over => { root.local-start-over(); }
                    keep => { root.local-keep(); }
                }
                if root.account-cards.length == 0 || root.add-account-open : VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 6px;
                        padding-left: root.add-account-open && root.account-cards.length > 0 ? 0px : 2px;
                        if root.add-account-open && root.account-cards.length > 0 : Centered {
                            GhostButton {
                                width: 24px;
                                height: 24px;
                                icon: "chevron-left";
                                label: root.copy.back-label;
                                clicked => { root.close-account-dialogs(); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Text {
                                text: root.copy.connect-heading;
                                font-size: 15px;
                                font-weight: Theme.weight-semibold;
                                color: Theme.ink;
                                overflow: elide;
                            }
                            Text {
                                text: root.copy.connect-note;
                                font-size: Theme.type-caption;
                                color: Theme.ink2;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.card-line;
                        border-radius: Theme.radius-card;
                        clip: true;
                        VerticalLayout {
                            padding: 1px;
                            ProviderRow {
                                title: root.copy.google-title;
                                desc: root.copy.google-desc;
                                letter: "G";
                                tile: #3B82C4;
                                enabled: root.add-account-enabled;
                                clicked => { root.choose-google-account(); }
                            }
                            ProviderRow {
                                title: root.copy.outlook-title;
                                desc: root.copy.outlook-desc;
                                letter: "O";
                                tile: #0B6A9E;
                                divider: true;
                                enabled: root.add-account-enabled;
                                clicked => { root.choose-outlook-account(); }
                            }
                            if !root.macos : ProviderRow {
                                title: root.copy.ics-title;
                                desc: root.copy.ics-desc;
                                glyph: "link";
                                tile: #646464;
                                divider: true;
                                enabled: root.add-account-enabled;
                                clicked => { root.choose-ics-account(); }
                            }
                            if !root.macos : ProviderRow {
                                title: root.copy.windows-title;
                                desc: root.copy.windows-desc;
                                glyph: "calendar";
                                tile: #646464;
                                divider: true;
                                enabled: root.add-account-enabled;
                                clicked => { root.toggle-legacy-windows(); }
                            }
                        }
                    }
                }

                if root.account-cards.length > 0 && !root.add-account-open : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.copy.connected-accounts;
                            font-size: Theme.type-caption;
                            font-weight: Theme.weight-semibold;
                            color: Theme.ink2;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ActButton {
                            icon: "plus";
                            label: root.copy.add-account;
                            enabled: root.add-account-enabled;
                            clicked => { root.add-calendar-account(); }
                        }
                    }
                    if !root.macos : LocalCard {
                    data: root.local-card;
                    toggle => { root.toggle-calendar-source("local"); }
                    ok => { root.local-ok(); }
                    show-folder => { root.local-show-folder(); }
                    try-now => { root.local-try-now(); }
                    ask-start-over => { root.local-ask-start-over(); }
                    start-over => { root.local-start-over(); }
                    keep => { root.local-keep(); }
                }
                    for card in root.account-cards : AccountCard {
                        macos: root.macos;
                        card: card;
                        refresh-label: root.copy.refresh-label;
                        more-label: root.copy.more-label;
                        enabled: !root.provider-loading && !root.connection-busy;
                        action(id) => {
                            if (id == "outlook") { root.connect-microsoft(); }
                            if (id == "google") { root.choose-google-account(); }
                            if (id == "windows") { root.open-privacy-settings(); }
                        }
                        refresh(id) => { root.refresh-calendars(); }
                        disconnect(id) => {
                            if (id == "outlook") {
                                root.disconnect-microsoft();
                            } else if (id == "google") {
                                root.disconnect-google();
                            } else if (id == "windows") {
                                root.toggle-legacy-windows();
                            } else {
                                root.remove-calendar-source(id);
                            }
                        }
                        toggle-source(id) => { root.toggle-calendar-source(id); }
                    }
                    if root.copy.no-selection-hint != "" : HorizontalLayout {
                        spacing: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Glyph {
                            y: 1px;
                            name: "info";
                            size: 12px;
                            color: Theme.accent;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.copy.no-selection-hint;
                            font-size: Theme.type-caption;
                            color: Theme.accent;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Glyph {
                            y: 1px;
                            name: "lock";
                            size: 12px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.copy.read-only-note;
                            font-size: Theme.type-caption;
                            color: Theme.ink2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ===== App tab =====
    if root.settings-tab == 2 : app-tab := Rectangle {
        x: 0px;
        y: root.body-top;
        width: parent.width;
        height: root.body-height;

        ScrollView {
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: app-col.preferred-height;

            app-col := VerticalLayout {
                width: parent.width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                alignment: start;

                if root.startup-warning != "" : MessageBox {
                    text: root.startup-warning;
                    dismissible: true;
                    dismiss-label: root.dismiss-label-text;
                    dismissed => { root.dismiss-startup-warning(); }
                }

                SettingsCard {
                    Row {
                        title: root.label-language-text;
                        Centered {
                            // Two columns, top to bottom: Latin-script languages on the
                            // left, Cyrillic and CJK on the right.
                            GridSelect {
                                accessible-label: root.label-language-text;
                                entries: root.language-options;
                                current-index: root.current-language-index;
                                columns: 2;
                                // Fits the longest name, Português (Brasil).
                                select-width: 168px;
                                menu-width: 328px;
                                bounds-width: root.width;
                                show-menu: root.snapshot-open-menu == 2;
                                selected(index) => { root.select-language(root.language-options[index].code); }
                            }
                        }
                    }
                    Row {
                        title: root.label-startup-text;
                        divider: root.startup-status-text == "";
                        Centered {
                            Switch {
                                label: root.label-startup-text;
                                checked: root.start-with-windows;
                                toggled => { root.toggle-start-with-windows(); }
                            }
                        }
                    }
                    if root.startup-status-text != "" : VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 10px;
                        MessageBox {
                            text: root.startup-status-text;
                        }
                    }
                    if root.startup-status-text != "" : Rectangle {
                        height: 1px;
                        Rectangle {
                            x: 12px;
                            width: parent.width - 24px;
                            background: Theme.line;
                        }
                    }
                    Row {
                        title: root.label-shortcut-text;
                        divider: false;
                        Centered {
                            shortcut-field := Rectangle {
                                height: 28px;
                                width: max(64px, keys-row.preferred-width);
                                accessible-role: button;
                                accessible-label: root.label-shortcut-text;

                                ControlFrame {
                                    width: 100%;
                                    height: 100%;
                                    hovered: field-touch.has-hover;
                                    focused: root.recording;
                                }
                                if root.shortcut-has-conflict && !root.recording : Rectangle {
                                    border-radius: Theme.radius-control;
                                    border-width: 1px;
                                    border-color: Theme.err;
                                }
                                field-touch := TouchArea {
                                    clicked => {
                                        root.recording = !root.recording;
                                        if (root.recording) {
                                            recorder.focus();
                                        }
                                    }
                                }
                                keys-row := HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 4px;
                                    spacing: 4px;
                                    alignment: start;
                                    if root.recording : Text {
                                        text: root.copy.shortcut-recording;
                                        font-size: Theme.type-caption;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                    if !root.recording && root.shortcut-keys.length == 0 : Text {
                                        text: root.shortcut-unset-text;
                                        font-size: Theme.type-body;
                                        color: Theme.ink3;
                                        vertical-alignment: center;
                                    }
                                    if !root.recording : HorizontalLayout {
                                        spacing: 4px;
                                        for key in root.shortcut-keys : Centered {
                                            Keycap {
                                                text: key;
                                            }
                                        }
                                    }
                                    if !root.recording && root.shortcut-can-clear : Centered {
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: Theme.radius-key;
                                            background: clear-touch.has-hover ? Theme.hover : transparent;
                                            accessible-role: button;
                                            accessible-label: root.copy.shortcut-clear-label;
                                            Glyph {
                                                x: 5px;
                                                y: 5px;
                                                name: "close";
                                                size: 10px;
                                                weight: 2.5;
                                                color: clear-touch.has-hover ? Theme.ink : Theme.ink2;
                                            }
                                            clear-touch := TouchArea {
                                                clicked => {
                                                    root.recording = false;
                                                    root.clear-shortcut();
                                                }
                                            }
                                        }
                                    }
                                    if root.recording : Rectangle { width: 2px; }
                                }
                                recorder := FocusScope {
                                    width: 0px;
                                    height: 0px;
                                    enabled: root.recording;
                                    // Focus moved elsewhere (a menu opened, another field was
                                    // clicked): stop listening, as a native shortcut field does.
                                    focus-changed-event => {
                                        if (!self.has-focus) {
                                            root.recording = false;
                                        }
                                    }
                                    key-pressed(event) => {
                                        if (!root.recording) {
                                            return reject;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.recording = false;
                                            return accept;
                                        }
                                        if (event.text == Key.Control || event.text == Key.Alt || event.text == Key.Shift
                                            || event.text == Key.Meta || event.text == Key.AltGr
                                            || event.text == Key.ControlR || event.text == Key.ShiftR) {
                                            return accept;
                                        }
                                        if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                                            return accept;
                                        }
                                        root.recording = false;
                                        root.record-shortcut(event.text, event.modifiers.control, event.modifiers.alt,
                                            event.modifiers.shift, event.modifiers.meta);
                                        return accept;
                                    }
                                }
                            }
                        }
                    }
                    if root.shortcut-has-conflict && root.copy.shortcut-error != "" : VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 10px;
                        MessageBox {
                            text: root.copy.shortcut-error;
                        }
                    }
                }

                if root.macos : SettingsCard {
                    Row { title: root.mac-texts[0];
                        LinkButton { label: (root.mac-weekday == 0 ? "✓ " : "") + root.mac-texts[1]; clicked => { root.mac-action(10); } }
                        LinkButton { label: (root.mac-weekday == 1 ? "✓ " : "") + root.mac-texts[2]; clicked => { root.mac-action(11); } }
                        LinkButton { label: (root.mac-weekday == 2 ? "✓ " : "") + root.mac-texts[3]; clicked => { root.mac-action(12); } }
                    }
                    Row { title: root.mac-texts[4]; Switch { checked: root.mac-month; toggled => { root.mac-action(13); } } }
                }
                SettingsCard {
                    Row {
                        title: root.label-tray-palette-text;
                        row-height: 48px;
                        Centered {
                            Track {
                                track-height: 40px;
                                Segment {
                                    segment-height: 36px;
                                    has-preview: true;
                                    preview-mono: false;
                                    preview-day: root.live-day-text;
                                    label: root.palette-colored-text;
                                    on: !root.tray-icon-monochrome;
                                    clicked => {
                                        if (root.tray-icon-monochrome) { root.toggle-tray-icon-monochrome(); }
                                    }
                                }
                                Segment {
                                    segment-height: 36px;
                                    has-preview: true;
                                    preview-mono: true;
                                    preview-day: root.live-day-text;
                                    label: root.palette-monochrome-text;
                                    on: root.tray-icon-monochrome;
                                    clicked => {
                                        if (!root.tray-icon-monochrome) { root.toggle-tray-icon-monochrome(); }
                                    }
                                }
                            }
                        }
                    }
                    Row {
                        title: root.updates-heading-text;
                        divider: false;
                        HorizontalLayout {
                            spacing: 5px;
                            if root.copy.update-kind == 1 : Centered {
                                Glyph {
                                    name: "check";
                                    size: 12px;
                                    weight: 2.5;
                                    color: Theme.accent;
                                }
                            }
                            if root.copy.update-kind == 2 : Centered {
                                Spinner {
                                    size: 12px;
                                }
                            }
                            if root.copy.update-kind == 3 : Centered {
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.accent;
                                }
                            }
                            Text {
                                text: root.copy.update-short;
                                font-size: Theme.type-caption;
                                color: root.copy.update-kind == 3 ? Theme.accent : Theme.ink2;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { width: 5px; }
                        Centered {
                            ActButton {
                                label: root.copy.app-update-button;
                                enabled: root.copy.update-kind != 2 && !root.package-managed-updates;
                                clicked => {
                                    if (root.copy.update-kind == 3) {
                                        root.open-settings(3);
                                    } else {
                                        root.check-updates();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== About =====
    if root.about : Rectangle {
        x: 0px;
        y: root.body-top;
        width: parent.width;
        height: root.body-height;

        ScrollView {
            width: parent.width;
            height: parent.height;
            content-width: self.visible-width;
            content-height: about-col.preferred-height;

            about-col := VerticalLayout {
                width: parent.width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 12px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    padding: 4px;
                    padding-bottom: 2px;
                    spacing: 14px;
                    BrandMark {
                        mark-size: 56px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.app-name-text;
                            font-size: Theme.type-display;
                            font-weight: Theme.weight-semibold;
                            letter-spacing: -0.3px;
                            color: Theme.ink;
                        }
                        Text {
                            text: root.about-version-text + " · " + root.copy.about-tagline;
                            font-size: Theme.type-caption;
                            color: Theme.ink2;
                            overflow: elide;
                        }
                    }
                }

                // Update status: up to date, checking, available, offline or error.
                Rectangle {
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.card-line;
                    border-radius: Theme.radius-card;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: root.update-is-available || root.install-status-text != "" ? 12px : 0px;
                        padding-bottom: root.update-is-available || root.install-status-text != "" ? 12px : 0px;
                        spacing: 10px;
                        HorizontalLayout {
                            min-height: root.update-is-available || root.install-status-text != "" ? 28px : 50px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: root.copy.update-kind == 0 ? 0px : 6px;
                                    alignment: start;
                                    if root.copy.update-kind == 1 : Centered {
                                        Glyph {
                                            name: "check";
                                            size: 12px;
                                            weight: 2.5;
                                            color: Theme.accent;
                                        }
                                    }
                                    if root.copy.update-kind == 2 : Centered {
                                        Spinner {
                                            size: 14px;
                                        }
                                    }
                                    if root.copy.update-kind == 3 : Centered {
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Theme.accent;
                                        }
                                    }
                                    if root.copy.update-kind == 4 : Centered {
                                        Glyph {
                                            name: "wifi-off";
                                            size: 14px;
                                        }
                                    }
                                    if root.copy.update-kind == 5 : Centered {
                                        Glyph {
                                            name: "alert";
                                            size: 14px;
                                            color: Theme.err;
                                        }
                                    }
                                    Text {
                                        text: root.copy.about-status-title;
                                        font-size: Theme.type-body;
                                        font-weight: root.update-is-available ? Theme.weight-semibold : Theme.weight-medium;
                                        color: Theme.ink;
                                        overflow: elide;
                                    }
                                }
                                if !root.update-is-available : Text {
                                    text: root.copy.about-status-note;
                                    font-size: Theme.type-caption;
                                    color: Theme.ink2;
                                    overflow: elide;
                                }
                            }
                            if root.update-is-available : Centered {
                                ActButton {
                                    kind: "primary";
                                    label: root.install-configured ? root.install-update-label : root.copy.view-release;
                                    external: !root.install-configured;
                                    enabled: !root.install-busy && !root.package-managed-updates;
                                    clicked => { root.install-update(); }
                                }
                            }
                            if !root.update-is-available && root.copy.update-kind != 2 : Centered {
                                ActButton {
                                    label: root.copy.check-now;
                                    enabled: !root.package-managed-updates;
                                    clicked => { root.check-updates(); }
                                }
                            }
                        }
                        if root.update-is-available || root.install-status-text != "" : Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }
                        if root.update-is-available || root.install-status-text != "" : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.install-status-text != "" ? root.install-status-text : root.copy.about-status-note;
                                font-size: Theme.type-caption;
                                color: root.install-status-text != "" && !root.install-busy ? Theme.err : Theme.ink2;
                                wrap: word-wrap;
                            }
                            if root.update-is-available && root.install-configured : Centered {
                                LinkButton {
                                    label: root.copy.view-release + " ↗";
                                    clicked => { root.check-updates(); }
                                }
                            }
                        }
                    }
                }

                SettingsCard {
                    LinkRow {
                        title: root.copy.github-title;
                        desc: root.copy.github-desc;
                        clicked => { root.open-external-url("https://github.com/andmetoo/lightcal"); }
                    }
                    LinkRow {
                        title: root.copy.koona-title;
                        desc: root.copy.koona-desc;
                        divider: true;
                        clicked => { root.open-external-url("https://koona.app"); }
                    }
                    LinkRow {
                        title: root.copy.license-title;
                        desc: root.copy.license-desc;
                        divider: true;
                        clicked => { root.open-external-url("https://github.com/andmetoo/lightcal/blob/main/LICENSE"); }
                    }
                    LinkRow {
                        title: root.copy.release-notes-title;
                        desc: root.copy.release-notes-desc;
                        divider: true;
                        clicked => { root.open-external-url("https://github.com/andmetoo/lightcal/releases"); }
                    }
                    LinkRow {
                        title: "♥ " + root.copy.sponsor-monthly-title;
                        desc: root.copy.sponsor-monthly-desc;
                        divider: true;
                        clicked => { root.open-sponsor(false); }
                    }
                    LinkRow {
                        title: "♥ " + root.copy.sponsor-once-title;
                        desc: root.copy.sponsor-once-desc;
                        divider: true;
                        clicked => { root.open-sponsor(true); }
                    }
                }

                SettingsCard {
                    Row {
                        title: root.copy.auto-check-label;
                        Centered {
                            Switch {
                                label: root.copy.auto-check-label;
                                checked: root.auto-check-updates;
                                toggled => { root.toggle-auto-check-updates(); }
                            }
                        }
                    }
                    Row {
                        title: root.auto-install-label;
                        divider: false;
                        Centered {
                            Switch {
                                label: root.auto-install-label;
                                checked: root.auto-install-updates;
                                toggled => { root.toggle-auto-install-updates(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== Footer (36 px) =====
    Rectangle {
        x: 0px;
        y: 323px;
        width: parent.width;
        height: 1px;
        background: Theme.card-line;
    }
    if !root.about : Rectangle {
        x: 0px;
        y: 324px;
        width: parent.width;
        height: 36px;
        LinkButton {
            x: 12px;
            y: (parent.height - self.height) / 2;
            label: root.about-link-text;
            clicked => { root.open-settings(3); }
        }
        SponsorButton {
            x: parent.width - 16px - version-text.width - 8px - self.width;
            y: (parent.height - self.height) / 2;
            label: root.copy.sponsor-label;
            clicked => { root.open-sponsor(false); }
        }
        version-text := Text {
            x: parent.width - 16px - self.width;
            width: self.preferred-width;
            height: parent.height;
            text: root.about-version-text;
            font-size: Theme.type-caption;
            color: Theme.ink3;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.about : Rectangle {
        x: 0px;
        y: 324px;
        width: parent.width;
        height: 36px;
        LinkButton {
            x: 12px;
            y: (parent.height - self.height) / 2;
            label: root.back-to-calendar-text;
            clicked => { root.open-settings(2); }
        }
        SponsorButton {
            x: parent.width - 12px - self.width;
            y: (parent.height - self.height) / 2;
            label: root.copy.sponsor-label;
            clicked => { root.open-sponsor(false); }
        }
    }
}
