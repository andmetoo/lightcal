// Data structures shared between the Rust controller and the Slint views.

// A calendar's color, adjusted in Rust for contrast on each theme
// (event_colors.rs). Views draw it with `Theme.mark()`.
// Size of the day numbers in the calendar grid (Settings › Calendar › Date size).
// Mirrors preferences::DateSize; Theme turns it into grid and window metrics.
export enum CalendarDateSize { standard, large, larger }

export struct MarkColor {
    light: color,
    dark: color,
}

export struct DayCellData {
    day-number: string,
    in-month: bool,
    is-today: bool,
    is-selected: bool,
    is-gray-weekday: bool,
    dot-count: int,
    dot1: MarkColor,
    dot2: MarkColor,
    dot3: MarkColor,
    accessible-label: string,
}

export struct MonthViewData {
    title: string,
    cells: [DayCellData],
}

export struct CalendarSourceItem {
    id: string,
    name: string,
    account: string,
    swatch: MarkColor,
    checked: bool,
    removable: bool,
}

export struct WeekdayChipItem {
    index: int,
    label: string,
    active: bool,
}

// One entry in the language menu: preference code, the language's own name, and the font
// that can draw it (empty for the UI font).
export struct LanguageOption {
    code: string,
    label: string,
    font: string,
}

// One agenda event. `index` addresses the selected day's agenda in Rust.
export struct AgendaEventItem {
    index: int,
    // Stable identity of the occurrence on this day; callbacks pass it back to Rust.
    key: string,
    // "10:00–11:00", or "All day" for all-day events.
    time-label: string,
    title: string,
    calendar-name: string,
    swatch: MarkColor,
    all-day: bool,
    // Past events on today: text at 55 percent opacity, color bar unchanged.
    dimmed: bool,
    // In progress on today: Now badge and a semibold title.
    is-now: bool,
    // "in 3 h 55 min" for the next event on today.
    badge: string,
    // Details: "10:00–11:00 · 1 h", location, "Personal · Google Calendar".
    detail-time: string,
    location: string,
    provider-line: string,
    can-open: bool,
    expanded: bool,
    copied: bool,
}

// One line of all-day chips; Rust wraps chips into lines.
export struct AgendaChipRow {
    chips: [AgendaEventItem],
}

// A run of adjacent shaded weekday columns, drawn as one flat band.
export struct ShadedBand {
    start: int,
    span: int,
}

// One connected account (or Windows/ICS source) on Settings → Accounts.
// `id`: "outlook", "google", "windows", or an "ics:…" source id.
// `notice-kind`: 0 none, 1 quiet line (offline or info), 2 amber attention
// strip with one action.
export struct AccountCardItem {
    id: string,
    title: string,
    initial: string,
    detail: string,
    notice: string,
    notice-kind: int,
    notice-offline: bool,
    action-label: string,
    can-refresh: bool,
    can-disconnect: bool,
    disconnect-label: string,
    empty-text: string,
    sources: [CalendarSourceItem],
}

// Settings and About copy added by the November 2026 refresh (ADR 0011).
export struct SettingsStrings {
    window-title: string,
    close-label: string,
    connected-accounts: string,
    add-account: string,
    read-only-note: string,
    connect-heading: string,
    connect-note: string,
    google-title: string,
    google-desc: string,
    outlook-title: string,
    outlook-desc: string,
    ics-title: string,
    ics-desc: string,
    windows-title: string,
    windows-desc: string,
    signing-title: string,
    signing-note: string,
    open-browser-again: string,
    cancel: string,
    ics-heading: string,
    ics-field-label: string,
    ics-placeholder: string,
    ics-privacy: string,
    subscribe: string,
    refresh-label: string,
    more-label: string,
    back-label: string,
    no-selection-hint: string,
    cancelled-text: string,
    try-again: string,
    shortcut-recording: string,
    shortcut-clear-label: string,
    shortcut-error: string,
    update-short: string,
    // 0 neutral, 1 up to date, 2 checking, 3 available, 4 offline, 5 error.
    update-kind: int,
    app-update-button: string,
    about-tagline: string,
    about-status-title: string,
    about-status-note: string,
    view-release: string,
    check-now: string,
    github-title: string,
    github-desc: string,
    koona-title: string,
    koona-desc: string,
    sponsor-label: string,
    sponsor-monthly-title: string,
    sponsor-monthly-desc: string,
    sponsor-once-title: string,
    sponsor-once-desc: string,
    license-title: string,
    license-desc: string,
    release-notes-title: string,
    release-notes-desc: string,
    auto-check-label: string,
}
