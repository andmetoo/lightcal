// Compact calendar popup, 352 × 432, or 352 × 444 with Larger dates (design/canvas Main, CalendarDetail and
// CalendarDark boards, `.lc` styles). AppWindow forwards its data and callbacks.
//
// Layout: 12 px side and bottom padding; a 44 px header; a 24 px weekday row;
// six 32 px week rows; a hairline; the agenda header; a scrolling agenda.
// Date size (Theme.day-font and friends): Standard 14 px and Large 16 px dates use the
// 32 px rows; Larger 18 px dates use 30 px tiles in 34 px rows and a 444 px popup.

import { Theme, Motion } from "theme.slint";
import { FadeIn, Icon, IconButton, TextButton } from "controls.slint";
import { KoiPond } from "koi.slint";
import { EventEditor, EditorPanel } from "editor.slint";
import { CalendarDateSize, DayCellData, AgendaEventItem, AgendaChipRow, ShadedBand, LocalEditorText } from "types.slint";

// Inline accent action inside the event details (.gb): 24 px, accent 12/500.
component DetailAction inherits Rectangle {
    in property <string> label;
    // A second label that crossfades in place of the first (Copy → Copied, ADR 0016).
    in property <string> alt-label;
    in property <bool> show-alt: false;
    in property <bool> external: false;
    // Delete (.gb.del): error ink.
    in property <bool> danger: false;
    in property <string> accessible-name;
    callback clicked();

    height: 24px;
    width: self.preferred-width;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.press : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name
        : root.show-alt ? root.alt-label : root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;
        // One slot as wide as the longer label, so the swap never shifts the actions.
        Rectangle {
            width: max(main-label.preferred-width, alt-text.preferred-width);
            main-label := Text {
                width: parent.width;
                height: parent.height;
                text: root.label;
                font-size: Theme.type-caption;
                font-weight: Theme.weight-medium;
                color: root.danger ? Theme.err : Theme.accent;
                vertical-alignment: center;
                opacity: root.show-alt ? 0 : 1;
                animate opacity { duration: Motion.fade; easing: ease-in-out; }
            }
            alt-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.alt-label;
                font-size: Theme.type-caption;
                font-weight: Theme.weight-medium;
                color: Theme.accent;
                vertical-alignment: center;
                opacity: root.show-alt ? 1 : 0;
                animate opacity { duration: Motion.fade; easing: ease-in-out; }
            }
        }
        if root.external : VerticalLayout {
            alignment: center;
            Icon {
                name: "external";
                size: 11px;
                weight: 2.25;
                color: Theme.accent;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Event details panel (.det), joined to the row above it.
component EventDetails inherits FadeIn {
    in property <AgendaEventItem> event;
    in property <string> copy-label;
    in property <string> copied-label;
    in property <string> open-label;
    in property <LocalEditorText> local-text;
    // Chips are not joined to the panel, so it is rounded on every corner.
    in property <bool> joined: true;
    callback copy();
    callback open();
    callback edit();
    callback ask-delete();
    callback confirm-delete();
    callback keep();

    // Fades in as it opens (ADR 0016), while the row above squares its corners. Its layout
    // cannot be offset to slide: the panel takes its height from that layout.
    fade-duration: Motion.move;

    background: Theme.chip;
    border-top-left-radius: root.joined ? 0px : 8px;
    border-top-right-radius: root.joined ? 0px : 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    VerticalLayout {
        padding-top: root.joined ? 2px : 6px;
        padding-right: 8px;
        padding-bottom: 6px;
        padding-left: 21px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            min-height: 16px;
            VerticalLayout {
                alignment: center;
                Icon { name: "clock"; size: 12px; color: Theme.ink2; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.event.detail-time;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.event.location != "" : HorizontalLayout {
            spacing: 6px;
            min-height: 16px;
            VerticalLayout {
                alignment: center;
                Icon { name: "pin"; size: 12px; color: Theme.ink2; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.event.location;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.event.note != "" : HorizontalLayout {
            spacing: 6px;
            min-height: 16px;
            VerticalLayout {
                padding-top: 2px;
                alignment: start;
                Icon { name: "note"; size: 12px; color: Theme.ink2; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.event.note;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            height: root.event.is-local ? 16px : 24px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.mark(root.event.swatch);
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.event.provider-line;
                font-size: Theme.type-caption;
                color: Theme.ink2;
                vertical-alignment: center;
                overflow: elide;
            }
            if !root.event.is-local : HorizontalLayout {
                spacing: 2px;
                DetailAction {
                    label: root.copy-label;
                    alt-label: root.copied-label;
                    show-alt: root.event.copied;
                    clicked => { root.copy(); }
                }
                if root.event.can-open : DetailAction {
                    label: root.open-label;
                    external: true;
                    clicked => { root.open(); }
                }
            }
        }
        // Local events: their actions on a line of their own, so three translated labels
        // fit (LocalLanguages board).
        if root.event.is-local && !root.event.confirming : HorizontalLayout {
            height: 24px;
            spacing: 2px;
            alignment: start;
            DetailAction {
                label: root.copy-label;
                alt-label: root.copied-label;
                show-alt: root.event.copied;
                clicked => { root.copy(); }
            }
            if root.event.can-edit : DetailAction {
                label: root.local-text.edit;
                clicked => { root.edit(); }
            }
            if root.event.can-delete : DetailAction {
                label: root.local-text.delete;
                danger: true;
                clicked => { root.ask-delete(); }
            }
        }
        if root.event.is-local && root.event.confirming : HorizontalLayout {
            height: 24px;
            spacing: 6px;
            accessible-role: groupbox;
            accessible-label: root.local-text.delete-question;
            Text {
                horizontal-stretch: 1;
                text: root.local-text.delete-question;
                font-size: Theme.type-caption;
                font-weight: Theme.weight-semibold;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: delete-text.preferred-width + 20px;
                border-radius: 5px;
                background: delete-touch.has-hover ? #B02718 : #C42B1C;
                accessible-role: button;
                accessible-label: root.local-text.delete;
                delete-text := Text {
                    text: root.local-text.delete;
                    font-size: Theme.type-caption;
                    font-weight: Theme.weight-medium;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                delete-touch := TouchArea {
                    clicked => { root.confirm-delete(); }
                }
            }
            DetailAction {
                label: root.local-text.cancel;
                clicked => { root.keep(); }
            }
        }
    }
}

// One timed agenda row (.row): 3×16 bar, 80 px time range, title, badge.
component AgendaRow inherits Rectangle {
    in property <AgendaEventItem> event;
    in property <string> now-label;
    callback clicked();

    height: 30px;
    border-top-left-radius: Theme.radius-control;
    border-top-right-radius: Theme.radius-control;
    border-bottom-left-radius: root.event.expanded ? 0px : Theme.radius-control;
    border-bottom-right-radius: root.event.expanded ? 0px : Theme.radius-control;
    background: root.event.expanded ? Theme.chip : (touch.has-hover ? Theme.hover : transparent);
    animate border-bottom-left-radius, border-bottom-right-radius { duration: Motion.move; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.event.time-label + ", " + root.event.title
        + (root.event.badge != "" ? ", " + root.event.badge : "");
    accessible-expanded: root.event.expanded;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 10px;

        // Past rows dim their text only: a faded bar would lose its contrast.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3px;
                height: 16px;
                border-radius: 1.5px;
                background: Theme.mark(root.event.swatch);
            }
        }
        Text {
            width: 80px;
            opacity: root.event.dimmed ? 0.55 : 1;
            text: root.event.time-label;
            font-size: Theme.type-caption;
            font-weight: Theme.weight-medium;
            color: Theme.ink2;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            opacity: root.event.dimmed ? 0.55 : 1;
            text: root.event.title;
            font-size: Theme.type-body;
            font-weight: root.event.is-now ? Theme.weight-semibold : Theme.weight-regular;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.event.is-now : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: now-text.preferred-width + 12px;
                border-radius: Theme.radius-key;
                background: Theme.accent-soft;
                now-text := Text {
                    text: root.now-label;
                    font-size: Theme.type-small;
                    font-weight: Theme.weight-semibold;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !root.event.is-now && root.event.badge != "" : Text {
            opacity: root.event.dimmed ? 0.55 : 1;
            text: root.event.badge;
            font-size: Theme.type-small;
            font-weight: Theme.weight-medium;
            color: Theme.ink2;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// All-day chip (.chip): 22 px, dot and title.
component AllDayChip inherits Rectangle {
    in property <AgendaEventItem> event;
    callback clicked();

    height: 22px;
    width: min(self.preferred-width, 320px);
    border-radius: Theme.radius-control;
    background: root.event.expanded || touch.has-hover ? Theme.selected : Theme.chip;
    accessible-role: button;
    accessible-label: root.event.time-label + ", " + root.event.title;
    accessible-expanded: root.event.expanded;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.mark(root.event.swatch);
            }
        }
        Text {
            text: root.event.title;
            font-size: Theme.type-caption;
            font-weight: Theme.weight-medium;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component CalendarView inherits Rectangle {
    in property <bool> macos: false;
    // Header
    in property <string> month-name;
    in property <string> year-text;
    // Japanese puts the year first ("2026年 11月").
    in property <bool> year-first: false;
    in property <string> today-button-label;
    // Today is hidden, keeping its space, while today is shown and selected.
    in property <bool> today-hidden: false;
    in property <string> prev-label: "Previous month";
    in property <string> next-label: "Next month";
    in property <string> settings-label: "Settings";
    in property <string> hide-label: "Hide to tray";
    // Grid
    in property <bool> show-week-numbers;
    in property <[ShadedBand]> shaded-bands;
    in property <[string]> weekday-headers;
    in property <[string]> iso-weeks;
    in property <[DayCellData]> cells;
    in property <bool> show-event-dots;
    // Koi swim behind the dates (ADR 0013).
    in property <bool> show-koi: false;
    // Pond time in seconds, advanced by Rust while the popup is on screen.
    in property <float> koi-clock;
    in property <CalendarDateSize> date-size: CalendarDateSize.standard;
    // Keyboard navigation draws the focus ring on the selected day.
    in property <bool> keyboard-nav: false;
    // Hover follow (ADR 0015): Rust springs the highlight toward the reported cell and
    // sets its column and row (in cells) and opacity.
    in property <float> hover-col;
    in property <float> hover-row;
    in property <float> hover-opacity: 0;
    // The cell last reported (row × 7 + column), or −1; Rust resets it for arrow keys.
    in-out property <int> hover-index: -1;
    callback hover-cell(int);
    // Month change fade (ADR 0016): Rust fades the day rows in.
    in property <float> month-fade: 1;
    // Agenda
    in property <string> agenda-title;
    in property <string> agenda-count;
    in property <[AgendaChipRow]> chip-rows;
    in property <AgendaEventItem> expanded-chip;
    in property <bool> has-expanded-chip: false;
    in property <[AgendaEventItem]> agenda-events;
    in property <bool> agenda-empty: false;
    in property <string> empty-text;
    in property <string> next-event-text;
    in property <string> now-label;
    in property <string> copy-label;
    in property <string> copied-label;
    in property <string> open-label;
    callback prev-month();
    callback next-month();
    callback open-settings(int);
    // Hides the popup to the notification area, like Escape.
    callback hide-to-tray();
    // True when the change being shown was made while the popup was on screen; Rust sets
    // it with the header data, so a popup that opens shows the header already settled.
    in property <bool> header-motion: false;
    callback return-to-today();
    callback select-cell(int);
    callback toggle-event(string);
    callback copy-event(string);
    callback open-event(string);
    callback go-next-event();

    // ---------- Local events (ADR 0017) ----------
    in property <LocalEditorText> local-text;
    // The editor replaces the agenda; the panel replaces it when events cannot be added.
    in property <bool> editor-open: false;
    in property <bool> editor-editing: false;
    in-out property <string> editor-title;
    in-out property <bool> editor-all-day;
    in-out property <string> editor-start;
    in-out property <string> editor-end;
    in-out property <string> editor-location;
    in-out property <string> editor-note;
    in property <string> editor-title-error;
    in property <string> editor-time-error;
    in property <bool> editor-start-invalid: false;
    in property <string> editor-limit-error;
    in property <string> editor-date;
    in property <bool> panel-open: false;
    in property <string> panel-title;
    in property <string> panel-message;
    in property <bool> panel-warn: false;
    in property <bool> panel-accounts: false;
    // Amber or red strip at the top of the agenda (over the limits, restored, unavailable).
    in property <string> strip-text;
    in property <bool> strip-error: false;
    in property <string> strip-action;
    callback new-event();
    callback new-event-on(int);
    callback save-editor();
    callback cancel-editor();
    callback toggle-editor-all-day();
    callback edit-event(string);
    callback ask-delete-event(string);
    callback confirm-delete-event(string);
    callback keep-event(string);
    callback strip-action-clicked();
    callback panel-open-accounts();
    callback panel-back();

    // The event just expanded by a click: only its details fade in. Rust sets it for one
    // sync, so details shown again later appear at once (ADR 0016).
    in property <string> fade-details-key;
    // The details of this event faded in, so Rust stops naming it.
    callback details-faded(string);
    // The pointer moved over the days while keyboard navigation showed its ring: mouse
    // input ends keyboard mode, so the ring and the hover highlight never overlap.
    callback pointer-took-over();

    // Wheel travel since the last month step (one notch is 60 px in Slint's winit backend).
    property <length> wheel-travel: 0px;
    property <length> content-x: 12px;
    property <length> content-width: root.width - 24px;
    property <length> day-font: Theme.day-font(root.date-size);
    property <length> tile-height: Theme.day-tile-height(root.date-size);
    property <length> row-height: Theme.week-row-height(root.date-size);
    // Centre of a plain (not Today) day number within its row; see the pill below.
    property <length> number-center-in-row: (root.row-height - root.tile-height) / 2
        + root.tile-height - 6px - 3px - root.day-font / 2;

    // Cells report entering and leaving in either order; only a change is passed on.
    function report-hover(index: int) {
        if (root.hover-index != index) {
            root.hover-index = index;
            root.hover-cell(index);
        }
    }

    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.card-line;
    background: Theme.popup;
    clip: true;

    // ---------- Header (44 px) ----------
    HorizontalLayout {
        x: root.content-x;
        y: 0px;
        width: root.content-width;
        height: Theme.header-height;
        padding-left: 4px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: start;
            if root.year-first : Text {
                text: root.year-text;
                font-size: Theme.type-title;
                font-weight: Theme.weight-regular;
                letter-spacing: -0.2px;
                color: Theme.ink2;
                vertical-alignment: center;
            }
            Text {
                text: root.month-name;
                font-size: Theme.type-title;
                font-weight: Theme.weight-semibold;
                letter-spacing: -0.2px;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            if !root.year-first : Text {
                text: root.year-text;
                font-size: Theme.type-title;
                font-weight: Theme.weight-regular;
                letter-spacing: -0.2px;
                color: Theme.ink2;
                vertical-alignment: center;
            }
        }

        IconButton {
            icon: "chevron-left";
            label: root.prev-label;
            clicked => { root.prev-month(); }
        }
        // On the current day the arrows sit together; leaving it slides them apart and
        // fades Today in between.
        today-slot := Rectangle {
            width: root.today-hidden ? 0px : today-button.preferred-width;
            opacity: root.today-hidden ? 0 : 1;
            clip: true;
            animate width, opacity {
                duration: root.header-motion ? 180ms : 0ms;
                easing: ease-in-out;
            }

            today-button := TextButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                label: root.today-button-label;
                visible: today-slot.width > 0px;
                enabled: !root.today-hidden;
                clicked => { root.return-to-today(); }
            }
        }
        IconButton {
            icon: "chevron-right";
            label: root.next-label;
            clicked => { root.next-month(); }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 16px;
                    background: Theme.popup-line;
                }
            }
        }
        IconButton {
            icon: "gear";
            icon-weight: 1.75;
            label: root.settings-label;
            clicked => { root.open-settings(0); }
        }
        if !root.macos : IconButton {
            icon: "minimize";
            label: root.hide-label;
            clicked => { root.hide-to-tray(); }
        }
    }

    // ---------- Weekday row and grid (24 + 6 × row-height) ----------
    grid := TouchArea {
        x: root.content-x;
        y: Theme.header-height;
        width: root.content-width;
        height: 24px + 6 * root.row-height;

        property <length> lead: root.show-week-numbers ? 24px : 0px;
        property <length> col-width: (self.width - self.lead) / 7;

        scroll-event(event) => {
            if (event.delta-y == 0) {
                return reject;
            }
            if ((root.wheel-travel > 0 && event.delta-y < 0) || (root.wheel-travel < 0 && event.delta-y > 0)) {
                root.wheel-travel = 0px;
            }
            root.wheel-travel += event.delta-y;
            if (root.wheel-travel >= 50px) {
                root.wheel-travel = 0px;
                root.prev-month();
            } else if (root.wheel-travel <= -50px) {
                root.wheel-travel = 0px;
                root.next-month();
            }
            accept
        }

        // Flat shaded-weekday bands behind whole columns (.band).
        for band in root.shaded-bands : Rectangle {
            x: grid.lead + band.start * grid.col-width;
            y: 0px;
            width: band.span * grid.col-width;
            height: grid.height;
            border-radius: Theme.radius-day;
            background: Theme.weekend-band;
        }

        // Over the bands, under the weekday letters and dates.
        if root.show-koi : KoiPond {
            clock: root.koi-clock;
            width: grid.width;
            height: grid.height;
        }

        for wd[col] in root.weekday-headers : Text {
            x: grid.lead + col * grid.col-width;
            y: 0px;
            width: grid.col-width;
            height: 24px;
            text: wd;
            font-size: Theme.type-small;
            font-weight: Theme.weight-medium;
            color: Theme.ink3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // One hover highlight for the whole grid, under the selected day, Today and the
        // numbers, so it slides beneath them.
        if root.hover-opacity > 0 : Rectangle {
            x: grid.lead + root.hover-col * grid.col-width + (grid.col-width - 34px) / 2;
            y: 24px + root.hover-row * root.row-height + (root.row-height - root.tile-height) / 2;
            width: 34px;
            height: root.tile-height;
            border-radius: Theme.radius-day;
            background: Theme.hover;
            opacity: root.hover-opacity;
        }

        for row in [0, 1, 2, 3, 4, 5] : Rectangle {
            x: 0px;
            opacity: root.month-fade;
            y: 24px + row * root.row-height;
            width: grid.width;
            height: root.row-height;

            // Week numbers sit 2 px below the day-number centre, as on the Standard board.
            if root.show-week-numbers : Text {
                x: 0px;
                y: root.number-center-in-row + 2px - 8px;
                width: 24px;
                height: 16px;
                text: root.iso-weeks[row];
                font-size: Theme.type-tiny;
                font-weight: Theme.weight-medium;
                color: Theme.ink3;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }

            for col in [0, 1, 2, 3, 4, 5, 6] : pill := Rectangle {
                property <int> index: row * 7 + col;
                property <DayCellData> cell: root.cells[self.index];
                property <bool> dots: root.show-event-dots && self.cell.in-month && self.cell.dot-count > 0;
                // Dots sit 2 px above the tile bottom (1 px on Today); the number keeps the same
                // gap above them at every date size.
                property <length> dots-y: self.height - (self.cell.is-today ? 5px : 6px);
                property <length> number-center: self.dots-y - (self.cell.is-today ? 2.5px : 3px) - root.day-font / 2;

                x: grid.lead + col * grid.col-width + (grid.col-width - 34px) / 2;
                y: (root.row-height - root.tile-height) / 2;
                width: 34px;
                height: root.tile-height;
                accessible-role: button;
                accessible-label: self.cell.accessible-label;
                accessible-action-default => { root.select-cell(pill.index); }

                // Keyboard focus: 2 px accent ring with a 2 px gap.
                if root.keyboard-nav && pill.cell.is-selected : Rectangle {
                    x: -4px;
                    y: -4px;
                    width: parent.width + 8px;
                    height: parent.height + 8px;
                    border-radius: Theme.radius-day + 4px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    background: Theme.popup;
                }
                // Selected today: a 16 × 2 px coral underline in the 4 px gap below the tile
                // (ADR 0016).
                if !root.keyboard-nav && pill.cell.is-today && pill.cell.is-selected : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height + 1px;
                    width: 16px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.coral;
                }

                Rectangle {
                    border-radius: Theme.radius-day;
                    background: pill.cell.is-today ? Theme.coral-band
                        : pill.cell.is-selected ? Theme.day-selected
                        : transparent;
                }
                // The day the edited event is on (.d.edit): a 1 px ring.
                if root.editor-open && pill.cell.is-selected && !pill.cell.is-today : Rectangle {
                    border-radius: Theme.radius-day;
                    border-width: 1px;
                    border-color: Theme.toggle-off;
                }
                // Today: coral tile under a 5 px darker band.
                if pill.cell.is-today : Rectangle {
                    y: 5px;
                    height: parent.height - 5px;
                    border-top-left-radius: 1px;
                    border-top-right-radius: 1px;
                    border-bottom-left-radius: Theme.radius-day;
                    border-bottom-right-radius: Theme.radius-day;
                    background: Theme.coral;
                }

                Text {
                    x: 0px;
                    y: pill.number-center - root.day-font / 2 - 1px;
                    width: parent.width;
                    height: root.day-font + 2px;
                    text: pill.cell.day-number;
                    font-size: root.day-font;
                    font-weight: pill.cell.is-today || pill.cell.is-selected ? Theme.weight-semibold
                        : !pill.cell.in-month ? Theme.weight-regular
                        : Theme.weight-medium;
                    color: pill.cell.is-today ? Theme.on-coral
                        : !pill.cell.in-month ? Theme.ink3
                        : Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if pill.dots : HorizontalLayout {
                    x: 0px;
                    y: pill.dots-y;
                    width: parent.width;
                    height: 4px;
                    spacing: 3px;
                    alignment: center;

                    if pill.cell.dot-count >= 1 : Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: pill.cell.is-today ? #FFFFFFD9 : Theme.mark(pill.cell.dot1);
                    }
                    if pill.cell.dot-count >= 2 : Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: pill.cell.is-today ? #FFFFFFD9 : Theme.mark(pill.cell.dot2);
                    }
                    if pill.cell.dot-count >= 3 : Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: pill.cell.is-today ? #FFFFFFD9 : Theme.mark(pill.cell.dot3);
                    }
                }

                // The whole cell, gaps included, so a sweep along a row never leaves the
                // grid between tiles.
                TouchArea {
                    x: -(grid.col-width - pill.width) / 2;
                    y: -pill.y;
                    width: grid.col-width;
                    height: root.row-height;
                    clicked => { root.select-cell(pill.index); }
                    changed has-hover => {
                        if (self.has-hover) {
                            root.report-hover(pill.index);
                        } else if (root.hover-index == pill.index) {
                            root.report-hover(-1);
                        }
                    }
                    // After arrow keys hide the highlight, the next pointer move brings it back.
                    // Real movement, never a hover change alone, also ends keyboard mode.
                    pointer-event(event) => {
                        if (!root.macos && event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            root.new-event-on(pill.index);
                            return;
                        }
                        if (event.kind == PointerEventKind.move) {
                            if (root.keyboard-nav) {
                                root.pointer-took-over();
                            }
                            root.report-hover(pill.index);
                        }
                    }
                }
            }
        }
    }

    // ---------- Agenda ----------
    property <length> agenda-top: Theme.header-height + 24px + 6 * root.row-height + 8px;

    Rectangle {
        x: root.content-x + 4px;
        y: root.agenda-top;
        width: root.content-width - 8px;
        height: 1px;
        background: Theme.popup-line;
    }

    if root.editor-open : EventEditor {
        x: root.content-x;
        y: root.agenda-top + 1px;
        width: root.content-width;
        height: root.height - self.y - 4px;
        text: root.local-text;
        editing: root.editor-editing;
        title <=> root.editor-title;
        all-day <=> root.editor-all-day;
        start <=> root.editor-start;
        end <=> root.editor-end;
        location <=> root.editor-location;
        note <=> root.editor-note;
        title-error: root.editor-title-error;
        time-error: root.editor-time-error;
        start-invalid: root.editor-start-invalid;
        limit-error: root.editor-limit-error;
        date-text: root.editor-date;
        save => { root.save-editor(); }
        cancel => { root.cancel-editor(); }
        toggle-all-day => { root.toggle-editor-all-day(); }
    }

    if root.panel-open && !root.editor-open : EditorPanel {
        x: root.content-x;
        y: root.agenda-top + 1px;
        width: root.content-width;
        height: root.height - self.y - 12px;
        title: root.panel-title;
        message: root.panel-message;
        warn: root.panel-warn;
        show-accounts: root.panel-accounts;
        text: root.local-text;
        open-accounts => { root.panel-open-accounts(); }
        back => { root.panel-back(); }
    }

    if !root.editor-open && !root.panel-open : HorizontalLayout {
        x: root.content-x + 4px;
        y: root.agenda-top + 1px + 6px;
        width: root.content-width - 4px;
        height: 24px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.agenda-title;
            font-size: Theme.type-caption;
            font-weight: Theme.weight-semibold;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.agenda-count;
            font-size: Theme.type-caption;
            font-weight: Theme.weight-medium;
            color: Theme.ink2;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        // New event (.ib.sm): 24 px, a 14 px plus.
        if !root.macos : Rectangle {
            width: 24px;
            border-radius: Theme.radius-control;
            background: plus-touch.pressed ? Theme.press : (plus-touch.has-hover ? Theme.hover : transparent);
            accessible-role: button;
            accessible-label: root.local-text.new-event-key;
            Icon {
                name: "plus";
                size: 14px;
                color: Theme.ink2;
            }
            plus-touch := TouchArea {
                clicked => { root.new-event(); }
            }
        }
    }

    if !root.editor-open && !root.panel-open : agenda := Flickable {
        x: root.content-x;
        y: root.agenda-top + 1px + 10px + 16px + 6px;
        width: root.content-width;
        height: root.height - self.y - 12px;
        content-height: max(self.height, list.preferred-height);
        interactive: list.preferred-height > self.height;

        list := VerticalLayout {
            width: agenda.width;
            alignment: start;

            if root.strip-text != "" : HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-bottom: 6px;
                Rectangle {
                    border-radius: Theme.radius-control;
                    background: root.strip-error ? Theme.err-bg : Theme.warn-bg;
                    accessible-role: text;
                    accessible-label: root.strip-text;
                    HorizontalLayout {
                        padding: 6px;
                        padding-left: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            padding-top: 1px;
                            alignment: start;
                            Icon {
                                name: "warning";
                                size: 14px;
                                color: root.strip-error ? Theme.err : Theme.warn;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.strip-text;
                            font-size: Theme.type-caption;
                            color: root.strip-error ? Theme.err : Theme.warn;
                            wrap: word-wrap;
                        }
                        if root.strip-action != "" : VerticalLayout {
                            alignment: start;
                            Rectangle {
                                height: 16px;
                                width: action-text.preferred-width + 4px;
                                accessible-role: button;
                                accessible-label: root.strip-action;
                                action-text := Text {
                                    text: root.strip-action;
                                    font-size: Theme.type-caption;
                                    font-weight: Theme.weight-medium;
                                    color: root.strip-error ? Theme.err : Theme.warn;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: 2px;
                                    y: parent.height - 2px;
                                    width: parent.width - 4px;
                                    height: 1px;
                                    background: action-text.color;
                                }
                                TouchArea {
                                    clicked => { root.strip-action-clicked(); }
                                }
                            }
                        }
                    }
                }
            }

            if root.chip-rows.length > 0 : VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-bottom: 6px;
                spacing: 6px;
                for chip-row in root.chip-rows : HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for chip in chip-row.chips : AllDayChip {
                        event: chip;
                        clicked => { root.toggle-event(chip.key); }
                    }
                }
            }
            if root.has-expanded-chip : VerticalLayout {
                padding-bottom: 6px;
                EventDetails {
                    fade-on-create: root.expanded-chip.key == root.fade-details-key;
                    init => {
                        if (self.fade-on-create) {
                            root.details-faded(root.expanded-chip.key);
                        }
                    }
                    // One panel serves every chip: it fades again when another chip opens.
                    fade-key: root.expanded-chip.key;
                    fade-on-change: root.expanded-chip.key == root.fade-details-key;
                    event: root.expanded-chip;
                    joined: false;
                    copy-label: root.copy-label;
                    copied-label: root.copied-label;
                    open-label: root.open-label;
                    local-text: root.local-text;
                    copy => { root.copy-event(root.expanded-chip.key); }
                    open => { root.open-event(root.expanded-chip.key); }
                    edit => { root.edit-event(root.expanded-chip.key); }
                    ask-delete => { root.ask-delete-event(root.expanded-chip.key); }
                    confirm-delete => { root.confirm-delete-event(root.expanded-chip.key); }
                    keep => { root.keep-event(root.expanded-chip.key); }
                }
            }

            for ev in root.agenda-events : VerticalLayout {
                padding-bottom: ev.expanded ? 6px : 0px;
                AgendaRow {
                    event: ev;
                    now-label: root.now-label;
                    clicked => { root.toggle-event(ev.key); }
                }
                if ev.expanded : EventDetails {
                    fade-on-create: ev.key == root.fade-details-key;
                    init => {
                        if (self.fade-on-create) {
                            root.details-faded(ev.key);
                        }
                    }
                    event: ev;
                    copy-label: root.copy-label;
                    copied-label: root.copied-label;
                    open-label: root.open-label;
                    local-text: root.local-text;
                    copy => { root.copy-event(ev.key); }
                    open => { root.open-event(ev.key); }
                    edit => { root.edit-event(ev.key); }
                    ask-delete => { root.ask-delete-event(ev.key); }
                    confirm-delete => { root.confirm-delete-event(ev.key); }
                    keep => { root.keep-event(ev.key); }
                }
            }

            if root.agenda-empty : VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    Text {
                        text: root.empty-text;
                        font-size: Theme.type-body;
                        color: Theme.ink2;
                        vertical-alignment: center;
                    }
                }
                if !root.macos : HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 26px;
                        width: add-row.preferred-width + 8px;
                        border-radius: Theme.radius-control;
                        background: add-touch.pressed ? Theme.press : (add-touch.has-hover ? Theme.hover : transparent);
                        accessible-role: button;
                        accessible-label: root.local-text.add-event;
                        add-row := HorizontalLayout {
                            x: 4px;
                            spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Icon { name: "plus"; size: 12px; weight: 2.25; color: Theme.accent; }
                            }
                            Text {
                                text: root.local-text.add-event;
                                font-size: Theme.type-caption;
                                font-weight: Theme.weight-medium;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                        add-touch := TouchArea {
                            clicked => { root.new-event(); }
                        }
                    }
                }
                if root.next-event-text != "" : HorizontalLayout {
                    alignment: start;
                    next-link := Rectangle {
                        height: 26px;
                        width: next-label.preferred-width + 8px;
                        border-radius: Theme.radius-control;
                        background: next-touch.pressed ? Theme.press : (next-touch.has-hover ? Theme.hover : transparent);
                        accessible-role: button;
                        accessible-label: root.next-event-text;
                        next-label := Text {
                            x: 4px;
                            width: min(self.preferred-width, agenda.width - 8px);
                            text: root.next-event-text;
                            font-size: Theme.type-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.accent;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        next-touch := TouchArea {
                            clicked => { root.go-next-event(); }
                        }
                    }
                }
            }
        }
    }
}
