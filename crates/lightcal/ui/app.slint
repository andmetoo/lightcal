    in property <string> appearance-subtitle-text: "Theme, gray weekdays, event dots, and the tray icon.";
    in property <string> calendars-subtitle-text: "Read-only Outlook and private ICS links. Checked calendars show event dots.";
    in property <string> about-subtitle-text: "Version status, release channel, and automatic update preferences.";
    in property <string> label-language-text: "Language";
    in property <string> desc-language-text: "Interface language for month names, weekdays, and controls";
    in property <string> label-first-weekday-text: "Start of week";
    in property <string> desc-first-weekday-text: "First column shown in the calendar grid";
    in property <string> label-show-week-numbers-text: "Show week numbers";
    in property <string> desc-show-week-numbers-text: "Display ISO week numbers (W01–W52) along the left margin";
    in property <string> label-startup-text: "Launch at login";
    in property <string> desc-startup-text: "Start Lightcal quietly in the system tray when you sign in";
    in property <string> label-shortcut-text: "Global shortcut";
    in property <string> desc-shortcut-text: "Toggle the calendar popover from anywhere on the desktop";
    in property <string> label-theme-text: "Theme";
    in property <string> desc-theme-text: "Choose Alabaster Light, Obsidian Dark, or follow system appearance";
    in property <string> label-gray-weekdays-text: "Gray days of week";
    in property <string> desc-gray-weekdays-text: "Tint non-working weekday columns with a soft vertical band";
    in property <string> label-highlight-current-month-text: "Highlight current month";
    in property <string> desc-highlight-current-month-text: "Show the current-month indicator";
    in property <string> label-show-event-dots-text: "Show event dots on dates";
    in property <string> desc-show-event-dots-text: "Render up to 3 semantic color dots beneath days with scheduled events";
    in property <string> label-tray-mode-text: "Tray / Status Bar icon mode";
    in property <string> desc-tray-mode-text: "Date, weekday and date, or time. This changes Lightcal's icon only.";
    in property <string> label-tray-palette-text: "Tray / Status Bar icon palette";
    in property <string> desc-tray-palette-text: "Colored Coral (#E5484D) cap or native OS Monochrome";
    in property <string> palette-colored-text: "Colored (#E5484D)";
    in property <string> palette-monochrome-text: "Monochrome";
    in property <string> provider-heading-text: "Windows Calendar Store";
    in property <string> provider-error-text;
    in-out property <string> ics-source-name;
    in-out property <string> ics-source-url;
    in property <bool> connection-busy;
    in property <bool> provider-loading;
    in property <string> account-status-text;
    in property <bool> account-connected;
    in property <bool> account-needs-signin: false;
    in property <bool> sign-in-cancelled: false;
    in property <bool> add-account-open: false;
    in property <bool> ics-dialog-open: false;
    in property <string> add-account-title: "Add an account";
    in property <string> add-account-intro: "Choose a read-only source.";
    in property <string> google-account-label: "Google Calendar";
    in property <string> google-account-desc: "Connect using your Google account.";
    in property <string> outlook-account-desc: "Work, school, or a personal account.";
    in property <string> ics-account-label: "Private ICS link";
    in property <string> ics-account-desc: "Subscribe using a calendar address.";
    in property <string> waiting-browser-text: "Waiting for browser…";
    in property <string> cancel-sign-in-label: "Cancel";
    in property <string> try-again-label: "Try again";
    in property <string> sign-in-cancelled-text: "Sign-in cancelled. Your accounts are unchanged.";
    in property <string> events-stale-text: "Events may be out of date.";
    in property <string> reconnect-label: "Reconnect";
    in property <string> no-calendars-text: "No calendars found for this account.";
    in property <string> ics-dialog-title: "Add a calendar link";
    in property <string> ics-privacy-text: "Anyone with the address can read this calendar.";
    in property <string> ics-stays-local-text: "Stays on this computer.";
    in property <string> subscribe-label: "Subscribe";
    in property <string> ics-loading-text: "Checking calendar…";
    in property <string> google-unavailable-text: "Google sign-in is not configured in this build.";
    in property <string> google-status-text;
    in property <string> ics-status-text;
    in property <bool> google-connected: false;
    in property <bool> google-needs-signin: false;
    in property <string> disconnect-google-label: "Disconnect Google";
    in property <string> sign-in-title: "Outlook";
    in property <bool> add-account-enabled: true;
    in property <[CalendarSourceItem]> outlook-sources: [];
    in property <[CalendarSourceItem]> google-sources: [];
    in property <[CalendarSourceItem]> ics-sources: [];
    in property <[CalendarSourceItem]> windows-sources: [];
    in property <bool> can-connect-microsoft;
    in property <bool> can-disconnect-microsoft;
    in property <bool> can-refresh-calendars;
    in property <string> connection-message;
    in property <string> startup-warning: "";
    in property <string> dismiss-label-text: "Dismiss";
    in property <string> connect-microsoft-label;
    in property <string> disconnect-microsoft-label;
    in property <string> ics-name-placeholder;
    in property <string> ics-url-placeholder;
    in property <string> add-ics-label;
    in property <string> remove-source-label;
    in property <string> legacy-windows-label;
    in property <bool> legacy-windows-enabled;
    in property <string> install-update-label;
    in property <string> auto-install-label;
    in property <bool> auto-install-updates;
    in property <bool> package-managed-updates;
    in property <bool> install-busy: false;
    in property <string> install-status-text;
    in property <string> refresh-button-text: "Refresh";
    in property <string> updates-heading-text: "Updates";
    in property <string> about-link-text: "About Lightcal";
    in property <string> app-name-text: "Lightcal";
    in property <string> about-version-text: "Version 0.3.0";
    in property <string> provider-readonly-tag-text: "Read-only";
    in property <string> shortcut-unset-text: "Not set";
    in property <string> license-short-text: "GPL-3.0-only";
    in property <string> updates-check-button-text: "Check for updates";
    in property <string> updates-open-release-button-text: "Open release page ↗";
    in property <string> current-language-code: "en";
    in property <string> current-language-display: "English (US)";
    in property <string> current-theme-code: "system";
    in property <string> current-theme-display: "Dark (Obsidian)";
    in property <string> current-first-weekday-display: "Monday";
