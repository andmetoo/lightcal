    in property <string> shortcut-record-label: "Record…";
    in property <string> shortcut-change-label: "Change";
    in property <string> shortcut-conflict-line: "Used by another app";
    in property <string> shortcut-clear-label: "Clear";
    in property <bool> shortcut-can-clear: false;
    in property <string> section-region-text: "Region";
    in property <string> section-startup-text: "Startup";
    in property <string> desc-auto-install-text: "Install the signed release and restart after a successful check.";
    in property <string> lang-en-us-label: "English (US)";
    in property <string> lang-ru-label: "Русский";
    in property <string> lang-es-label: "Español";
    in property <string> lang-ja-label: "日本語";
    in property <string> weekday-monday-label: "Monday";
    in property <string> weekday-sunday-label: "Sunday";
    in property <string> theme-light-label: "Light (Alabaster)";
    in property <string> theme-dark-label: "Dark (Obsidian)";
    in property <string> theme-system-label: "System default";
    in property <string> channel-stable-label: "Stable";
    in property <string> channel-preview-label: "Preview";
    in property <bool> update-channel-is-preview: false;
    in property <string> github-button-text: "GitHub ↗";
    in property <string> koona-button-text: "koona.app ↗";
    in property <string> startup-status-text: "";
    in property <string> outlook-section-text: "Outlook";
    in property <string> ics-section-text: "Private calendar link";
    in property <string> ics-help-text: "";
    in property <string> calendars-dot-note-text: "Only checked calendars show event dots.";
    in property <bool> calendars-access-denied: false;
    in property <string> calendars-denied-title-text: "Calendar access is turned off in System Privacy Settings";
    in property <string> calendars-denied-desc-text: "Lightcal needs permission to read calendar events. The month view still works without them.";
    in property <string> open-privacy-settings-label: "Open Privacy Settings";
    in property <string> retry-sync-label: "Retry Sync";
    in property <bool> calendars-is-empty: false;
    in property <string> calendars-empty-title-text: "No calendar accounts connected yet";
    in property <string> calendars-empty-desc-text: "Nothing is connected yet. Add Outlook or a private ICS link, then choose which calendars to show.";
    in property <string> add-calendar-account-label: "+ Add Calendar Account";
    in property <string> active-calendars-count-label: "ACTIVE CALENDARS (3)";
    in property <string> add-calendar-label: "+ Add Calendar";
    in property <bool> update-is-checking: false;
    in property <string> checking-updates-label: "Checking updates…";
    in property <string> update-available-badge-text: "Update available";
    in property <string> update-ready-title-text: "A newer version is available";
    in property <string> update-ready-notes-text: "Open the release page to review it. You choose when to install.";
    in property <string> release-notes-button-text: "Release notes";
    in property <bool> auto-check-updates: false;
    in property <string> label-auto-updates-text: "Automatic updates";
    in property <string> desc-auto-updates-text: "Download and verify signed releases in the background";
    in property <string> label-update-channel-text: "Update channel";
    in property <string> desc-update-channel-text: "Receive verified stable releases or preview builds";
    in property <string> label-license-source-text: "License & source";
    in property <string> desc-license-source-text: "GPL-3.0-only · Built with Rust, Slint, and zero webview bloat";
    in property <string> app-version-line-text: "Lightcal · Rust + Slint";

    // Callbacks
    callback prev-month();
    callback next-month();
    callback return-to-today();
    callback select-cell(int);
    callback move-selection-by(int);
    callback open-settings(int);
    callback close-settings();
    callback select-language(string);
    callback select-theme(string);
    callback select-tray-icon-mode(string);
    callback toggle-tray-icon-monochrome();
    callback toggle-first-weekday();
    callback toggle-gray-weekday(int);
    callback toggle-show-weekday();
    callback toggle-show-week-numbers();
    callback toggle-start-with-windows();
    callback cycle-shortcut-preset();
    callback clear-shortcut();
    callback toggle-calendar-source(string);
    callback refresh-calendars();
    callback connect-microsoft();
    callback disconnect-microsoft();
    callback add-ics-source(string,string);
    callback remove-calendar-source(string);
    callback toggle-legacy-windows();
    callback install-update();
    callback toggle-auto-install-updates();
    callback check-updates();
    callback open-external-url(string);
    callback dismiss-compact();
    callback toggle-language-dropdown();
    callback toggle-theme-dropdown();
    callback toggle-first-day-dropdown();
    callback toggle-update-channel-dropdown();
    callback select-first-weekday-option(bool);
    callback select-update-channel(string);
    callback toggle-highlight-current-month();
    callback toggle-show-event-dots();
    callback toggle-auto-check-updates();
    callback reset-shortcut();
    callback open-privacy-settings();
    callback retry-calendar-sync();
    callback add-calendar-account();
    callback close-account-dialogs();
    callback choose-outlook-account();
    callback choose-google-account();
    callback choose-ics-account();
    callback cancel-account-sign-in();
    callback disconnect-google();
    callback retry-sign-in();
    callback dismiss-startup-warning();
    callback minimize-window();

    width: root.settings-open ? 448px : 352px;
    height: root.settings-open ? 360px : 432px;
    preferred-width: root.settings-open ? 448px : 352px;
    preferred-height: root.settings-open ? 360px : 432px;
    background: transparent;


    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.ics-dialog-open || root.add-account-open) {
                if (event.text == Key.Escape) {
                    root.close-account-dialogs();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.settings-open) {
                    root.close-settings();
                } else {
                    root.dismiss-compact();
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.calendar-keyboard-nav = !root.settings-open;
                root.move-selection-by(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.calendar-keyboard-nav = !root.settings-open;
                root.move-selection-by(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.calendar-keyboard-nav = !root.settings-open;
                root.move-selection-by(-7);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.calendar-keyboard-nav = !root.settings-open;
                root.move-selection-by(7);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.prev-month();
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.next-month();
                return accept;
            }
            return reject;
        }
    }

    public function focus-calendar-keys() {
        if (!root.ics-dialog-open && !root.add-account-open) {
            key-handler.focus();
        }
    }

    // ==================== CALENDAR VIEW (352×432) ====================
    if !root.settings-open : CalendarView {
        width: 100%;
        height: 100%;
        month-name: root.month-name-text;
        year-text: root.year-text;
        year-first: root.year-first;
        today-button-label: root.today-button-label;
        today-hidden: root.today-hidden;
        prev-label: root.prev-month-label;
        next-label: root.next-month-label;
        settings-label: root.settings-title-text;
        show-week-numbers: root.show-week-numbers;
        shaded-bands: root.shaded-bands;
        weekday-headers: root.weekday-headers;
        iso-weeks: root.iso-weeks;
        cells: root.cells;
        show-event-dots: root.show-event-dots;
        keyboard-nav: root.calendar-keyboard-nav;
        agenda-title: root.agenda-title;
        agenda-count: root.agenda-count;
        chip-rows: root.agenda-chip-rows;
        expanded-chip: root.agenda-expanded-chip;
        has-expanded-chip: root.agenda-has-expanded-chip;
        agenda-events: root.agenda-events;
        agenda-empty: root.agenda-empty;
        empty-text: root.agenda-empty-text;
        next-event-text: root.agenda-next-text;
        now-label: root.agenda-now-label;
        copy-label: root.agenda-copy-label;
        copied-label: root.agenda-copied-label;
        open-label: root.agenda-open-label;
        prev-month() => { root.prev-month(); }
        next-month() => { root.next-month(); }
        open-settings(arg0) => { root.open-settings(arg0); }
        return-to-today() => { root.calendar-keyboard-nav = false; root.return-to-today(); }
        select-cell(arg0) => { root.calendar-keyboard-nav = false; root.select-cell(arg0); }
        toggle-event(arg0) => { root.toggle-agenda-event(arg0); }
        copy-event(arg0) => { root.copy-agenda-event(arg0); }
        open-event(arg0) => { root.open-agenda-event(arg0); }
        go-next-event() => { root.calendar-keyboard-nav = false; root.go-next-event(); }
    }

    // ==================== SETTINGS VIEW (448×360) ====================
    if root.settings-open : SettingsView {
        app-name-text: root.app-name-text;
        settings-tab: root.settings-tab;
        nav-about-text: root.nav-about-text;
        settings-title-text: root.settings-title-text;
        nav-appearance-text: root.nav-appearance-text;
        nav-calendars-text: root.nav-calendars-text;
        nav-general-text: root.nav-general-text;
        startup-warning: root.startup-warning;
        dismiss-label-text: root.dismiss-label-text;
        label-theme-text: root.label-theme-text;
        theme-system-label: root.theme-system-label;
        theme-light-label: root.theme-light-label;
        theme-dark-label: root.theme-dark-label;
        label-first-weekday-text: root.label-first-weekday-text;
        current-first-weekday-display: root.current-first-weekday-display;
        first-day-dropdown-open: root.first-day-dropdown-open;
        label-gray-weekdays-text: root.label-gray-weekdays-text;
        gray-weekday-chips: root.gray-weekday-chips;
        label-show-week-numbers-text: root.label-show-week-numbers-text;
        show-week-numbers: root.show-week-numbers;
        label-show-event-dots-text: root.label-show-event-dots-text;
        show-event-dots: root.show-event-dots;
        weekday-monday-label: root.weekday-monday-label;
        first-weekday-monday: root.first-weekday-monday;
        weekday-sunday-label: root.weekday-sunday-label;
        provider-heading-text: root.provider-heading-text;
        add-calendar-account-label: root.add-calendar-account-label;
        add-account-enabled: root.add-account-enabled;
        account-connected: root.account-connected;
        account-needs-signin: root.account-needs-signin;
        outlook-sources: root.outlook-sources;
        can-disconnect-microsoft: root.can-disconnect-microsoft;
        google-connected: root.google-connected;
        google-needs-signin: root.google-needs-signin;
        google-sources: root.google-sources;
        google-status-text: root.google-status-text;
        ics-sources: root.ics-sources;
        windows-sources: root.windows-sources;
        connection-busy: root.connection-busy;
        sign-in-title: root.sign-in-title;
        waiting-browser-text: root.waiting-browser-text;
        cancel-sign-in-label: root.cancel-sign-in-label;
        sign-in-cancelled: root.sign-in-cancelled;
        sign-in-cancelled-text: root.sign-in-cancelled-text;
        try-again-label: root.try-again-label;
        connection-message: root.connection-message;
        outlook-section-text: root.outlook-section-text;
        events-stale-text: root.events-stale-text;
        account-status-text: root.account-status-text;
        reconnect-label: root.reconnect-label;
        provider-readonly-tag-text: root.provider-readonly-tag-text;
        no-calendars-text: root.no-calendars-text;
        remove-source-label: root.remove-source-label;
        disconnect-microsoft-label: root.disconnect-microsoft-label;
        refresh-button-text: root.refresh-button-text;
        can-refresh-calendars: root.can-refresh-calendars;
        provider-loading: root.provider-loading;
        google-account-label: root.google-account-label;
        disconnect-google-label: root.disconnect-google-label;
        ics-section-text: root.ics-section-text;
        ics-status-text: root.ics-status-text;
