// Lightcal — Native Desktop Calendar UI (Slint)
// 2026 Design System: Alabaster & Ink (Light #FFFFFF / #F7F7F8) · Obsidian Graphite (Dark #101012 / #141417)
// Signature Coral-Vermilion (#E5484D) Today tile & icon cap · Linear Indigo (#5E6AD2) selection & active controls

import "../assets/fonts/Inter.ttf";
import { ScrollView } from "std-widgets.slint";

export struct DayCellData {
    day-number: string,
    in-month: bool,
    is-today: bool,
    is-selected: bool,
    is-gray-weekday: bool,
    dot-count: int,
    dot1: color,
    dot2: color,
    dot3: color,
    accessible-label: string,
}

export struct CalendarSourceItem {
    id: string,
    name: string,
    account: string,
    swatch: color,
    checked: bool,
    removable: bool,
}

export struct WeekdayChipItem {
    index: int,
    label: string,
    active: bool,
}

export struct AgendaEventItem {
    time-label: string,
    title: string,
    calendar-name: string,
    swatch: color,
}

component TactileButton inherits Rectangle {
    in property <string> label;
    in property <bool> show-coral-dot: false;
    in property <bool> active: false;
    in property <bool> dark-mode: false;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    background: root.active
        ? (root.dark-mode ? #22253E : #EEF0FF)
        : (touch.has-hover
            ? (root.dark-mode ? #26262B : #EFEFF2)
            : (root.dark-mode ? #1E1E22 : #FFFFFF));
    border-width: 1px;
    border-color: root.active
        ? #5E6AD2
        : (root.dark-mode ? #2C2C32 : #E2E2E6);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        if root.show-coral-dot : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #E5484D;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: (root.active || root.show-coral-dot) ? 600 : 500;
            color: root.active
                ? (root.dark-mode ? #F4F4F6 : #5E6AD2)
                : (root.dark-mode ? #F4F4F6 : #141416);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component IconSquareButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> subtle: false;
    in property <bool> dark-mode: false;
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: root.subtle
        ? (touch.has-hover ? (root.dark-mode ? #26262B : #EFEFF2) : (root.dark-mode ? #18181C : #F2F2F5))
        : (touch.has-hover ? (root.dark-mode ? #26262B : #EFEFF2) : (root.dark-mode ? #1E1E22 : #FFFFFF));
    border-width: 1px;
    border-color: root.subtle
        ? (root.dark-mode ? #1F1F24 : #ECECEF)
        : (root.dark-mode ? #2C2C32 : #E2E2E6);

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-size: root.subtle ? 12px : 13px;
        font-weight: root.subtle ? 500 : 600;
        color: root.dark-mode ? #94949E : #64646C;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SwitchToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> dark-mode: false;
    callback toggled();

    // Soft track and a shadowed knob, closer to a modern system switch than a flat pill.
    width: 46px;
    height: 28px;
    border-radius: 14px;
    background: root.checked
        ? (touch.has-hover ? #6E79D6 : #5E6AD2)
        : (touch.has-hover
            ? (root.dark-mode ? #45454E : #D8D8E0)
            : (root.dark-mode ? #3A3A42 : #E4E4EA));

    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        x: root.checked ? 21px : 3px;
        y: 3px;
        background: #FFFFFF;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #14141633;
        animate x { duration: 160ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component SettingsRowText inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> dark-mode: false;

    horizontal-stretch: 1;
    alignment: center;
    spacing: 3px;

    Text {
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        color: root.dark-mode ? #F4F4F6 : #141416;
        overflow: elide;
    }
    Text {
        text: root.description;
        font-size: 12px;
        color: root.dark-mode ? #94949E : #64646C;
        wrap: word-wrap;
    }
}

component IconPreview inherits Rectangle {
    in property <image> source;
    width: 32px;
    background: transparent;
    Image {
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        source: root.source;
        image-fit: contain;
    }
}

component TrayPaletteSwatch inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> dark-mode: false;
    in property <image> source;

    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: root.selected
        ? (root.dark-mode ? #1D203A : #EEF0FF)
        : transparent;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected
        ? #5E6AD2
        : (root.dark-mode ? #1F1F24 : #ECECEF);

    IconPreview {
        x: 4px;
        y: 4px;
        source: root.source;
    }
}

component SettingsSelect inherits Rectangle {
    in property <string> text;
    in property <bool> is-open: false;
    in property <bool> dark-mode: false;
    in property <length> select-width: 172px;
    callback clicked();

    width: root.select-width;
    height: 36px;
    border-radius: 10px;
    background: touch.has-hover
        ? (root.dark-mode ? #26262B : #EFEFF2)
        : (root.dark-mode ? #1E1E22 : #FFFFFF);
    border-width: root.is-open ? 1.5px : 1px;
    border-color: root.is-open
        ? #5E6AD2
        : (root.dark-mode ? #2C2C32 : #E2E2E6);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: space-between;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.dark-mode ? #F4F4F6 : #141416;
            vertical-alignment: center;
            overflow: elide;
        }

        Path {
            horizontal-stretch: 0;
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            stroke: root.is-open ? #5E6AD2 : (root.dark-mode ? #94949E : #64646C);
            stroke-width: 1.5px;
            MoveTo { x: 0; y: root.is-open ? 4 : 1; }
            LineTo { x: 4; y: root.is-open ? 1 : 4; }
            LineTo { x: 8; y: root.is-open ? 4 : 1; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsButton inherits Rectangle {
    in property <bool> enabled:true;
    opacity: root.enabled ? 1 : 0.4;
    in property <string> label;
    in property <string> kind: "secondary"; // "primary", "secondary", "subtle", "danger"
    in property <bool> dark-mode: false;
    in property <length> button-width: 0px;
    callback clicked();

    width: root.button-width > 0px ? root.button-width : self.preferred-width;
    height: 34px;
    border-radius: 10px;
    background: root.kind == "primary"
        ? (touch.has-hover ? #4E5AC0 : #5E6AD2)
        : (root.kind == "subtle"
            ? (touch.has-hover
                ? (root.dark-mode ? #222228 : #EBEBEF)
                : (root.dark-mode ? #18181C : #F2F2F5))
            : (root.kind == "danger"
                ? (root.dark-mode ? #2A1618 : #FFF0F0)
                : (touch.has-hover
                    ? (root.dark-mode ? #26262B : #EFEFF2)
                    : (root.dark-mode ? #1E1E22 : #FFFFFF))));
    border-width: root.kind == "primary" ? 0px : 1px;
    border-color: root.kind == "danger"
        ? (root.dark-mode ? #F87171 : #E5484D)
        : (root.kind == "subtle"
            ? (root.dark-mode ? #1F1F24 : #ECECEF)
            : (root.dark-mode ? #2C2C32 : #E2E2E6));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: root.kind == "primary"
                ? #FFFFFF
                : (root.kind == "danger"
                    ? (root.dark-mode ? #F87171 : #E5484D)
                    : (root.kind == "subtle"
                        ? (root.dark-mode ? #94949E : #64646C)
                        : (root.dark-mode ? #F4F4F6 : #141416)));
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled:root.enabled;
        clicked => { root.clicked(); }
    }
}

component SettingsModePill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> dark-mode: false;
    callback clicked();

    height: 32px;
    border-radius: 10px;
    background: root.active
        ? (root.dark-mode ? #1D203A : #EEF0FF)
        : (pill-touch.has-hover
            ? (root.dark-mode ? #222228 : #EBEBEF)
            : (root.dark-mode ? #18181C : #F2F2F5));
    border-width: 1px;
    border-color: root.active
        ? #5E6AD2
        : (root.dark-mode ? #2C2C32 : #E4E4EA);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 600 : 500;
            color: root.active
                ? (root.dark-mode ? #F4F4F6 : #141416)
                : (root.dark-mode ? #94949E : #64646C);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    pill-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsDropdownOption inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> dark-mode: false;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    background: root.active
        ? (root.dark-mode ? #1D203A : #EEF0FF)
        : (opt-touch.has-hover ? (root.dark-mode ? #26262B : #F2F2F5) : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.active ? 600 : 500;
            color: root.dark-mode ? #F4F4F6 : #141416;
            vertical-alignment: center;
        }

        if root.active : Text {
            text: "✓";
            font-size: 12px;
            font-weight: 700;
            color: #5E6AD2;
            vertical-alignment: center;
        }
    }

    opt-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark-mode: false;
    in property <bool> enabled: true;

    height: 36px;
    border-radius: 10px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.dark-mode ? #1E1E22 : #FFFFFF;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? #5E6AD2 : (root.dark-mode ? #2C2C32 : #E2E2E6);

    if root.text == "" && root.placeholder != "" : Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        text: root.placeholder;
        font-size: 12px;
        color: root.dark-mode ? #52525B : #A0A0AB;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        text <=> root.text;
        font-size: 12px;
        color: root.dark-mode ? #F4F4F6 : #141416;
        single-line: true;
        enabled: root.enabled;
    }
}

component SettingsMenu inherits Rectangle {
    in property <bool> dark-mode: false;

    horizontal-stretch: 0;
    width: 172px;
    height: content.preferred-height;
    border-radius: 12px;
    background: root.dark-mode ? #1E1E22 : #FFFFFF;
    border-width: 1px;
    border-color: root.dark-mode ? #2C2C32 : #E4E4EA;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: root.dark-mode ? #00000088 : #1414161A;

    content := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

component SettingsMenuRow inherits HorizontalLayout {
    in property <bool> dark-mode: false;

    alignment: end;
    padding-bottom: 8px;

    SettingsMenu {
        dark-mode: root.dark-mode;
        @children
    }
}

component SettingsLine inherits HorizontalLayout {
    min-height: 62px;
    spacing: 16px;
    alignment: space-between;
    @children
}

component SettingsSwitchRow inherits SettingsLine {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    in property <bool> dark-mode: false;
    callback toggled();

    SettingsRowText {
        title: root.title;
        description: root.description;
        dark-mode: root.dark-mode;
    }
    SwitchToggle {
        checked: root.checked;
        dark-mode: root.dark-mode;
        toggled => { root.toggled(); }
    }
}

component SettingsGroup inherits Rectangle {
    in property <bool> dark-mode: false;
    in property <length> pad-top: 2px;
    in property <length> pad-bottom: 2px;

    border-radius: 14px;
    background: root.dark-mode ? #18181C : #F4F4F6;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: root.pad-top;
        padding-bottom: root.pad-bottom;
        @children
    }
}

component SettingsSectionLabel inherits VerticalLayout {
    in property <string> label;
    in property <bool> dark-mode: false;
    in property <bool> first: false;

    padding-top: root.first ? 2px : 14px;
    padding-bottom: 4px;

    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: root.dark-mode ? #52525B : #A0A0AB;
    }
}

export component AppWindow inherits Window {
    title: "Lightcal";
    no-frame: true;
    default-font-family: "Inter, Segoe UI Variable Text, Segoe UI, -apple-system, system-ui, sans-serif";
    in property <image> window-icon;
    icon: root.window-icon;
    in property <bool> dark-mode: true;
    in property <bool> settings-open: false;
    in property <int> settings-tab: 0; // 0=General, 1=Appearance, 2=Calendars, 3=About

    // Calendar Header & Grid Properties
    in property <string> month-title: "October 2026";
    in property <bool> is-current-month: true;
    in property <string> current-month-badge: "Current month";
    in property <string> today-date-line: "Thursday, 29 October";
    in property <string> today-button-label: "Today";
    in property <string> week-header-label: "W";
    in property <bool> show-week-numbers: true;
    in property <bool> show-weekday-header: true;
    in property <[string]> weekday-headers: ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
    in property <[bool]> gray-columns: [false, false, false, false, false, true, true];
    in property <[string]> iso-weeks: ["40", "41", "42", "43", "44", "45"];
    in property <[DayCellData]> cells: [];
    in property <string> selected-date-line: "Friday, 30 October";
    in property <string> selected-event-summary: "2 events";
    in property <string> active-calendars-label: "2 calendars";
    in property <[AgendaEventItem]> selected-day-events: [];
    in property <string> back-to-calendar-text: "← Back to Calendar";
