// Lightcal — Native Desktop Calendar UI (Slint)
// October 31 2026 Penpot Windows design · Onest · Calendar 352×432 · Settings 448×360

import "../assets/fonts/Onest-Regular.ttf";
import "../assets/fonts/Onest-Medium.ttf";
import "../assets/fonts/Onest-SemiBold.ttf";
import "../assets/fonts/Onest-Bold.ttf";
import { ScrollView } from "std-widgets.slint";

export struct DayCellData {
    day-number: string,
    in-month: bool,
    is-today: bool,
    is-selected: bool,
    is-gray-weekday: bool,
    dot-count: int,
    dot1: color,
    dot2: color,
    dot3: color,
    accessible-label: string,
}

export struct CalendarSourceItem {
    id: string,
    name: string,
    account: string,
    swatch: color,
    checked: bool,
    removable: bool,
}

export struct WeekdayChipItem {
    index: int,
    label: string,
    active: bool,
}

export struct AgendaEventItem {
    time-label: string,
    title: string,
    calendar-name: string,
    swatch: color,
}

component IconSquareButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> filled: false;
    in property <bool> dark-mode: false;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: root.filled
        ? (touch.has-hover
            ? (root.dark-mode ? #2A2A2A : #E8E8E8)
            : (root.dark-mode ? #222222 : #F0F0F0))
        : (touch.has-hover
            ? (root.dark-mode ? #2A2A2A : #F0F0F0)
            : transparent);
    border-width: 0px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-size: 14px;
        font-weight: 500;
        color: root.dark-mode ? #B4B4B4 : #646464;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SwitchToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> dark-mode: false;
    callback toggled();

    width: 36px;
    height: 22px;
    border-radius: 11px;
    background: root.checked
        ? #00796B
        : (root.dark-mode ? #606060 : #BBBBBB);

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        x: root.checked ? 17px : 3px;
        y: 3px;
        background: #FFFFFF;
        animate x { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component SettingsSelect inherits Rectangle {
    in property <string> text;
    in property <bool> is-open: false;
    in property <bool> dark-mode: false;
    in property <length> select-width: 136px;
    callback clicked();

    width: root.select-width;
    height: 28px;
    border-radius: 7px;
    background: touch.has-hover
        ? (root.dark-mode ? #2A2A2A : #FFFFFF)
        : (root.dark-mode ? #2A2A2A : #FFFFFF);
    border-width: root.is-open ? 1.5px : 1px;
    border-color: root.is-open
        ? (root.dark-mode ? #53B9AB : #00796B)
        : (root.dark-mode ? #606060 : #BBBBBB);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;
        alignment: space-between;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.dark-mode ? #EEEEEE : #202020;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: "▾";
            font-size: 10px;
            color: root.is-open ? (root.dark-mode ? #53B9AB : #00796B) : (root.dark-mode ? #B4B4B4 : #646464);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsButton inherits Rectangle {
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.4;
    in property <string> label;
    in property <string> kind: "secondary"; // "primary", "secondary", "subtle", "danger"
    in property <bool> dark-mode: false;
    in property <length> button-width: 0px;
    callback clicked();

    width: root.button-width > 0px ? root.button-width : self.preferred-width;
    height: 28px;
    border-radius: 7px;
    background: root.kind == "primary"
        ? (touch.has-hover ? #008573 : #00796B)
        : (root.kind == "subtle"
            ? (touch.has-hover
                ? (root.dark-mode ? #2A2A2A : #E8E8E8)
                : (root.dark-mode ? #222222 : #F0F0F0))
            : (root.kind == "danger"
                ? (root.dark-mode ? #2A2A2A : #FFFFFF)
                : (touch.has-hover
                    ? (root.dark-mode ? #2A2A2A : #F0F0F0)
                    : (root.dark-mode ? #2A2A2A : #FFFFFF))));
    border-width: root.kind == "primary" ? 0px : 1px;
    border-color: root.kind == "danger"
        ? (root.dark-mode ? #EEEEEE : #202020)
        : (root.kind == "subtle"
            ? (root.dark-mode ? #606060 : #D9D9D9)
            : (root.dark-mode ? #606060 : #BBBBBB));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 500;
            color: root.kind == "primary"
                ? #FFFFFF
                : (root.kind == "danger"
                    ? (root.dark-mode ? #EEEEEE : #202020)
                    : (root.kind == "subtle"
                        ? (root.dark-mode ? #B4B4B4 : #646464)
                        : (root.dark-mode ? #EEEEEE : #202020)));
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SettingsDropdownOption inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> dark-mode: false;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    background: root.active
        ? (root.dark-mode ? #3A3A3A : #E0E0E0)
        : (opt-touch.has-hover ? (root.dark-mode ? #2A2A2A : #F0F0F0) : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.active ? 600 : 500;
            color: root.dark-mode ? #EEEEEE : #202020;
            vertical-alignment: center;
        }

        if root.active : Text {
            text: "✓";
            font-size: 12px;
            font-weight: 700;
            color: root.dark-mode ? #53B9AB : #00796B;
            vertical-alignment: center;
        }
    }

    opt-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsMenu inherits Rectangle {
    in property <bool> dark-mode: false;

    horizontal-stretch: 0;
    width: 168px;
    height: content.preferred-height;
    border-radius: 8px;
    background: root.dark-mode ? #2A2A2A : #FFFFFF;
    border-width: 1px;
    border-color: root.dark-mode ? #606060 : #BBBBBB;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: root.dark-mode ? #00000088 : #2020201A;

    content := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    in property <bool> dark-mode: false;
    in property <length> track-width: 204px;
    callback selected(int);

    width: root.track-width;
    height: 28px;
    border-radius: 7px;
    background: root.dark-mode ? #191919 : #E8E8E8;

    HorizontalLayout {
        padding: 2px;
        spacing: 0px;

        for opt[idx] in root.options : Rectangle {
            horizontal-stretch: 1;
            height: 24px;
            y: 0px;
            border-radius: 5px;
            background: root.selected-index == idx
                ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                : transparent;
            border-width: root.selected-index == idx ? 1px : 0px;
            border-color: root.dark-mode ? #7B7B7B : #838383;

            Text {
                width: parent.width;
                height: parent.height;
                text: opt;
                font-size: 11px;
                font-weight: root.selected-index == idx ? 600 : 400;
                color: root.dark-mode ? #EEEEEE : #202020;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.selected(idx); }
            }
        }
    }
}

component BrandMark inherits Rectangle {
    in property <length> mark-size: 20px;
    width: root.mark-size;
    height: root.mark-size;
    border-radius: root.mark-size * 0.22;
    background: #FFFFFF;
    border-width: 1px;
    border-color: #BBBBBB;
    clip: true;

    Rectangle {
        width: parent.width;
        height: parent.height * 0.27;
        background: #E5484D;
    }

    property <length> tile: root.mark-size * 0.19;
    property <length> gap: root.mark-size * 0.12;
    property <length> left: (root.mark-size - root.tile * 2 - root.gap) / 2;
    property <length> top: root.mark-size * 0.42;

    Rectangle {
        x: root.left;
        y: root.top;
        width: root.tile;
        height: root.tile;
        border-radius: root.mark-size * 0.035;
        background: #313131;
    }
    Rectangle {
        x: root.left + root.tile + root.gap;
        y: root.top;
        width: root.tile;
        height: root.tile;
        border-radius: root.mark-size * 0.035;
        background: #313131;
    }
    Rectangle {
        x: root.left;
        y: root.top + root.tile + root.gap;
        width: root.tile;
        height: root.tile;
        border-radius: root.mark-size * 0.035;
        background: #313131;
    }
    Rectangle {
        x: root.left + root.tile + root.gap;
        y: root.top + root.tile + root.gap;
        width: root.tile;
        height: root.tile;
        border-radius: root.mark-size * 0.035;
        background: #E5484D;
    }
}

component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <color> subtitle-color: #BC333B;
    in property <bool> dark-mode: false;
    in property <bool> show-divider: true;
    in property <color> title-color: #202020;

    height: 40px;
    background: transparent;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 500;
                color: root.title-color;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 10.5px;
                font-weight: 400;
                color: root.subtitle-color;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            @children
        }
    }

    // Hairline sits inside the 40px row so five rows fit the 200px Penpot card.
    if root.show-divider : Rectangle {
        x: 12px;
        y: parent.height - 1px;
        width: parent.width - 24px;
        height: 1px;
        background: root.dark-mode ? #3A3A3A : #D9D9D9;
    }
}

component SettingsField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> dark-mode: false;
    in property <bool> enabled: true;

    height: 28px;
    border-radius: 7px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.dark-mode ? #2A2A2A : #FFFFFF;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? (root.dark-mode ? #53B9AB : #00796B) : (root.dark-mode ? #606060 : #BBBBBB);

    if root.text == "" && root.placeholder != "" : Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        text: root.placeholder;
        font-size: 12px;
        color: root.dark-mode ? #606060 : #BBBBBB;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        text <=> root.text;
        font-size: 12px;
        color: root.dark-mode ? #EEEEEE : #202020;
        single-line: true;
        enabled: root.enabled;
    }
}

