    in property <string> koona-button-text: "koona.app ↗";
    in property <string> startup-status-text: "";
    in property <string> outlook-section-text: "Outlook";
    in property <string> ics-section-text: "Private calendar link";
    in property <string> ics-help-text: "";
    in property <string> calendars-dot-note-text: "Only checked calendars show event dots.";
    in property <bool> calendars-access-denied: false;
    in property <string> calendars-denied-title-text: "Calendar access is turned off in System Privacy Settings";
    in property <string> calendars-denied-desc-text: "Lightcal needs permission to read calendar events. The month view still works without them.";
    in property <string> open-privacy-settings-label: "Open Privacy Settings";
    in property <string> retry-sync-label: "Retry Sync";
    in property <bool> calendars-is-empty: false;
    in property <string> calendars-empty-title-text: "No calendar accounts connected yet";
    in property <string> calendars-empty-desc-text: "Nothing is connected yet. Add Outlook or a private ICS link, then choose which calendars to show.";
    in property <string> add-calendar-account-label: "+ Add Calendar Account";
    in property <string> active-calendars-count-label: "ACTIVE CALENDARS (3)";
    in property <string> add-calendar-label: "+ Add Calendar";
    in property <bool> update-is-checking: false;
    in property <string> checking-updates-label: "Checking updates…";
    in property <string> update-available-badge-text: "Update available";
    in property <string> update-ready-title-text: "A newer version is available";
    in property <string> update-ready-notes-text: "Open the release page to review it. You choose when to install.";
    in property <string> release-notes-button-text: "Release notes";
    in property <bool> auto-check-updates: false;
    in property <string> label-auto-updates-text: "Automatic updates";
    in property <string> desc-auto-updates-text: "Download and verify signed releases in the background";
    in property <string> label-update-channel-text: "Update channel";
    in property <string> desc-update-channel-text: "Receive verified stable releases or preview builds";
    in property <string> label-license-source-text: "License & source";
    in property <string> desc-license-source-text: "GPL-3.0-only · Built with Rust, Slint, and zero webview bloat";
    in property <string> app-version-line-text: "Lightcal · Rust + Slint";

    // Callbacks
    callback prev-month();
    callback next-month();
    callback return-to-today();
    callback select-cell(int);
    callback move-selection-by(int);
    callback open-settings(int);
    callback close-settings();
    callback select-language(string);
    callback select-theme(string);
    callback select-tray-icon-mode(string);
    callback toggle-tray-icon-monochrome();
    callback toggle-first-weekday();
    callback toggle-gray-weekday(int);
    callback toggle-show-weekday();
    callback toggle-show-week-numbers();
    callback toggle-start-with-windows();
    callback cycle-shortcut-preset();
    callback clear-shortcut();
    callback toggle-calendar-source(string);
    callback refresh-calendars();
    callback connect-microsoft();
    callback disconnect-microsoft();
    callback add-ics-source(string,string);
    callback remove-calendar-source(string);
    callback toggle-legacy-windows();
    callback install-update();
    callback toggle-auto-install-updates();
    callback check-updates();
    callback open-external-url(string);
    callback dismiss-compact();
    // Additional settings callbacks
    callback toggle-language-dropdown();
    callback toggle-theme-dropdown();
    callback toggle-first-day-dropdown();
    callback toggle-update-channel-dropdown();
    callback select-first-weekday-option(bool);
    callback select-update-channel(string);
    callback toggle-highlight-current-month();
    callback toggle-show-event-dots();
    callback toggle-auto-check-updates();
    callback reset-shortcut();
    callback open-privacy-settings();
    callback retry-calendar-sync();
    callback add-calendar-account();
    callback minimize-window();

    width: root.settings-open ? 780px : 352px;
    height: root.settings-open ? 620px : 432px;
    preferred-width: root.settings-open ? 780px : 352px;
    preferred-height: root.settings-open ? 620px : 432px;
    background: transparent;

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.settings-open) {
                    root.close-settings();
                } else {
                    root.dismiss-compact();
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.move-selection-by(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.move-selection-by(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection-by(-7);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection-by(7);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.prev-month();
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.next-month();
                return accept;
            }
            return reject;
        }
    }

    // ==================== CALENDAR VIEW (352×432) ====================
    if !root.settings-open : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.dark-mode ? #27272A : #DFDFE4;
        background: root.dark-mode ? #101012 : #FFFFFF;
        clip: true;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Zone A: Header Bar (Month + Year, Current-Month Indicator, Neutral Tactile Controls)
            header-bar := Rectangle {
                height: 52px;

                // Month Title + Current-Month Indicator (Left)
                VerticalLayout {
                    x: 16px;
                    y: (root.is-current-month ? 8px : 14px);
                    width: parent.width - 188px;
                    spacing: 3px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.month-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: root.dark-mode ? #F4F4F6 : #141416;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }


                    }

                    // Compact mode Current Month Underline + Dot + Badge
                    if root.is-current-month : HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Rectangle {
                            width: 28px;
                            height: 2px;
                            border-radius: 1px;
                            background: #5E6AD2;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: #5E6AD2;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.current-month-badge;
                            font-size: 10px;
                            font-weight: 500;
                            color: root.dark-mode ? #94949E : #64646C;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }


                }

                // Right Navigation Controls
                HorizontalLayout {
                    x: 0px;
                    y: 12px;
                    width: parent.width;
                    height: 26px;
                    spacing: 4px;
                    alignment: end;
                    padding-right: 12px;

                    IconSquareButton {
                        glyph: "‹";
                        dark-mode: root.dark-mode;
                        clicked => { root.prev-month(); }
                    }
                    TactileButton {
                        label: root.today-button-label;
                        show-coral-dot: true;
                        dark-mode: root.dark-mode;
                        clicked => { root.return-to-today(); }
                    }
                    IconSquareButton {
                        glyph: "›";
                        dark-mode: root.dark-mode;
                        clicked => { root.next-month(); }
                    }
                    IconSquareButton {
                        glyph: "⚙";
                        subtle: true;
                        dark-mode: root.dark-mode;
                        clicked => { root.open-settings(0); }
                    }


                }

                // Header Bottom Hairline
                Rectangle {
                    x: 0px;
                    y: 51px;
                    width: parent.width;
                    height: 1px;
                    background: root.dark-mode ? #1F1F24 : #ECECEF;
                }
            }

            // Zone B: Borderless 7-Column Month Grid + ISO Weeks
            month-grid-area := Rectangle {
                vertical-stretch: 1;

                property <length> grid-start-x: (root.show-week-numbers ? 44px : 29px);
                property <length> col-width: 42px;
                property <length> band-width: 38px;
                property <length> tile-width: 34px;
                property <length> tile-height: 34px;
                property <length> week-col-x: 14px;
                property <length> week-hdr-x: 18px;

                // Continuous Full-Height Rounded Weekend Bands (Z-order: in background)
                for is-gray[col-idx] in root.gray-columns : Rectangle {
                    if is-gray : Rectangle {
                        x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width + 2px;
                        y: 8px;
                        width: month-grid-area.band-width;
                        height: 292px;
                        border-radius: 8px;
                        background: root.dark-mode ? #151519 : #F8F8FA;
                    }
                }

                // Weekday Header Row
                if root.show-weekday-header : Rectangle {
                    y: 0px;
                    height: 34px;
                    width: parent.width;

                    if root.show-week-numbers : Text {
                        x: month-grid-area.week-hdr-x;
                        y: 11px;
                        text: root.week-header-label;
                        font-size: 10px;
                        font-weight: 600;
                        color: root.dark-mode ? #52525B : #A0A0AB;
                    }

                    for wd[col-idx] in root.weekday-headers : Text {
                        x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width;
                        y: 11px;
                        width: month-grid-area.col-width;
                        height: 18px;
                        text: wd;
                        font-size: 11px;
                        font-weight: 500;
                        color: root.gray-columns[col-idx]
                            ? (root.dark-mode ? #52525B : #A0A0AB)
                            : (root.dark-mode ? #94949E : #64646C);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 6 Week Rows × 7 Day Cells (42 cells total)
                for row-idx in [0, 1, 2, 3, 4, 5] : Rectangle {
                    y: (36px) + row-idx * 44px;
                    height: 44px;
                    width: parent.width;

                    if root.show-week-numbers : Text {
                        x: month-grid-area.week-col-x;
                        y: 14px;
                        text: "W" + root.iso-weeks[row-idx];
                        font-size: 10px;
                        font-weight: 500;
                        font-family: "Cascadia Mono, Consolas, monospace";
                        color: root.dark-mode ? #52525B : #A0A0AB;
                    }

                    for col-idx in [0, 1, 2, 3, 4, 5, 6] : cell-box := Rectangle {
                        property <int> cell-index: row-idx * 7 + col-idx;
                        property <DayCellData> cell: root.cells[self.cell-index];
                        property <bool> today-in-month: self.cell.is-today && self.cell.in-month;

                        x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width + (month-grid-area.col-width - month-grid-area.tile-width) / 2;
                        y: (parent.height - month-grid-area.tile-height) / 2;
                        width: month-grid-area.tile-width;
                        height: month-grid-area.tile-height;
                        border-radius: 8px;
                        accessible-role: button;
                        accessible-label: self.cell.accessible-label;

                        background: self.today-in-month
                            ? #E5484D
                            : (self.cell.is-selected
                                ? (root.dark-mode ? #1D203A : #EEF0FF)
                                : (cell-touch.has-hover && self.cell.in-month
                                    ? (root.dark-mode ? #1C1C21 : #F2F2F5)
                                    : transparent));
                        border-width: (self.cell.is-selected && !self.today-in-month) ? 1.5px : 0px;
                        border-color: #5E6AD2;

                        // Centered day numeral
                        Text {
                            width: parent.width;
                            height: (cell-box.cell.dot-count > 0 && cell-box.cell.in-month && root.show-event-dots) ? parent.height - 6px : parent.height;
                            text: cell-box.cell.day-number;
                            font-size: 12px;
                            font-weight: ((cell-box.cell.is-today && cell-box.cell.in-month) || cell-box.cell.is-selected)
                                ? 700
                                : (cell-box.cell.in-month ? 500 : 400);
                            color: (cell-box.cell.is-today && cell-box.cell.in-month)
                                ? #FFFFFF
                                : (!cell-box.cell.in-month
                                    ? (root.dark-mode ? #3A3A42 : #C8C8D0)
                                    : (cell-box.cell.is-gray-weekday
                                        ? (root.dark-mode ? #94949E : #64646C)
                                        : (root.dark-mode ? #F4F4F6 : #141416)));
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Event Dots centered along the bottom of the cell
                        if cell-box.cell.dot-count > 0 && cell-box.cell.in-month && root.show-event-dots : HorizontalLayout {
                            x: 0px;
                            width: parent.width;
                            y: parent.height - 7px;
                            height: 4px;
                            spacing: 3px;
                            alignment: center;

                            if cell-box.cell.dot-count >= 1 : Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: (cell-box.cell.is-today && cell-box.cell.in-month) ? #FFFFFF : cell-box.cell.dot1;
                            }
                            if cell-box.cell.dot-count >= 2 : Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: (cell-box.cell.is-today && cell-box.cell.in-month) ? #FFFFFF : cell-box.cell.dot2;
                            }
                            if cell-box.cell.dot-count >= 3 : Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: (cell-box.cell.is-today && cell-box.cell.in-month) ? #FFFFFF : cell-box.cell.dot3;
                            }
                        }

                        cell-touch := TouchArea {
                            clicked => { root.select-cell(cell-box.cell-index); }
                        }
                    }
                }
            }

            // Hairline Divider
            Rectangle {
                height: 1px;
                background: root.dark-mode ? #1F1F24 : #ECECEF;
            }

            // Zone C: Selected-Date Summary & Agenda Preview Strip
            bottom-area := Rectangle {
                height: 76px;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 3px;

                    HorizontalLayout {
                        height: 18px;
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: root.selected-date-line;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.dark-mode ? #F4F4F6 : #141416;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.selected-event-summary;
                            font-size: 11px;
                            font-weight: 500;
                            color: root.dark-mode ? #94949E : #64646C;
                            vertical-alignment: center;
                        }
                    }

                    for ev in root.selected-day-events : HorizontalLayout {
                        height: 18px;
                        spacing: 8px;

                        Rectangle {
                            width: 3px;
                            height: 12px;
                            border-radius: 1.5px;
                            background: ev.swatch;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: ev.time-label;
                            font-size: 11px;
                            font-weight: 600;
                            font-family: "Cascadia Mono, Consolas, monospace";
                            color: root.dark-mode ? #94949E : #64646C;
                            vertical-alignment: center;
                        }
                        Text {
                            text: ev.title;
                            font-size: 11px;
                            font-weight: 500;
                            color: root.dark-mode ? #F4F4F6 : #141416;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: ev.calendar-name;
                            font-size: 10px;
                            font-weight: 500;
                            color: root.dark-mode ? #52525B : #A0A0AB;
                            vertical-alignment: center;
                        }
                    }

                    if root.selected-day-events.length == 0 : HorizontalLayout {
                        height: 18px;
                        spacing: 8px;
                        alignment: space-between;
                        Text {
                            text: root.active-calendars-label;
                            font-size: 11px;
                            color: root.dark-mode ? #52525B : #A0A0AB;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        calendars-link := TouchArea {
                            width: 88px;
                            height: 18px;
                            clicked => { root.open-settings(2); }
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.nav-calendars-text;
                                font-size: 11px;
                                font-weight: 600;
                                color: calendars-link.has-hover ? #5E6AD2 : (root.dark-mode ? #94949E : #64646C);
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }


            }
        }
    }

    // ==================== SETTINGS VIEW (780 × 620, FLAT HAIRLINE ROWS) ====================
    if root.settings-open : Rectangle {
        width: 780px;
        height: 620px;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.dark-mode ? #27272A : #DFDFE4;
        background: root.dark-mode ? #101012 : #FFFFFF;
        clip: true;

        HorizontalLayout {
            spacing: 0px;

            // Left Sidebar (200px)
            Rectangle {
                width: 200px;
                background: root.dark-mode ? #141417 : #F7F7F8;

                VerticalLayout {
                    padding-top: 18px;
                    padding-bottom: 18px;
                    padding-left: 16px;
                    padding-right: 14px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 6px;

                        // Sidebar identity: date badge, wordmark, and a quiet preferences label.
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: #E5484D;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.live-day-text;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #FFFFFF;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 0px;

                                Text {
                                    text: "Lightcal";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: root.dark-mode ? #F4F4F6 : #141416;
                                }
                                Text {
                                    text: root.preferences-subtitle-text;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: root.dark-mode ? #52525B : #A0A0AB;
                                }
                            }
                        }

                        Rectangle { height: 18px; }

                        // Navigation Items
                        for nav-label[tab-idx] in [
                            root.nav-general-text,
                            root.nav-appearance-text,
                            root.nav-calendars-text,
                            root.nav-about-text
                        ] : Rectangle {
                            height: 36px;
                            border-radius: 10px;
                            background: root.settings-tab == tab-idx
                                ? (root.dark-mode ? #1D203A : #EEF0FF)
                                : (nav-touch.has-hover ? (root.dark-mode ? #1C1C20 : #EEEEF2) : transparent);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: nav-label;
                                    horizontal-stretch: 1;
                                    font-size: 13px;
                                    font-weight: root.settings-tab == tab-idx ? 600 : 500;
                                    overflow: elide;
                                    color: root.settings-tab == tab-idx
                                        ? (root.dark-mode ? #F4F4F6 : #141416)
                                        : (root.dark-mode ? #94949E : #64646C);
                                    vertical-alignment: center;
                                }
                            }

                            nav-touch := TouchArea {
                                clicked => { root.open-settings(tab-idx); }
                            }
                        }
                    }

                    // Minimal Footer Link: ← Back to Calendar
                    VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            height: 1px;
                            background: root.dark-mode ? #1F1F24 : #ECECEF;
                        }

                        Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                padding-left: 4px;
                                Text {
                                    text: root.back-to-calendar-text;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: back-touch.has-hover
                                        ? (root.dark-mode ? #F4F4F6 : #141416)
                                        : (root.dark-mode ? #94949E : #64646C);
                                    vertical-alignment: center;
                                }
                            }
                            back-touch := TouchArea {
                                clicked => { root.close-settings(); }
                            }
                        }
                    }
                }
            }

            // Hairline Divider
            Rectangle {
                width: 1px;
                background: root.dark-mode ? #1F1F24 : #ECECEF;
            }

            // Right Content Pane (Flat Hairline Rows + Overlays)
            Rectangle {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    spacing: 12px;
                    alignment: start;

                    // Header Row with Title, Subtitle, and Window Controls (— ×)
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.settings-tab == 0 ? root.nav-general-text
                                    : root.settings-tab == 1 ? root.nav-appearance-text
                                    : root.settings-tab == 2 ? root.nav-calendars-text
                                    : root.nav-about-text;
                                font-size: 18px;
                                font-weight: 700;
                                color: root.dark-mode ? #F4F4F6 : #141416;
                            }
                            Text {
                                text: root.settings-tab == 0 ? root.general-subtitle-text
                                    : root.settings-tab == 1 ? root.appearance-subtitle-text
                                    : root.settings-tab == 2 ? root.calendars-subtitle-text
                                    : root.about-subtitle-text;
                                font-size: 12px;
                                font-weight: 400;
                                color: root.dark-mode ? #94949E : #64646C;
                                wrap: word-wrap;
                            }
                        }

                        // Frameless Window Controls (— ×) top right
                        HorizontalLayout {
                            spacing: 8px;
                            y: 0px;

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                background: min-btn-touch.has-hover ? (root.dark-mode ? #26262B : #EFEFF2) : transparent;
                                accessible-role: button;
                                accessible-label: "Minimize";
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "—";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: min-btn-touch.has-hover ? (root.dark-mode ? #F4F4F6 : #141416) : (root.dark-mode ? #52525B : #A0A0AB);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                min-btn-touch := TouchArea {
                                    clicked => { root.minimize-window(); }
                                }
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                background: close-btn-touch.has-hover ? (root.dark-mode ? #2A1618 : #FFF0F0) : transparent;
                                accessible-role: button;
                                accessible-label: root.back-to-calendar-text;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "×";
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: close-btn-touch.has-hover ? #E5484D : (root.dark-mode ? #52525B : #A0A0AB);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                close-btn-touch := TouchArea {
                                    clicked => { root.close-settings(); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                    // TAB 0: GENERAL
                    if root.settings-tab == 0 : ScrollView {
                        height: 508px;
                        VerticalLayout {
                        spacing: 0px;
                        padding-bottom: 12px;

                        SettingsSectionLabel {
                            label: root.section-region-text;
                            dark-mode: root.dark-mode;
                            first: true;
                        }
                        SettingsGroup {
                            dark-mode: root.dark-mode;
                        SettingsLine {
                            SettingsRowText {
                                title: root.label-language-text;
                                description: root.desc-language-text;
                                dark-mode: root.dark-mode;
                            }
                            SettingsSelect {
                                text: root.current-language-display;
                                is-open: root.language-dropdown-open;
                                dark-mode: root.dark-mode;
                                clicked => { root.toggle-language-dropdown(); }
                            }
                        }
                        if root.language-dropdown-open : SettingsMenuRow {
                            dark-mode: root.dark-mode;
                            SettingsDropdownOption {
                                label: root.lang-en-us-label;
                                active: root.current-language-code == "en";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-language("en"); }
                            }
                            SettingsDropdownOption {
                                label: root.lang-ru-label;
                                active: root.current-language-code == "ru";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-language("ru"); }
                            }
                            SettingsDropdownOption {
                                label: root.lang-es-label;
                                active: root.current-language-code == "es";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-language("es"); }
                            }
                            SettingsDropdownOption {
                                label: root.lang-ja-label;
                                active: root.current-language-code == "ja";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-language("ja"); }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-first-weekday-text;
                                description: root.desc-first-weekday-text;
                                dark-mode: root.dark-mode;
                            }
                            SettingsSelect {
                                text: root.current-first-weekday-display;
                                is-open: root.first-day-dropdown-open;
                                dark-mode: root.dark-mode;
                                clicked => { root.toggle-first-day-dropdown(); }
                            }
                        }
                        if root.first-day-dropdown-open : SettingsMenuRow {
                            dark-mode: root.dark-mode;
                            SettingsDropdownOption {
                                label: root.weekday-monday-label;
                                active: root.first-weekday-monday;
                                dark-mode: root.dark-mode;
                                clicked => { root.select-first-weekday-option(true); }
                            }
                            SettingsDropdownOption {
                                label: root.weekday-sunday-label;
                                active: !root.first-weekday-monday;
                                dark-mode: root.dark-mode;
                                clicked => { root.select-first-weekday-option(false); }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsSwitchRow {
                            title: root.label-show-week-numbers-text;
                            description: root.desc-show-week-numbers-text;
                            checked: root.show-week-numbers;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-show-week-numbers(); }
                        }
                        }

                        SettingsSectionLabel {
                            label: root.section-startup-text;
                            dark-mode: root.dark-mode;
                        }
                        SettingsGroup {
                            dark-mode: root.dark-mode;
                        SettingsSwitchRow {
                            title: root.label-startup-text;
                            description: root.desc-startup-text;
                            checked: root.start-with-windows;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-start-with-windows(); }
                        }
                        if root.startup-status-text != "" : Text {
                            text: root.startup-status-text;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: root.dark-mode ? #F87171 : #B42328;
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-shortcut-text;
                                description: root.desc-shortcut-text;
                                dark-mode: root.dark-mode;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    width: 148px;
                                    height: 34px;
                                    border-radius: 10px;
                                    background: root.shortcut-has-conflict
                                        ? (root.dark-mode ? #2A1618 : #FFF0F0)
                                        : (root.dark-mode ? #222228 : #FFFFFF);
                                    border-width: 1px;
                                    border-color: root.shortcut-has-conflict
                                        ? (root.dark-mode ? #F87171 : #E5484D)
                                        : (root.dark-mode ? #3A3A42 : #E4E4EA);
                                    drop-shadow-blur: 4px;
                                    drop-shadow-offset-y: 1px;
                                    drop-shadow-color: root.shortcut-has-conflict ? #00000000 : #14141614;

                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text: root.global-shortcut-display;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                        color: root.shortcut-has-conflict
                                            ? (root.dark-mode ? #F87171 : #E5484D)
                                            : (root.dark-mode ? #F4F4F6 : #141416);
                                        vertical-alignment: center;
                                    }
                                }
                                SettingsButton {
                                    label: root.shortcut-record-label;
                                    dark-mode: root.dark-mode;
                                    clicked => { root.cycle-shortcut-preset(); }
                                }
                                if root.shortcut-can-clear : SettingsButton {
                                    label: root.shortcut-clear-label;
                                    kind: "subtle";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.clear-shortcut(); }
                                }
                            }
                        }

                        // Conflict Banner if shortcut has conflict
                        if root.shortcut-has-conflict : Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: root.dark-mode ? #2A1618 : #FFF0F0;
                            border-width: 1px;
                            border-color: root.dark-mode ? #F87171 : #E5484D;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: root.shortcut-conflict-title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.dark-mode ? #F87171 : #E5484D;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.shortcut-conflict-hint;
                                        font-size: 11px;
                                        font-weight: 400;
                                        color: root.dark-mode ? #94949E : #64646C;
                                        overflow: elide;
                                    }
                                }

                                SettingsButton {
                                    button-width: 76px;
                                    label: root.shortcut-reset-label;
                                    dark-mode: root.dark-mode;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.reset-shortcut(); }
                                }
                            }
                        }
                        }
                        }
                    }

                    // TAB 1: APPEARANCE
                    if root.settings-tab == 1 : ScrollView {
                        height: 508px;
                        VerticalLayout {
                        spacing: 0px;
                        padding-bottom: 12px;

                        SettingsGroup {
                            dark-mode: root.dark-mode;
                        SettingsLine {
                            SettingsRowText {
                                title: root.label-theme-text;
                                description: root.desc-theme-text;
                                dark-mode: root.dark-mode;
                            }
                            SettingsSelect {
                                text: root.current-theme-display;
                                is-open: root.theme-dropdown-open;
                                dark-mode: root.dark-mode;
                                clicked => { root.toggle-theme-dropdown(); }
                            }
                        }
                        if root.theme-dropdown-open : SettingsMenuRow {
                            dark-mode: root.dark-mode;
                            SettingsDropdownOption {
                                label: root.theme-light-label;
                                active: root.current-theme-code == "light";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-theme("light"); }
                            }
                            SettingsDropdownOption {
                                label: root.theme-dark-label;
                                active: root.current-theme-code == "dark";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-theme("dark"); }
                            }
                            SettingsDropdownOption {
                                label: root.theme-system-label;
                                active: root.current-theme-code == "system";
                                dark-mode: root.dark-mode;
                                clicked => { root.select-theme("system"); }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-gray-weekdays-text;
                                description: root.desc-gray-weekdays-text;
                                dark-mode: root.dark-mode;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                for chip in root.gray-weekday-chips : Rectangle {
                                    width: 28px;
                                    height: 26px;
                                    border-radius: 6px;
                                    background: chip.active
                                        ? #5E6AD2
                                        : (root.dark-mode ? #18181C : #F2F2F5);
                                    border-width: chip.active ? 0px : 1px;
                                    border-color: root.dark-mode ? #1F1F24 : #ECECEF;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: chip.label;
                                        font-size: 11px;
                                        font-weight: chip.active ? 600 : 500;
                                        color: chip.active ? #FFFFFF : (root.dark-mode ? #94949E : #64646C);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.toggle-gray-weekday(chip.index); }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsSwitchRow {
                            title: root.label-highlight-current-month-text;
                            description: root.desc-highlight-current-month-text;
                            checked: root.highlight-current-month;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-highlight-current-month(); }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsSwitchRow {
                            title: root.label-show-event-dots-text;
                            description: root.desc-show-event-dots-text;
                            checked: root.show-event-dots;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-show-event-dots(); }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-tray-mode-text;
                                description: root.desc-tray-mode-text;
                                dark-mode: root.dark-mode;
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                SettingsModePill {
                                    label: root.live-day-text;
                                    active: root.current-tray-icon-mode == "date_only" || root.current-tray-icon-mode == "date";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.select-tray-icon-mode("date"); }
                                }
                                SettingsModePill {
                                    label: root.live-weekday-date-text;
                                    active: root.current-tray-icon-mode == "weekday_and_date" || root.current-tray-icon-mode == "weekday-date";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.select-tray-icon-mode("weekday-date"); }
                                }
                                SettingsModePill {
                                    label: root.live-time-text;
                                    active: root.current-tray-icon-mode == "time_and_date" || root.current-tray-icon-mode == "time-date";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.select-tray-icon-mode("time-date"); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-tray-palette-text;
                                description: root.desc-tray-palette-text;
                                dark-mode: root.dark-mode;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                TrayPaletteSwatch {
                                    selected: !root.tray-icon-monochrome;
                                    dark-mode: root.dark-mode;
                                    source: root.colored-icon-preview;
                                }
                                TrayPaletteSwatch {
                                    selected: root.tray-icon-monochrome;
                                    dark-mode: root.dark-mode;
                                    source: root.monochrome-icon-preview;
                                }
                                TactileButton {
                                    label: root.tray-icon-monochrome ? root.palette-monochrome-text : root.palette-colored-text;
                                    show-coral-dot: !root.tray-icon-monochrome;
                                    dark-mode: root.dark-mode;
                                    clicked => { root.toggle-tray-icon-monochrome(); }
                                }
                            }
                        }
                        }
                        }
                    }

                    // TAB 2: CALENDARS
                    if root.settings-tab == 2 : ScrollView {
                        height: 508px;
                        VerticalLayout {
                        spacing: 0px;
                        padding-bottom: 16px;

                        SettingsSectionLabel {
                            label: root.outlook-section-text;
                            dark-mode: root.dark-mode;
                            first: true;
                        }
                        SettingsGroup {
                            dark-mode: root.dark-mode;
                            pad-top: 12px;
                            pad-bottom: 12px;
                        HorizontalLayout {
                            alignment: start;
                            padding-bottom: 10px;
                            Rectangle {
                                horizontal-stretch: 0;
                                height: 26px;
                                border-radius: 13px;
                                background: root.account-connected
                                    ? (root.dark-mode ? #10241C : #ECFDF3)
                                    : (root.dark-mode ? #222228 : #FFFFFF);
                                border-width: 1px;
                                border-color: root.account-connected
                                    ? (root.dark-mode ? #14532D : #A7F3D0)
                                    : (root.dark-mode ? #3A3A42 : #E4E4EA);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    Text {
                                        text: root.account-status-text;
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: root.account-connected
                                            ? (root.dark-mode ? #6EE7B7 : #087443)
                                            : (root.dark-mode ? #94949E : #64646C);
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            SettingsButton { label: root.connect-microsoft-label; enabled: root.can-connect-microsoft; kind: "primary"; dark-mode: root.dark-mode; clicked => { root.connect-microsoft(); } }
                            SettingsButton { label: root.disconnect-microsoft-label; enabled: root.can-disconnect-microsoft; dark-mode: root.dark-mode; clicked => { root.disconnect-microsoft(); } }
                            SettingsButton { label: root.refresh-button-text; enabled: root.can-refresh-calendars; kind: "subtle"; dark-mode: root.dark-mode; clicked => { root.refresh-calendars(); } }
                        }
                        }

                        Rectangle { height: 16px; }

                        SettingsSectionLabel {
                            label: root.ics-section-text;
                            dark-mode: root.dark-mode;
                        }
                        SettingsGroup {
                            dark-mode: root.dark-mode;
                            pad-top: 12px;
                            pad-bottom: 14px;
                        Text {
                            text: root.ics-name-placeholder;
                            font-size: 11px;
                            color: root.dark-mode ? #94949E : #64646C;
                        }
                        Rectangle { height: 4px; }
                        SettingsField {
                            text <=> root.ics-source-name;
                            placeholder: "";
                            dark-mode: root.dark-mode;
                            enabled: !root.connection-busy && !root.provider-loading;
                        }
                        Rectangle { height: 8px; }
                        Text {
                            text: root.ics-url-placeholder;
                            font-size: 11px;
                            color: root.dark-mode ? #94949E : #64646C;
                        }
                        Rectangle { height: 4px; }
                        SettingsField {
                            text <=> root.ics-source-url;
                            placeholder: "https://";
                            dark-mode: root.dark-mode;
                            enabled: !root.connection-busy && !root.provider-loading;
                        }
                        Rectangle { height: 6px; }
                        Text {
                            text: root.ics-help-text;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: root.dark-mode ? #52525B : #A0A0AB;
                        }
                        Rectangle { height: 8px; }
                        SettingsButton {
                            label: root.add-ics-label;
                            enabled: !root.connection-busy && !root.provider-loading && root.ics-source-name != "" && root.ics-source-url != "";
                            dark-mode: root.dark-mode;
                            clicked => { root.add-ics-source(root.ics-source-name, root.ics-source-url); }
                        }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            height: 36px;
                            spacing: 12px;
                            alignment: space-between;
                            Text {
                                text: root.legacy-windows-label;
                                font-size: 12px;
                                color: root.dark-mode ? #94949E : #64646C;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            SwitchToggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.legacy-windows-enabled;
                                dark-mode: root.dark-mode;
                                toggled => { root.toggle-legacy-windows(); }
                            }
                        }
                        Rectangle { height: 8px; }
                        Text {
                            text: root.calendars-dot-note-text;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: root.dark-mode ? #52525B : #A0A0AB;
                        }
                        Rectangle { height: 8px; }
                        if root.connection-message != "" : Text {
                            text: root.connection-message;
                            wrap: word-wrap;
                            font-size: 11px;
                            color: root.dark-mode ? #94949E : #64646C;
                        }

                        if root.provider-error-text != "" : Text {
                            text: root.provider-error-text;
                            wrap: word-wrap;
                            color: root.dark-mode ? #F87171 : #B42328;
                            font-size: 12px;
                        }

                        if root.calendars-access-denied : Rectangle {
                            height: 112px;
                            border-radius: 8px;
                            background: root.dark-mode ? #2A1618 : #FFF0F0;
                            border-width: 1px;
                            border-color: root.dark-mode ? #F87171 : #E5484D;

                            VerticalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 6px;
                                alignment: space-between;

                                Text {
                                    text: root.calendars-denied-title-text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.dark-mode ? #F87171 : #E5484D;
                                }
                                Text {
                                    text: root.calendars-denied-desc-text;
                                    font-size: 11px;
                                    font-weight: 400;
                                    wrap: word-wrap;
                                    color: root.dark-mode ? #94949E : #64646C;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    SettingsButton {
                                        button-width: 240px;
                                        label: root.open-privacy-settings-label;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.open-privacy-settings(); }
                                    }
                                    SettingsButton {
                                        button-width: 88px;
                                        label: root.retry-sync-label;
                                        enabled: !root.provider-loading && !root.connection-busy;
                                        kind: "subtle";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.retry-calendar-sync(); }
                                    }
                                }
                            }
                        }

                        if root.calendars-is-empty && !root.calendars-access-denied : VerticalLayout {
                            spacing: 4px;
                            padding-top: 8px;
                            padding-bottom: 8px;

                            Text {
                                text: root.calendars-empty-title-text;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.dark-mode ? #F4F4F6 : #141416;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.calendars-empty-desc-text;
                                font-size: 12px;
                                color: root.dark-mode ? #94949E : #64646C;
                                wrap: word-wrap;
                            }
                        }

                        if !root.calendars-is-empty : VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                height: 36px;
                                alignment: space-between;

                                Text {
                                    text: root.active-calendars-count-label;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.dark-mode ? #94949E : #64646C;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                            for src in root.calendar-sources : VerticalLayout {
                                spacing: 0px;

                                HorizontalLayout {
                                    height: 52px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 5px;
                                            background: src.checked ? src.swatch : transparent;
                                            border-width: src.checked ? 0px : 1px;
                                            border-color: root.dark-mode ? #2C2C32 : #E2E2E6;
                                            y: (parent.height - self.height) / 2;

                                            if src.checked : Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: "✓";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #FFFFFF;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                enabled: !root.connection-busy && !root.provider-loading;
                                                clicked => { root.toggle-calendar-source(src.id); }
                                            }
                                        }

                                        SettingsRowText {
                                            title: src.name;
                                            description: src.account;
                                            dark-mode: root.dark-mode;
                                        }
                                    }

                                    if src.removable : Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 68px;
                                        height: 22px;
                                        border-radius: 6px;
                                        background: root.dark-mode ? #18181C : #F2F2F5;
                                        border-width: 1px;
                                        border-color: root.dark-mode ? #1F1F24 : #ECECEF;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.remove-source-label;
                                            font-size: 10px;
                                            font-weight: 500;
                                            color: root.dark-mode ? #94949E : #64646C;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { enabled:!root.connection-busy && !root.provider-loading; clicked => { root.remove-calendar-source(src.id); } }
                                    }
                                }
                                Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }
                            }
                        }
                    }

                        }
                    // TAB 3: ABOUT
                    if root.settings-tab == 3 : ScrollView {
                        height: 508px;
                        VerticalLayout {
                        spacing: 0px;
                        padding-bottom: 12px;

                        SettingsGroup {
                            dark-mode: root.dark-mode;
                        SettingsLine {
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                horizontal-stretch: 1;

                                SettingsRowText {
                                    title: "Lightcal";
                                    description: root.app-version-line-text;
                                    dark-mode: root.dark-mode;
                                }
                                if root.update-status-text != "" : Text {
                                    text: root.update-status-text;
                                    width: 300px;
                                    wrap: word-wrap;
                                    color: root.dark-mode ? #94949E : #64646C;
                                    font-size: 11px;
                                }
                                if root.install-status-text != "" : Text {
                                    text: root.install-status-text;
                                    width: 300px;
                                    wrap: word-wrap;
                                    color: root.dark-mode ? #94949E : #64646C;
                                    font-size: 11px;
                                }
                            }

                            if root.update-is-checking : Rectangle {
                                width: 164px;
                                height: 30px;
                                border-radius: 6px;
                                background: root.dark-mode ? #18181C : #F2F2F5;
                                border-width: 1px;
                                border-color: root.dark-mode ? #1F1F24 : #ECECEF;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #5E6AD2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.checking-updates-label;
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: root.dark-mode ? #94949E : #64646C;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.update-is-available : Rectangle {
                                width: 128px;
                                height: 26px;
                                border-radius: 6px;
                                background: root.dark-mode ? #1D203A : #EEF0FF;
                                border-width: 1px;
                                border-color: #5E6AD2;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.update-available-badge-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #5E6AD2;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if !root.package-managed-updates && !root.update-is-checking && !root.update-is-available : SettingsButton {
                                label: root.updates-check-button-text;
                                dark-mode: root.dark-mode;
                                clicked => { root.check-updates(); }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        // Release Card (if update available)
                        if root.update-is-available : Rectangle {
                            border-radius: 8px;
                            background: root.dark-mode ? #141417 : #F7F7F8;
                            border-width: 1px;
                            border-color: #5E6AD2;

                            VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 6px;
                                alignment: space-between;

                                Text {
                                    text: root.update-ready-title-text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.dark-mode ? #F4F4F6 : #141416;
                                }
                                Text {
                                    text: root.update-ready-notes-text;
                                    width: 440px;
                                    wrap: word-wrap;
                                    font-size: 11px;
                                    font-weight: 400;
                                    color: root.dark-mode ? #94949E : #64646C;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    SettingsButton {
                                        button-width: 152px;
                                        label: root.install-update-label;
                                        kind: "primary";
                                        dark-mode: root.dark-mode;
                                        clicked => { root.install-update(); }
                                    }
                                    SettingsButton {
                                        button-width: 112px;
                                        label: root.release-notes-button-text;
                                        dark-mode: root.dark-mode;
                                        clicked => { root.open-external-url("https://github.com/andmetoo/lightcal/releases"); }
                                    }
                                }
                            }
                        }
                        if root.update-is-available : Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        if !root.package-managed-updates : SettingsSwitchRow {
                            title: root.auto-install-label;
                            description: root.desc-auto-install-text;
                            checked: root.auto-install-updates;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-auto-install-updates(); }
                        }
                        if !root.package-managed-updates : Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }
                        if !root.package-managed-updates : SettingsSwitchRow {
                            title: root.label-auto-updates-text;
                            description: root.desc-auto-updates-text;
                            checked: root.auto-check-updates;
                            dark-mode: root.dark-mode;
                            toggled => { root.toggle-auto-check-updates(); }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-update-channel-text;
                                description: root.desc-update-channel-text;
                                dark-mode: root.dark-mode;
                            }
                            SettingsSelect {
                                text: root.current-update-channel-display;
                                is-open: root.update-channel-dropdown-open;
                                dark-mode: root.dark-mode;
                                clicked => { root.toggle-update-channel-dropdown(); }
                            }
                        }
                        if root.update-channel-dropdown-open : SettingsMenuRow {
                            dark-mode: root.dark-mode;
                            SettingsDropdownOption {
                                label: root.channel-stable-label;
                                active: !root.update-channel-is-preview;
                                dark-mode: root.dark-mode;
                                clicked => { root.select-update-channel("stable"); }
                            }
                            SettingsDropdownOption {
                                label: root.channel-preview-label;
                                active: root.update-channel-is-preview;
                                dark-mode: root.dark-mode;
                                clicked => { root.select-update-channel("preview"); }
                            }
                        }
                        Rectangle { height: 1px; background: root.dark-mode ? #1F1F24 : #ECECEF; }

                        SettingsLine {
                            SettingsRowText {
                                title: root.label-license-source-text;
                                description: root.desc-license-source-text;
                                dark-mode: root.dark-mode;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                SettingsButton {
                                    label: root.github-button-text;
                                    kind: "subtle";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.open-external-url("https://github.com/andmetoo/lightcal"); }
                                }
                                SettingsButton {
                                    label: root.koona-button-text;
                                    kind: "subtle";
                                    dark-mode: root.dark-mode;
                                    clicked => { root.open-external-url("https://koona.app"); }
                                }
                            }
                        }
                        }
                        }
                    }
                }

            }
        }
    }
}
