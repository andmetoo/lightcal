// Lightcal — native desktop calendar UI (Slint).
// November 2026 design refresh (ADR 0011) · Segoe UI Variable · Calendar 352×432 · Settings 448×360
// Modules: theme.slint (tokens), controls.slint (shared controls), types.slint (Rust structs),
// calendar.slint (CalendarView), settings.slint (SettingsView with About).

import { Theme } from "theme.slint";
import { CalendarView } from "calendar.slint";
import { SettingsView } from "settings.slint";
import { DayCellData, MonthViewData, CalendarSourceItem, WeekdayChipItem, AgendaEventItem, AgendaChipRow, ShadedBand } from "types.slint";

export { Theme }
export { DayCellData, MonthViewData, CalendarSourceItem, WeekdayChipItem, AgendaEventItem, AgendaChipRow, ShadedBand }

export component AppWindow inherits Window {
    title: "Lightcal";
    no-frame: true;
    default-font-family: Theme.font-family;
    in property <image> window-icon;
    icon: root.window-icon;
    // Aliases Theme.dark so every module reads the active palette.
    in-out property <bool> dark-mode <=> Theme.dark;
    in property <bool> settings-open: false;
    // 0=Calendar, 1=Accounts, 2=App, 3=About
    in property <int> settings-tab: 0;

    // Calendar Header & Grid Properties
    // The heading and dates are published as one snapshot of the displayed month.
    in property <MonthViewData> month-view;
    out property <string> month-title: root.month-view.title;
    in property <bool> is-current-month: true;
    in property <string> current-month-badge: "Current month";
    in property <string> today-date-line: "Thursday, 29 October";
    in property <string> today-button-label: "Today";
    in property <string> week-header-label: "W";
    in property <bool> show-week-numbers: true;
    in property <bool> show-weekday-header: true;
    in property <[string]> weekday-headers: ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
    in property <[bool]> gray-columns: [false, false, false, false, false, true, true];
    in property <[string]> iso-weeks: ["40", "41", "42", "43", "44", "45"];
    out property <[DayCellData]> cells: root.month-view.cells;
    in property <string> selected-date-line: "Friday, 30 October";
    in property <string> selected-event-summary: "2 events";
    in property <string> active-calendars-label: "2 calendars";
    in property <[AgendaEventItem]> selected-day-events: [];
    in property <string> back-to-calendar-text: "← Back to Calendar";
    in property <string> compact-summary-header: "";
    in property <string> sync-status-text: "Synced · 3 calendars active";
    // Calendar popup refresh (ADR 0011): header, shaded bands and agenda.
    in property <string> month-name-text: "November";
    in property <string> year-text: "2026";
    in property <bool> year-first: false;
    in property <bool> today-hidden: false;
    in property <string> prev-month-label: "Previous month";
    in property <string> next-month-label: "Next month";
    in property <[ShadedBand]> shaded-bands: [];
    in-out property <bool> calendar-keyboard-nav: false;
    in property <string> agenda-title: "";
    in property <string> agenda-count: "";
    in property <[AgendaChipRow]> agenda-chip-rows: [];
    in property <AgendaEventItem> agenda-expanded-chip;
    in property <bool> agenda-has-expanded-chip: false;
    in property <[AgendaEventItem]> agenda-events: [];
    in property <bool> agenda-empty: false;
    in property <string> agenda-empty-text: "No events";
    in property <string> agenda-next-text: "";
    in property <string> agenda-now-label: "Now";
    in property <string> agenda-copy-label: "Copy";
    in property <string> agenda-copied-label: "Copied";
    in property <string> agenda-open-label: "Open";
    callback toggle-agenda-event(int);
    callback copy-agenda-event(int);
    callback open-agenda-event(int);
    callback go-next-event();

    // Settings Localized Strings & State
    in property <string> settings-title-text: "Settings";
    in property <string> preferences-subtitle-text: "Preferences";
    in property <string> nav-general-text: "General";
    in property <string> nav-appearance-text: "Appearance";
    in property <string> nav-calendars-text: "Calendars";
    in property <string> nav-about-text: "About";
