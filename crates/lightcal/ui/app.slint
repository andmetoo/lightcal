    in property <[CalendarSourceItem]> calendar-sources: [];
    in property <string> update-status-text: "Checks GitHub Releases only when you ask. Never auto-installs.";
    in property <bool> update-is-available: false;

    // Redesigned Settings View State & Dropdowns
    in property <bool> highlight-current-month: true;
    in property <bool> show-event-dots: true;
    in property <bool> language-dropdown-open: false;
    in property <bool> theme-dropdown-open: false;
    in property <bool> first-day-dropdown-open: false;
    in property <bool> update-channel-dropdown-open: false;
    in property <bool> shortcut-has-conflict: false;
