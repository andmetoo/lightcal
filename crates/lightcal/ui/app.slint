    in property <string> open-privacy-settings-label: "Open Privacy Settings";
    in property <string> retry-sync-label: "Retry Sync";
    in property <bool> calendars-is-empty: false;
    in property <string> calendars-empty-title-text: "No calendar accounts connected yet";
    in property <string> calendars-empty-desc-text: "Nothing is connected yet. Add Outlook or a private ICS link, then choose which calendars to show.";
    in property <string> add-calendar-account-label: "+ Add Calendar Account";
    in property <string> active-calendars-count-label: "ACTIVE CALENDARS (3)";
    in property <string> add-calendar-label: "+ Add Calendar";
    in property <bool> update-is-checking: false;
    in property <string> checking-updates-label: "Checking updates…";
    in property <string> update-available-badge-text: "Update available";
    in property <string> update-ready-title-text: "A newer version is available";
    in property <string> update-ready-notes-text: "Open the release page to review it. You choose when to install.";
    in property <string> release-notes-button-text: "Release notes";
    in property <bool> auto-check-updates: false;
    in property <string> label-auto-updates-text: "Automatic updates";
    in property <string> desc-auto-updates-text: "Download and verify signed releases in the background";
    in property <string> label-update-channel-text: "Update channel";
    in property <string> desc-update-channel-text: "Receive verified stable releases or preview builds";
    in property <string> label-license-source-text: "License & source";
    in property <string> desc-license-source-text: "GPL-3.0-only · Built with Rust, Slint, and zero webview bloat";
    in property <string> app-version-line-text: "Lightcal · Rust + Slint";

    // Callbacks
    callback prev-month();
    callback next-month();
    callback return-to-today();
    callback select-cell(int);
    callback move-selection-by(int);
    callback open-settings(int);
    callback close-settings();
    callback select-language(string);
    callback select-theme(string);
    callback select-tray-icon-mode(string);
    callback toggle-tray-icon-monochrome();
    callback toggle-first-weekday();
    callback toggle-gray-weekday(int);
    callback toggle-show-weekday();
    callback toggle-show-week-numbers();
    callback toggle-start-with-windows();
    callback cycle-shortcut-preset();
    callback clear-shortcut();
    callback toggle-calendar-source(string);
    callback refresh-calendars();
    callback connect-microsoft();
    callback disconnect-microsoft();
    callback add-ics-source(string,string);
    callback remove-calendar-source(string);
    callback toggle-legacy-windows();
    callback install-update();
    callback toggle-auto-install-updates();
    callback check-updates();
    callback open-external-url(string);
    callback dismiss-compact();
    callback toggle-language-dropdown();
    callback toggle-theme-dropdown();
    callback toggle-first-day-dropdown();
    callback toggle-update-channel-dropdown();
    callback select-first-weekday-option(bool);
    callback select-update-channel(string);
    callback toggle-highlight-current-month();
    callback toggle-show-event-dots();
    callback toggle-auto-check-updates();
    callback reset-shortcut();
    callback open-privacy-settings();
    callback retry-calendar-sync();
    callback add-calendar-account();
    callback close-account-dialogs();
    callback choose-outlook-account();
    callback choose-google-account();
    callback choose-ics-account();
    callback cancel-account-sign-in();
    callback minimize-window();

    width: root.settings-open ? 448px : 352px;
    height: root.settings-open ? 360px : 432px;
    preferred-width: root.settings-open ? 448px : 352px;
    preferred-height: root.settings-open ? 360px : 432px;
    background: transparent;

    property <int> theme-index: root.current-theme-code == "light" ? 1
        : (root.current-theme-code == "dark" ? 2 : 0);

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.settings-open) {
                    root.close-settings();
                } else {
                    root.dismiss-compact();
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.move-selection-by(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.move-selection-by(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection-by(-7);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection-by(7);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.prev-month();
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.next-month();
                return accept;
            }
            return reject;
        }
    }

    // ==================== CALENDAR VIEW (352×432) ====================
    if !root.settings-open : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.dark-mode ? #606060 : #BBBBBB;
        background: root.dark-mode ? #111111 : #FFFFFF;
        clip: true;

        // Month title
        Text {
            x: 20px;
            y: 16px;
            width: 214px;
            height: 28px;
            text: root.month-title;
            font-size: 18px;
            font-weight: 600;
            color: root.dark-mode ? #EEEEEE : #202020;
            overflow: elide;
            vertical-alignment: center;
        }

        IconSquareButton {
            x: 244px;
            y: 16px;
            glyph: "‹";
            dark-mode: root.dark-mode;
            clicked => { root.prev-month(); }
        }
        IconSquareButton {
            x: 276px;
            y: 16px;
            glyph: "›";
            dark-mode: root.dark-mode;
            clicked => { root.next-month(); }
        }
        IconSquareButton {
            x: 308px;
            y: 16px;
            glyph: "⚙";
            filled: true;
            dark-mode: root.dark-mode;
            clicked => { root.open-settings(0); }
        }

        Text {
            x: 20px;
            y: 52px;
            width: 220px;
            height: 22px;
            text: root.today-date-line;
            font-size: 11.5px;
            font-weight: 400;
            color: root.dark-mode ? #B4B4B4 : #646464;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: 260px;
            y: 50px;
            width: 76px;
            height: 26px;
            border-radius: 8px;
            background: root.dark-mode ? #2A2A2A : #FFFFFF;
            border-width: 1px;
            border-color: root.dark-mode ? #606060 : #BBBBBB;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.today-button-label;
                font-size: 12px;
                font-weight: 500;
                color: root.dark-mode ? #EEEEEE : #202020;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.return-to-today(); }
            }
        }

        month-grid-area := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            property <length> grid-start-x: root.show-week-numbers ? 40px : 24px;
            property <length> col-width: 42px;
            property <length> band-width: 38px;
            property <length> tile-width: 34px;
            property <length> tile-height: 32px;
            property <length> row-height: 36px;
            property <length> grid-y: 112px;

            for is-gray[col-idx] in root.gray-columns : Rectangle {
                if is-gray : Rectangle {
                    x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width + 2px;
                    y: 84px;
                    width: month-grid-area.band-width;
                    height: 242px;
                    border-radius: 8px;
                    background: root.dark-mode ? #222222 : #F0F0F0;
                }
            }

            if root.show-weekday-header : Rectangle {
                y: 85px;
                height: 20px;
                width: parent.width;

                if root.show-week-numbers : Text {
                    x: 8px;
                    y: 0px;
                    width: 26px;
                    height: 20px;
                    text: root.week-header-label;
                    font-size: 9.5px;
                    font-weight: 500;
                    color: root.dark-mode ? #9B9B9B : #646464;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for wd[col-idx] in root.weekday-headers : Text {
                    x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width;
                    y: 0px;
                    width: month-grid-area.col-width;
                    height: 20px;
                    text: wd;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for row-idx in [0, 1, 2, 3, 4, 5] : Rectangle {
                y: month-grid-area.grid-y + row-idx * month-grid-area.row-height;
                height: month-grid-area.row-height;
                width: parent.width;

                if root.show-week-numbers : Text {
                    x: 8px;
                    y: 0px;
                    width: 26px;
                    height: 32px;
                    text: root.iso-weeks[row-idx];
                    font-size: 9.5px;
                    font-weight: 400;
                    color: root.dark-mode ? #9B9B9B : #646464;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                for col-idx in [0, 1, 2, 3, 4, 5, 6] : cell-box := Rectangle {
                    property <int> cell-index: row-idx * 7 + col-idx;
                    property <DayCellData> cell: root.cells[self.cell-index];
                    property <bool> today-mark: self.cell.is-today;

                    x: month-grid-area.grid-start-x + col-idx * month-grid-area.col-width + 4px;
                    y: 0px;
                    width: month-grid-area.tile-width;
                    height: month-grid-area.tile-height;
                    border-radius: 8px;
                    accessible-role: button;
                    accessible-label: self.cell.accessible-label;

                    background: self.today-mark
                        ? #D73840
                        : (self.cell.is-selected
                            ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                            : (cell-touch.has-hover && self.cell.in-month
                                ? (root.dark-mode ? #2A2A2A : #F0F0F0)
                                : transparent));
                    border-width: (self.cell.is-selected && !self.today-mark) ? 1.5px : 0px;
                    border-color: root.dark-mode ? #7B7B7B : #838383;

                    Text {
                        width: parent.width;
                        height: (cell-box.cell.dot-count > 0 && (cell-box.cell.in-month || cell-box.cell.is-today) && root.show-event-dots)
                            ? 25px
                            : parent.height;
                        y: 1px;
                        text: cell-box.cell.day-number;
                        font-size: 14px;
                        font-weight: (cell-box.cell.is-today || cell-box.cell.is-selected)
                            ? 600
                            : 500;
                        color: cell-box.cell.is-today
                            ? #FFFFFF
                            : (!cell-box.cell.in-month
                                ? (root.dark-mode ? #9B9B9B : #646464)
                                : (root.dark-mode ? #EEEEEE : #202020));
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if cell-box.cell.dot-count > 0 && (cell-box.cell.in-month || cell-box.cell.is-today) && root.show-event-dots : HorizontalLayout {
                        x: 0px;
                        width: parent.width;
                        y: 26px;
                        height: 3px;
                        spacing: 3px;
                        alignment: center;

                        if cell-box.cell.dot-count >= 1 : Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: cell-box.cell.is-today ? #FFFFFF : cell-box.cell.dot1;
                        }
                        if cell-box.cell.dot-count >= 2 : Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: cell-box.cell.is-today ? #FFFFFF : cell-box.cell.dot2;
                        }
                        if cell-box.cell.dot-count >= 3 : Rectangle {
                            width: 3px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: cell-box.cell.is-today ? #FFFFFF : cell-box.cell.dot3;
                        }
                    }

                    cell-touch := TouchArea {
                        clicked => { root.select-cell(cell-box.cell-index); }
                    }
                }
            }
        }

        Rectangle {
            x: 16px;
            y: 338px;
            width: 320px;
            height: 1px;
            background: root.dark-mode ? #3A3A3A : #D9D9D9;
        }

        Text {
            x: 20px;
            y: 347px;
            width: 246px;
            height: 22px;
            text: root.selected-date-line;
            font-size: 12px;
            font-weight: 600;
            color: root.dark-mode ? #EEEEEE : #202020;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 268px;
            y: 349px;
            width: 64px;
            height: 18px;
            text: root.selected-event-summary;
            font-size: 10.5px;
            font-weight: 400;
            color: root.dark-mode ? #B4B4B4 : #646464;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.selected-day-events.length > 0 : VerticalLayout {
            x: 20px;
            y: 376px;
            width: 312px;
            spacing: 2px;

            for ev in root.selected-day-events : HorizontalLayout {
                height: 22px;
                spacing: 9px;

                Rectangle {
                    width: 3px;
                    height: 14px;
                    border-radius: 1.5px;
                    background: ev.swatch;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: ev.time-label;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                    vertical-alignment: center;
                    min-width: 42px;
                }
                Text {
                    text: ev.title;
                    font-size: 12px;
                    font-weight: 400;
                    color: root.dark-mode ? #EEEEEE : #202020;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if root.selected-day-events.length == 0 : HorizontalLayout {
            x: 20px;
            y: 381px;
            width: 312px;
            height: 24px;
            spacing: 8px;
            alignment: space-between;

            Text {
                text: root.active-calendars-label;
                font-size: 12px;
                font-weight: 400;
                color: root.dark-mode ? #B4B4B4 : #646464;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            calendars-link := TouchArea {
                width: 88px;
                height: 18px;
                clicked => { root.open-settings(1); }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.nav-calendars-text;
                    font-size: 11px;
                    font-weight: 600;
                    color: calendars-link.has-hover ? (root.dark-mode ? #53B9AB : #00796B) : (root.dark-mode ? #B4B4B4 : #646464);
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ==================== SETTINGS VIEW (448×360) ====================
    if root.settings-open : Rectangle {
        width: 448px;
        height: 360px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.dark-mode ? #606060 : #BBBBBB;
        background: root.dark-mode ? #111111 : #FFFFFF;
        clip: true;

        // Title bar
        BrandMark {
            x: 16px;
            y: 10px;
            mark-size: 20px;
        }
        Text {
            x: 44px;
            y: 4px;
            width: 84px;
            height: 28px;
                text: root.app-name-text;
                font-size: 13px;
                font-weight: 600;
                color: root.dark-mode ? #EEEEEE : #202020;
                vertical-alignment: center;
            }
        Text {
            x: 130px;
            y: 6px;
            width: 210px;
            height: 24px;
            text: root.settings-tab == 3 ? root.nav-about-text : root.settings-title-text;
            font-size: 11px;
            font-weight: 400;
            color: root.dark-mode ? #B4B4B4 : #646464;
            vertical-alignment: center;
        }

        Rectangle {
            x: 376px;
            y: 10px;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: min-btn.has-hover ? (root.dark-mode ? #2A2A2A : #F0F0F0) : transparent;
            Text {
                width: parent.width;
                height: parent.height;
                text: "—";
                font-size: 12px;
                color: root.dark-mode ? #B4B4B4 : #646464;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            min-btn := TouchArea {
                clicked => { root.minimize-window(); }
            }
        }
        Rectangle {
            x: 412px;
            y: 10px;
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: close-btn.has-hover ? (root.dark-mode ? #392327 : #FFF1F1) : transparent;
            Text {
                width: parent.width;
                height: parent.height;
                text: "×";
                font-size: 14px;
                color: close-btn.has-hover ? #D73840 : (root.dark-mode ? #B4B4B4 : #646464);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-btn := TouchArea {
                clicked => { root.close-settings(); }
            }
        }

        // Tabs (not on About)
        if root.settings-tab != 3 : Rectangle {
            for tab-info[tab-idx] in [
                { label: root.nav-appearance-text },
                { label: root.nav-calendars-text },
                { label: root.nav-general-text }
            ] : tab-pill := Rectangle {
                x: 12px + tab-idx * 144px;
                y: 42px;
                width: 136px;
                height: 32px;
                border-radius: 7px;
                background: root.settings-tab == tab-idx
                    ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                    : (tab-touch.has-hover ? (root.dark-mode ? #222222 : #F0F0F0) : transparent);

                property <color> icon-color: root.settings-tab == tab-idx
                    ? (root.dark-mode ? #EEEEEE : #202020)
                    : (root.dark-mode ? #B4B4B4 : #646464);

                if root.settings-tab == tab-idx : Rectangle {
                    x: 56px;
                    y: 29px;
                    width: 24px;
                    height: 2px;
                    border-radius: 1px;
                    background: root.dark-mode ? #53B9AB : #00796B;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    // Calendar / person / gear marks (vector, no emoji faces).
                    if tab-idx == 0 : Rectangle {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        border-width: 1.4px;
                        border-color: tab-pill.icon-color;
                        background: transparent;
                        Rectangle {
                            x: 0px; y: 3.5px; width: parent.width; height: 1.2px;
                            background: tab-pill.icon-color;
                        }
                        Rectangle { x: 3.5px; y: 6.5px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                        Rectangle { x: 8px; y: 6.5px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                        Rectangle { x: 3.5px; y: 10px; width: 2.2px; height: 2.2px; border-radius: 0.5px; background: tab-pill.icon-color; }
                    }
                    if tab-idx == 1 : Rectangle {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        background: transparent;
                        Rectangle {
                            x: 4px; y: 1px; width: 6px; height: 6px; border-radius: 3px;
                            background: tab-pill.icon-color;
                        }
                        Rectangle {
                            x: 2px; y: 8px; width: 10px; height: 5.5px; border-radius: 5px;
                            background: tab-pill.icon-color;
                        }
                    }
                    if tab-idx == 2 : Text {
                        text: "⚙";
                        font-size: 13px;
                        color: tab-pill.icon-color;
                        vertical-alignment: center;
                    }
                    Text {
                        text: tab-info.label;
                        font-size: 12px;
                        font-weight: root.settings-tab == tab-idx ? 600 : 400;
                        color: root.settings-tab == tab-idx
                            ? (root.dark-mode ? #EEEEEE : #202020)
                            : (root.dark-mode ? #B4B4B4 : #646464);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                tab-touch := TouchArea {
                    clicked => { root.open-settings(tab-idx); }
                }
            }

            Rectangle {
                x: 16px;
                y: 83px;
                width: 416px;
                height: 1px;
                background: root.dark-mode ? #3A3A3A : #D9D9D9;
            }
        }

        // ===== TAB 0: Calendar =====
        if root.settings-tab == 0 : Rectangle {
            x: 16px;
            y: 96px;
            width: 416px;
            height: 200px;
            border-radius: 9px;
            background: root.dark-mode ? #222222 : #F0F0F0;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                SettingsRow {
                    title: root.label-theme-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    SegmentedControl {
                        track-width: 204px;
                        options: [root.theme-system-label, root.theme-light-label, root.theme-dark-label];
                        selected-index: root.theme-index;
                        dark-mode: root.dark-mode;
                        selected(idx) => {
                            if (idx == 0) { root.select-theme("system"); }
                            if (idx == 1) { root.select-theme("light"); }
                            if (idx == 2) { root.select-theme("dark"); }
                        }
                    }
                }

                SettingsRow {
                    title: root.label-first-weekday-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    SettingsSelect {
                        text: root.current-first-weekday-display;
                        is-open: root.first-day-dropdown-open;
                        select-width: 136px;
                        dark-mode: root.dark-mode;
                        clicked => { root.toggle-first-day-dropdown(); }
                    }
                }

                SettingsRow {
                    title: root.label-gray-weekdays-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    HorizontalLayout {
                        spacing: 3px;
                        for chip in root.gray-weekday-chips : Rectangle {
                            width: 26px;
                            height: 28px;
                            border-radius: 6px;
                            background: chip.active
                                ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                                : (root.dark-mode ? #2A2A2A : #FFFFFF);
                            border-width: 1px;
                            border-color: chip.active
                                ? (root.dark-mode ? #7B7B7B : #838383)
                                : (root.dark-mode ? #606060 : #BBBBBB);

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: chip.label;
                                font-size: 10.5px;
                                font-weight: chip.active ? 600 : 400;
                                color: chip.active
                                    ? (root.dark-mode ? #EEEEEE : #202020)
                                    : (root.dark-mode ? #B4B4B4 : #646464);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.toggle-gray-weekday(chip.index); }
                            }
                        }
                    }
                }

                SettingsRow {
                    title: root.label-show-week-numbers-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    SwitchToggle {
                        checked: root.show-week-numbers;
                        dark-mode: root.dark-mode;
                        toggled => { root.toggle-show-week-numbers(); }
                    }
                }

                SettingsRow {
                    title: root.label-show-event-dots-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    show-divider: false;
                    SwitchToggle {
                        checked: root.show-event-dots;
                        dark-mode: root.dark-mode;
                        toggled => { root.toggle-show-event-dots(); }
                    }
                }
            }

            if root.first-day-dropdown-open : Rectangle {
                x: 268px;
                y: 46px;
                SettingsMenu {
                    dark-mode: root.dark-mode;
                    width: 136px;
                    SettingsDropdownOption {
                        label: root.weekday-monday-label;
                        active: root.first-weekday-monday;
                        dark-mode: root.dark-mode;
                        clicked => { root.select-first-weekday-option(true); }
                    }
                    SettingsDropdownOption {
                        label: root.weekday-sunday-label;
                        active: !root.first-weekday-monday;
                        dark-mode: root.dark-mode;
                        clicked => { root.select-first-weekday-option(false); }
                    }
                }
            }
        }

        // ===== TAB 1: Accounts =====
        if root.settings-tab == 1 : Rectangle {
            width: parent.width;
            height: parent.height;

            Text {
                x: 16px;
                y: 92px;
                width: 264px;
                height: 28px;
                text: root.provider-heading-text;
                font-size: 12px;
                font-weight: 600;
                color: root.dark-mode ? #EEEEEE : #202020;
                vertical-alignment: center;
                overflow: elide;
            }
            SettingsButton {
                x: 300px;
                y: 92px;
                button-width: 132px;
                label: root.add-calendar-account-label;
                dark-mode: root.dark-mode;
                enabled: root.can-connect-microsoft || !root.account-connected;
                clicked => { root.add-calendar-account(); }
            }

            Rectangle {
                x: 16px;
                y: 132px;
                width: 416px;
                height: 168px;
                border-radius: 9px;
                background: root.dark-mode ? #222222 : #F0F0F0;
                clip: true;

                if root.connection-busy : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.outlook-section-text;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.dark-mode ? #EEEEEE : #202020;
                    }
                    Text {
                        text: root.waiting-browser-text;
                        font-size: 11px;
                        color: root.dark-mode ? #B4B4B4 : #646464;
                        wrap: word-wrap;
                    }
                    SettingsButton {
                        label: root.cancel-sign-in-label;
                        dark-mode: root.dark-mode;
                        clicked => { root.cancel-account-sign-in(); }
                    }
                }
                if root.sign-in-cancelled && !root.connection-busy : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.sign-in-cancelled-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: root.dark-mode ? #EEEEEE : #202020;
                        wrap: word-wrap;
                    }
                    SettingsButton {
                        label: root.try-again-label;
                        kind: "primary";
                        dark-mode: root.dark-mode;
                        clicked => { root.connect-microsoft(); }
                    }
                }
                if root.calendars-is-empty && !root.calendars-access-denied && !root.account-connected && !root.account-needs-signin && !root.connection-busy && !root.sign-in-cancelled : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.calendars-empty-title-text;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.dark-mode ? #EEEEEE : #202020;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.calendars-empty-desc-text;
                        font-size: 11px;
                        font-weight: 400;
                        color: root.dark-mode ? #B4B4B4 : #646464;
                        wrap: word-wrap;
                    }
                    if root.connection-message != "" : Text {
                        text: root.connection-message;
                        font-size: 11px;
                        color: root.dark-mode ? #FF9DA1 : #BC333B;
                        wrap: word-wrap;
                    }
                }

                if root.calendars-access-denied : VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.calendars-denied-title-text;
                        font-size: 12px;
                        font-weight: 600;
                        color: root.dark-mode ? #FF9DA1 : #BC333B;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.calendars-denied-desc-text;
                        font-size: 11px;
                        color: root.dark-mode ? #B4B4B4 : #646464;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SettingsButton {
                            label: root.open-privacy-settings-label;
                            dark-mode: root.dark-mode;
                            clicked => { root.open-privacy-settings(); }
                        }
                        SettingsButton {
                            label: root.retry-sync-label;
                            kind: "subtle";
                            dark-mode: root.dark-mode;
                            clicked => { root.retry-calendar-sync(); }
                        }
                    }
                }

                if (root.account-connected || root.account-needs-signin || !root.calendars-is-empty) && !root.calendars-access-denied && !root.connection-busy && !root.sign-in-cancelled : VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.outlook-section-text;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: root.dark-mode ? #EEEEEE : #202020;
                                overflow: elide;
                            }
                            Text {
                                text: root.account-status-text;
                                font-size: 10.5px;
                                font-weight: 400;
                                color: root.dark-mode ? #B4B4B4 : #646464;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            height: 22px;
                            border-radius: 6px;
                            background: root.account-needs-signin ? #BC333B : (root.dark-mode ? #313131 : #E8E8E8);
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: root.account-needs-signin ? root.reconnect-label : root.provider-readonly-tag-text;
                                    font-size: 10.5px;
                                    font-weight: 500;
                                    color: root.account-needs-signin ? #FFFFFF : (root.dark-mode ? #EEEEEE : #202020);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: root.dark-mode ? #3A3A3A : #D9D9D9; }

                    if root.calendar-sources.length == 0 : Text {
                        text: root.no-calendars-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: root.dark-mode ? #EEEEEE : #202020;
                        wrap: word-wrap;
                    }
                    if root.calendar-sources.length > 0 : ScrollView {
                        height: 72px;
                        VerticalLayout {
                            spacing: 2px;
                            for src in root.calendar-sources : HorizontalLayout {
                                height: 22px;
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 4px;
                                    y: (parent.height - self.height) / 2;
                                    background: src.checked ? src.swatch : (root.dark-mode ? #2A2A2A : #FFFFFF);
                                    border-width: src.checked ? 0px : 1px;
                                    border-color: root.dark-mode ? #606060 : #BBBBBB;

                                    if src.checked : Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "✓";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        enabled: !root.connection-busy && !root.provider-loading;
                                        clicked => { root.toggle-calendar-source(src.id); }
                                    }
                                }
                                Text {
                                    text: src.name;
                                    font-size: 12px;
                                    font-weight: 400;
                                    color: root.dark-mode ? #EEEEEE : #202020;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if src.removable : TouchArea {
                                    width: 48px;
                                    height: 18px;
                                    clicked => { root.remove-calendar-source(src.id); }
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.remove-source-label;
                                        font-size: 10px;
                                        color: root.dark-mode ? #B4B4B4 : #646464;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        alignment: space-between;

                        if root.legacy-windows-enabled : HorizontalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            alignment: start;
                            Text {
                                text: root.legacy-windows-label;
                                font-size: 10.5px;
                                font-weight: 400;
                                color: root.dark-mode ? #B4B4B4 : #646464;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            SwitchToggle {
                                checked: root.legacy-windows-enabled;
                                dark-mode: root.dark-mode;
                                toggled => { root.toggle-legacy-windows(); }
                            }
                        }
                        if !root.legacy-windows-enabled : Text {
                            text: root.account-needs-signin ? root.events-stale-text : root.sync-status-text;
                            font-size: 10.5px;
                            font-weight: 400;
                            color: root.account-needs-signin
                                ? (root.dark-mode ? #FF9DA1 : #BC333B)
                                : (root.dark-mode ? #B4B4B4 : #646464);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.can-refresh-calendars : SettingsButton {
                            label: root.refresh-button-text;
                            kind: "subtle";
                            dark-mode: root.dark-mode;
                            clicked => { root.refresh-calendars(); }
                        }
                        if root.account-needs-signin : SettingsButton {
                            label: root.reconnect-label;
                            kind: "primary";
                            button-width: 112px;
                            dark-mode: root.dark-mode;
                            clicked => { root.connect-microsoft(); }
                        }
                        if root.can-disconnect-microsoft && !root.account-needs-signin : SettingsButton {
                            label: root.disconnect-microsoft-label;
                            dark-mode: root.dark-mode;
                            clicked => { root.disconnect-microsoft(); }
                        }
                    }
                }
            }

            // Empty / denied: still allow turning legacy Windows calendars off.
            if (root.calendars-is-empty || root.calendars-access-denied) && root.legacy-windows-enabled : Rectangle {
                x: 28px;
                y: 268px;
                width: 392px;
                height: 28px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: root.legacy-windows-label;
                        font-size: 10.5px;
                        color: root.dark-mode ? #B4B4B4 : #646464;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    SwitchToggle {
                        checked: true;
                        dark-mode: root.dark-mode;
                        toggled => { root.toggle-legacy-windows(); }
                    }
                }
            }
        }

        // ===== TAB 2: App =====
        if root.settings-tab == 2 : Rectangle {
            x: 16px;
            y: 96px;
            width: 416px;
            height: 200px;
            border-radius: 9px;
            background: root.dark-mode ? #222222 : #F0F0F0;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                SettingsRow {
                    title: root.label-language-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    SettingsSelect {
                        text: root.current-language-display;
                        is-open: root.language-dropdown-open;
                        select-width: 168px;
                        dark-mode: root.dark-mode;
                        clicked => { root.toggle-language-dropdown(); }
                    }
                }

                SettingsRow {
                    title: root.startup-status-text == "" ? root.label-startup-text : root.startup-status-text;
                    dark-mode: root.dark-mode;
                    title-color: root.startup-status-text == ""
                        ? (root.dark-mode ? #EEEEEE : #202020)
                        : (root.dark-mode ? #FF9DA1 : #BC333B);
                    SwitchToggle {
                        checked: root.start-with-windows;
                        dark-mode: root.dark-mode;
                        toggled => { root.toggle-start-with-windows(); }
                    }
                }

                SettingsRow {
                    title: root.label-shortcut-text;
                    subtitle: root.shortcut-has-conflict ? root.shortcut-conflict-line : "";
                    subtitle-color: root.dark-mode ? #FF9DA1 : #BC333B;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;
                    Text {
                        text: root.global-shortcut-display == ""
                            ? root.shortcut-unset-text
                            : root.global-shortcut-display;
                        font-size: 11px;
                        font-weight: 500;
                        color: root.dark-mode ? #EEEEEE : #202020;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    SettingsButton {
                        label: root.global-shortcut-display == "" || root.global-shortcut-display == root.shortcut-unset-text
                            ? root.shortcut-record-label
                            : root.shortcut-change-label;
                        button-width: 84px;
                        dark-mode: root.dark-mode;
                        clicked => { root.cycle-shortcut-preset(); }
                    }
                }

                SettingsRow {
                    title: root.label-tray-palette-text;
                    dark-mode: root.dark-mode;
                    title-color: root.dark-mode ? #EEEEEE : #202020;

                    Rectangle {
                        width: 152px;
                        height: 28px;
                        border-radius: 7px;
                        background: root.dark-mode ? #191919 : #E8E8E8;

                        HorizontalLayout {
                            padding: 2px;
                            spacing: 0px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 24px;
                                border-radius: 5px;
                                background: !root.tray-icon-monochrome
                                    ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                                    : transparent;
                                border-width: !root.tray-icon-monochrome ? 1px : 0px;
                                border-color: root.dark-mode ? #7B7B7B : #838383;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: root.colored-icon-preview;
                                        image-fit: contain;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.palette-colored-text;
                                        font-size: 10.5px;
                                        font-weight: !root.tray-icon-monochrome ? 600 : 400;
                                        color: root.dark-mode ? #EEEEEE : #202020;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        if (root.tray-icon-monochrome) {
                                            root.toggle-tray-icon-monochrome();
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 24px;
                                border-radius: 5px;
                                background: root.tray-icon-monochrome
                                    ? (root.dark-mode ? #3A3A3A : #E0E0E0)
                                    : transparent;
                                border-width: root.tray-icon-monochrome ? 1px : 0px;
                                border-color: root.dark-mode ? #7B7B7B : #838383;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: root.monochrome-icon-preview;
                                        image-fit: contain;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.palette-monochrome-text;
                                        font-size: 10.5px;
                                        font-weight: root.tray-icon-monochrome ? 600 : 400;
                                        color: root.dark-mode ? #EEEEEE : #202020;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        if (!root.tray-icon-monochrome) {
                                            root.toggle-tray-icon-monochrome();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        Text {
                            text: root.updates-heading-text;
                            font-size: 12px;
                            font-weight: 500;
                            color: root.dark-mode ? #EEEEEE : #202020;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "›";
                            font-size: 16px;
                            color: root.dark-mode ? #B4B4B4 : #646464;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.open-settings(3); }
                    }
                }
            }

            if root.language-dropdown-open : Rectangle {
                x: 236px;
                y: 46px;
                SettingsMenu {
                    dark-mode: root.dark-mode;
                    width: 168px;
                    SettingsDropdownOption {
                        label: root.lang-en-us-label;
                        active: root.current-language-code == "en";
                        dark-mode: root.dark-mode;
                        clicked => { root.select-language("en"); }
                    }
                    SettingsDropdownOption {
                        label: root.lang-ru-label;
                        active: root.current-language-code == "ru";
                        dark-mode: root.dark-mode;
                        clicked => { root.select-language("ru"); }
                    }
                    SettingsDropdownOption {
                        label: root.lang-es-label;
                        active: root.current-language-code == "es";
                        dark-mode: root.dark-mode;
                        clicked => { root.select-language("es"); }
                    }
                    SettingsDropdownOption {
                        label: root.lang-ja-label;
                        active: root.current-language-code == "ja";
                        dark-mode: root.dark-mode;
                        clicked => { root.select-language("ja"); }
                    }
                }
            }
        }

        // ===== TAB 3: About =====
        if root.settings-tab == 3 : Rectangle {
            width: parent.width;
            height: parent.height;

            BrandMark {
                x: 24px;
                y: 56px;
                mark-size: 48px;
            }
            Text {
                x: 92px;
                y: 55px;
                width: 332px;
                height: 30px;
                text: root.app-name-text;
                font-size: 22px;
                font-weight: 600;
                color: root.dark-mode ? #EEEEEE : #202020;
                vertical-alignment: center;
            }
            Text {
                x: 92px;
                y: 90px;
                width: 332px;
                height: 20px;
                text: root.about-version-text;
                font-size: 11px;
                font-weight: 400;
                color: root.dark-mode ? #B4B4B4 : #646464;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 16px;
                y: 132px;
                width: 416px;
                height: 64px;
                border-radius: 9px;
                background: root.dark-mode ? #222222 : #F0F0F0;

                Text {
                    x: 12px;
                    y: 8px;
                    width: 264px;
                    height: 24px;
                    text: root.update-is-checking
                        ? root.checking-updates-label
                        : (root.update-is-available
                            ? root.update-ready-title-text
                            : root.update-status-text);
                    font-size: 12px;
                    font-weight: 500;
                    color: root.dark-mode ? #EEEEEE : #202020;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    x: 12px;
                    y: 34px;
                    width: 264px;
                    height: 18px;
                    text: root.update-is-checking
                        ? ""
                        : (root.update-is-available
                            ? root.update-ready-notes-text
                            : root.install-status-text);
                    font-size: 10.5px;
                    font-weight: 400;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.update-is-available : SettingsButton {
                    x: 300px;
                    y: 18px;
                    button-width: 104px;
                    label: root.release-notes-button-text;
                    dark-mode: root.dark-mode;
                    clicked => { root.open-external-url("https://github.com/andmetoo/lightcal/releases"); }
                }
                if !root.update-is-available && !root.update-is-checking : SettingsButton {
                    x: 300px;
                    y: 18px;
                    button-width: 104px;
                    label: root.updates-check-button-text;
                    dark-mode: root.dark-mode;
                    clicked => { root.check-updates(); }
                }
            }

            // Link rows
            for link[link-idx] in [
                { title: root.github-button-text, url: "https://github.com/andmetoo/lightcal" },
                { title: root.koona-button-text, url: "https://koona.app" },
                { title: root.license-short-text, url: "https://github.com/andmetoo/lightcal/blob/main/LICENSE" }
            ] : Rectangle {
                x: 16px;
                y: 208px + link-idx * 36px;
                width: 416px;
                height: 30px;

                Text {
                    x: 12px;
                    width: 192px;
                    height: parent.height;
                    text: link.title;
                    font-size: 12px;
                    font-weight: 500;
                    color: root.dark-mode ? #EEEEEE : #202020;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: 380px;
                    width: 24px;
                    height: parent.height;
                    text: "↗";
                    font-size: 12px;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.open-external-url(link.url); }
                }
            }
        }

        if root.add-account-open : Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.dark-mode ? #00000066 : #00000033;
            Rectangle {
                x: 44px;
                y: 80px;
                width: 360px;
                height: 236px;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.dark-mode ? #606060 : #BBBBBB;
                background: root.dark-mode ? #111111 : #FFFFFF;
                Text {
                    x: 16px;
                    y: 14px;
                    width: 292px;
                    height: 28px;
                    text: root.add-account-title;
                    font-size: 18px;
                    font-weight: 600;
                    color: root.dark-mode ? #EEEEEE : #202020;
                    vertical-alignment: center;
                }
                Text {
                    x: 16px;
                    y: 46px;
                    width: 328px;
                    height: 20px;
                    text: root.add-account-intro;
                    font-size: 11px;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                }
                Text {
                    x: 320px;
                    y: 12px;
                    width: 28px;
                    height: 28px;
                    text: "×";
                    font-size: 18px;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    x: 320px;
                    y: 12px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.close-account-dialogs(); }
                }
                for choice[i] in [
                    { title: root.google-account-label, desc: root.google-account-desc },
                    { title: root.outlook-section-text, desc: root.outlook-account-desc },
                    { title: root.ics-account-label, desc: root.ics-account-desc }
                ] : Rectangle {
                    x: 16px;
                    y: 74px + i * 48px;
                    width: 328px;
                    height: 40px;
                    border-radius: 7px;
                    background: root.dark-mode ? #222222 : #F0F0F0;
                    Text {
                        x: 12px;
                        y: 4px;
                        width: 280px;
                        height: 18px;
                        text: choice.title;
                        font-size: 12px;
                        font-weight: 500;
                        color: root.dark-mode ? #EEEEEE : #202020;
                    }
                    Text {
                        x: 12px;
                        y: 20px;
                        width: 280px;
                        height: 16px;
                        text: choice.desc;
                        font-size: 10.5px;
                        color: root.dark-mode ? #B4B4B4 : #646464;
                    }
                    TouchArea {
                        clicked => {
                            if (i == 0) { root.choose-google-account(); }
                            if (i == 1) { root.choose-outlook-account(); }
                            if (i == 2) { root.choose-ics-account(); }
                        }
                    }
                }
            }
        }

        if root.ics-dialog-open : Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.dark-mode ? #00000066 : #00000033;
            Rectangle {
                x: 24px;
                y: 72px;
                width: 400px;
                height: 220px;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.dark-mode ? #606060 : #BBBBBB;
                background: root.dark-mode ? #111111 : #FFFFFF;
                Text {
                    x: 16px;
                    y: 12px;
                    width: 320px;
                    height: 28px;
                    text: root.ics-dialog-title;
                    font-size: 18px;
                    font-weight: 600;
                    color: root.dark-mode ? #EEEEEE : #202020;
                }
                Text {
                    x: 360px;
                    y: 12px;
                    width: 28px;
                    height: 28px;
                    text: "×";
                    font-size: 18px;
                    horizontal-alignment: center;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                }
                TouchArea {
                    x: 360px;
                    y: 12px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.close-account-dialogs(); }
                }
                Text {
                    x: 16px;
                    y: 48px;
                    width: 368px;
                    height: 32px;
                    text: root.ics-privacy-text;
                    font-size: 11px;
                    wrap: word-wrap;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                }
                SettingsField {
                    x: 16px;
                    y: 84px;
                    width: 368px;
                    text <=> root.ics-source-name;
                    placeholder: root.ics-name-placeholder;
                    dark-mode: root.dark-mode;
                }
                SettingsField {
                    x: 16px;
                    y: 120px;
                    width: 368px;
                    text <=> root.ics-source-url;
                    placeholder: root.ics-url-placeholder;
                    dark-mode: root.dark-mode;
                }
                Text {
                    x: 16px;
                    y: 152px;
                    width: 200px;
                    height: 18px;
                    text: root.ics-stays-local-text;
                    font-size: 10.5px;
                    color: root.dark-mode ? #B4B4B4 : #646464;
                }
                SettingsButton {
                    x: 196px;
                    y: 176px;
                    button-width: 88px;
                    label: root.cancel-sign-in-label;
                    dark-mode: root.dark-mode;
                    clicked => { root.close-account-dialogs(); }
                }
                SettingsButton {
                    x: 292px;
                    y: 176px;
                    button-width: 92px;
                    label: root.subscribe-label;
                    kind: "primary";
                    enabled: root.ics-source-name != "" && root.ics-source-url != "";
                    dark-mode: root.dark-mode;
                    clicked => { root.add-ics-source(root.ics-source-name, root.ics-source-url); }
                }
            }
        }

        // Footer
        Rectangle {
            x: 16px;
            y: 320px;
            width: 416px;
            height: 1px;
            background: root.dark-mode ? #3A3A3A : #D9D9D9;
        }

        if root.settings-tab != 3 : Rectangle {
            Text {
                x: 16px;
                y: 328px;
                width: 240px;
                height: 24px;
                text: root.about-link-text;
                font-size: 11px;
                font-weight: 500;
                color: about-touch.has-hover
                    ? (root.dark-mode ? #EEEEEE : #202020)
                    : (root.dark-mode ? #B4B4B4 : #646464);
                vertical-alignment: center;
            }
            about-touch := TouchArea {
                x: 16px;
                y: 328px;
                width: 240px;
                height: 24px;
                clicked => { root.open-settings(3); }
            }
            Text {
                x: 280px;
                y: 328px;
                width: 152px;
                height: 24px;
                text: root.app-version-line-text;
                font-size: 10.5px;
                font-weight: 400;
                color: root.dark-mode ? #B4B4B4 : #646464;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.settings-tab == 3 : Rectangle {
            Text {
                x: 16px;
                y: 328px;
                width: 416px;
                height: 24px;
                text: root.back-to-calendar-text;
                font-size: 11px;
                font-weight: 500;
                color: back-touch.has-hover
                    ? (root.dark-mode ? #EEEEEE : #202020)
                    : (root.dark-mode ? #B4B4B4 : #646464);
                vertical-alignment: center;
            }
            back-touch := TouchArea {
                x: 16px;
                y: 328px;
                width: 416px;
                height: 24px;
                clicked => { root.open-settings(2); } // App tab (Penpot Back to settings)
            }
        }
    }
}
