# Copy to .env (ignored by Git). No tokens or ICS URLs here.
# Microsoft needs no client secret. The Google value below is the Desktop client
# secret from Cloud Console: Google requires it on the token exchange. Do not commit it.
# Public Application (client) ID from a Microsoft Entra Desktop app registration.
# Redirect: http://localhost/lightcalendar/oauth/microsoft
LIGHTCAL_MICROSOFT_CLIENT_ID=

# Public client ID from a Google Cloud OAuth client (application type Desktop).
# Looks like 1234567890-abcdef.apps.googleusercontent.com. No refresh token.
LIGHTCAL_GOOGLE_CLIENT_ID=

# Client secret of that same Desktop client. Google still requires it when
# exchanging the authorization code, including with PKCE. Builds embed it, as Google
# expects for Desktop clients; CI reads it from the repository secret. Leave this empty in git.
LIGHTCAL_GOOGLE_CLIENT_SECRET=

# Public SHA-256 fingerprint of the Certum code-signing certificate.
# Required at build time for automatic installation; leave empty to disable it.
# Accepts a comma-separated list (AA..,BB..) so the next certificate can ship one release
# before the old one expires. Any malformed entry disables automatic installation.
LIGHTCAL_UPDATE_CERT_SHA256=

# SHA-1 thumbprint of that same certificate. Not a secret. `just sign-draft` passes it to signtool.
# SimplySign Desktop must be signed in first. Thumbprint:
# Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Format-List Subject, Thumbprint
# SIGN_CERT_SHA1=

# Optional: signtool.exe path when it is not on PATH or in the Windows SDK.
# SIGNTOOL=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe

# Optional: installed NSIS compiler; otherwise a checksum-verified portable copy is used.
# LIGHTCAL_NSIS_COMPILER=C:\Program Files (x86)\NSIS\makensis.exe

